<?xml version="1.0" encoding="utf-8"?>
<!--
  Mapare pe surse (convenția din SmartTable/FAS): Atlas.DXF.* vine exclusiv din
  feed-ul Atlas. Sursele "DevExpress Online" și "nuget.org" NU se redeclară aici —
  cheile vin din config-ul global al mașinii (evităm cheia DevExpress în repo).
-->
<configuration>
  <packageSources>
    <add key="Atlas" value="https://repo2.dragulin.net/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Atlas">
      <package pattern="Atlas.DXF.*" />
    </packageSource>
    <packageSource key="DevExpress 26.1 Local">
      <package pattern="DevExpress.*" />
    </packageSource>
    <packageSource key="DevExpress Online">
      <package pattern="DevExpress.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
