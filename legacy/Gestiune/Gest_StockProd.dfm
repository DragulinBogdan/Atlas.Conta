  object DTInfluenta: TDataSource
    DataSet = qryInfluenta
    Left = 504
    Top = 8
  end
  object qryInfluenta: TZQuery
    Connection = frmData.dbContabilitate
    SQL.Strings = (
      'SELECT '
      '  A.* , B.COD_DOCUM AS DENUMIRE, B.DESC_DOCUM AS DESCRIERE'
      'FROM GEST_DEFA_STOC_TIP_PRODUSE A'
      
        'LEFT JOIN GEST_TIP_DOCUM B ON (A.ID_GEST_TIP_DOCUM = B.ID_GEST_T' +
        'IP_DOCUM)'
      'WHERE '
      'A.ID_GEST_TIP_DOCUM = :ID_GEST_TIP_DOCUM'
      'AND (A.PREDATOR = :PREDATOR OR ISNULL(:PREDATOR2, -1) = -1)')
    Params = <
      item
        DataType = ftInteger
        Precision = 10
        Name = 'ID_GEST_TIP_DOCUM'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftInteger
        Precision = 10
        Name = 'PREDATOR'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftInteger
        Precision = 10
        Name = 'PREDATOR2'
        ParamType = ptUnknown
        Size = 4
      end>
    Left = 536
    Top = 8
    ParamData = <
      item
        DataType = ftInteger
        Precision = 10
        Name = 'ID_GEST_TIP_DOCUM'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftInteger
        Precision = 10
        Name = 'PREDATOR'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftInteger
        Precision = 10
        Name = 'PREDATOR2'
        ParamType = ptUnknown
        Size = 4
      end>
