    Connection = frmData.dbContabilitate
    SQL.Strings = (
      
        'select cod_functional, denumire from bg_plan_functional as a whe' +
        're not exists (select top 1 1 from bg_plan_functional where id_p' +
        'arinte = a.id_bg_plan_functional) order by cod_functional')
