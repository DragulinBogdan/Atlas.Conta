  object QryFisaCont: TZQuery
    Connection = frmData.dbContabilitate
    SQL.Strings = (
      
        'exec SP_GET_FISA_CONT @CONT = :CONT, @DATA_START = :DATA_START, ' +
        '@DATA_END = :DATA_END, @CODREP = :CODREP, @MATERIAL = :MATERIAL,' +
        ' @IS_ON_REPARTITOR = :IS_ON_REPARTITOR, @IS_ON_LUCRARE = :IS_ON_' +
        'LUCRARE, @CU_INCHIDERE = :CU_INCHIDERE, @ID_UNITATE = :ID_UNITAT' +
        'E, @COD_FUNCTIONAL = :COD_FUNCTIONAL, @COD_ECONOMIC = :COD_ECONO' +
        'MIC')
    Params = <
      item
        DataType = ftString
        Precision = 255
        NumericScale = 255
        Name = 'CONT'
        ParamType = ptUnknown
        Size = 30
      end
      item
        DataType = ftDateTime
        Precision = 23
        NumericScale = 3
        Name = 'DATA_START'
        ParamType = ptUnknown
        Size = 16
      end
      item
        DataType = ftDateTime
        Precision = 23
        NumericScale = 3
        Name = 'DATA_END'
        ParamType = ptUnknown
        Size = 16
      end
      item
        DataType = ftInteger
        Precision = 10
        Name = 'CODREP'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftUnknown
        Name = 'MATERIAL'
        ParamType = ptUnknown
        Size = -1
      end
      item
        DataType = ftInteger
        Precision = 10
        Name = 'IS_ON_REPARTITOR'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftInteger
        Precision = 10
        Name = 'IS_ON_LUCRARE'
        ParamType = ptUnknown
        Size = 4
      end
      item
        DataType = ftInteger
        Precision = 255
        NumericScale = 255
        Name = 'CU_INCHIDERE'
        ParamType = ptUnknown
        Size = 2
      end
      item
        DataType = ftUnknown
        Name = 'ID_UNITATE'
        ParamType = ptUnknown
        Size = -1
      end
      item
        DataType = ftUnknown
        Name = 'COD_FUNCTIONAL'
        ParamType = ptUnknown
        Size = -1
      end
      item
        DataType = ftString
        Precision = 255
        NumericScale = 255
        Name = 'COD_ECONOMIC'
        ParamType = ptUnknown
        Size = 50
      end>
    Left = 96
    Top = 152
