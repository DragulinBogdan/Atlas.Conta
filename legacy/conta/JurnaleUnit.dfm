  object qryUserJurnale: TZQuery
    Tag = 1
    Connection = frmData.dbContabilitate
    CachedUpdates = True
    SQL.Strings = (
      'select '
      #9'a.ID_UTILIZATORI, '
      
        #9'cast(case when b.ID_JURNAL_UTILIZATORI is null then 0 else 1 en' +
        'd as bit) as sel,'
      #9'a.NUMEINTREG,'
      '                cast(null as int) as parinte'
      'from UTILIZATORI a '
      
        #9'left join JURNAL_UTILIZATORI b on a.ID_UTILIZATORI = b.ID_UTILI' +
        'ZATORI and b.JURNAL = :JURNAL'
      'order by a.NUMEINTREG'
      '')
    Params = <
      item
        DataType = ftString
        Name = 'JURNAL'
        ParamType = ptInput
      end>
    Left = 100
    Top = 120
    ParamData = <
