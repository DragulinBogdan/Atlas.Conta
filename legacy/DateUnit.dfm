  object QryCasaSalariati: TZQuery
    Tag = 1
    Connection = dbContabilitate
    SQL.Strings = (
      'SELECT A.*, '
      'CASE WHEN '
      
        '     EXISTS(SELECT TOP 1 1 FROM REPARTITORI_ORGANIGRAMA AS B WHE' +
        'RE A.ID_REPARTITORI = B.ID_REPARTITORI AND B.ID_ORGANIGRAMA = :I' +
