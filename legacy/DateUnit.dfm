      'SHAPE_FONT_NAME, '
      '   ARE_CONT, ARE_CONTABILITATE, ID_BUGET_TIP_ORDONATOR)')
    ModifySQL.Strings = (
      'UPDATE OI_UNITATI SET'
      '  Denumire = :Denumire,'
      '  id_parinte = :id_parinte,'
