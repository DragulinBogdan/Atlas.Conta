    DeleteSQL.Strings = (
      'DELETE FROM OI_UNITATI'
      'WHERE'
      
        '  ((OI_UNITATI.id_oi_unitati IS NULL AND :OLD_id_oi_unitati IS N' +
        'ULL) '
      'OR (OI_UNITATI.id_oi_unitati = :OLD_id_oi_unitati))')
    InsertSQL.Strings = (
      'INSERT INTO OI_UNITATI'
      '  (Denumire, id_parinte, cod_functional, Este_Interna, '
      'ID_OI_UNITATI_DETALII, '
      '   ID_REPARTITORI, ID_OI_UNITATI_TIPURI, DESCRIERE, '
      'UNITATEA_URMARITA, '
      '   NUME_ORDONANTATOR, ID_UTILIZATORI, STARE, '
      'UNITATEA_CENTRALIZATOARE, '
      '   BANCA, BANCA_COD, BANCA_CONT, SHAPE_TYPE, '
      'SHAPE_COLOR, SHAPE_LEFT_TOP, '
      '   SHAPE_RIGHT_BOTTOM, SHAPE_POS_ID, SHAPE_FONT_COLOR, '
      'SHAPE_FONT_NAME, '
      '   ARE_CONT, ARE_CONTABILITATE, ID_BUGET_TIP_ORDONATOR)'
      'VALUES'
      '  (Denumire, id_parinte, cod_functional, Este_Interna, '
      'ID_OI_UNITATI_DETALII, '
      '   ID_REPARTITORI, ID_OI_UNITATI_TIPURI, DESCRIERE, '
      'UNITATEA_URMARITA, '
      '   NUME_ORDONANTATOR, ID_UTILIZATORI, STARE, '
      'UNITATEA_CENTRALIZATOARE, '
      '   BANCA, BANCA_COD, BANCA_CONT, SHAPE_TYPE, '
      'SHAPE_COLOR, SHAPE_LEFT_TOP, '
