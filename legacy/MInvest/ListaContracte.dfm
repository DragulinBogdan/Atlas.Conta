  object qryContracteFilesUSR: TZQuery
    CachedUpdates = True
    SQL.Strings = (
      'select'
      ' *'
      ' from ContracteFiles'
      ' where idContracte = :idContracte')
    Params = <
      item
        DataType = ftInteger
        Precision = 10
        Name = 'idContracte'
