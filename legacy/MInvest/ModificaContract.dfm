  object qryAchizitii: TZQuery
    SQL.Strings = (
      'select'
      '  A.idAchizitii,'
      '  A.Denumire,'
      '  A.Descriere,'
      '  A.NrAprobare,'
      '  A.DataAprobare,'
      
        '  isnull(cast(year(A.DataProcedura) as char), '#39#39') as PlanAchizit' +
        'ii,'
      '  C.Categorie + '#39', '#39' + C.Subcategorie as TipContract,'
      '  B.Denumire as TipAchizitie,'
      '  D.Denumire as StareAchizitie,'
      '  F.Denumire as EtapaUrmatoare,'
      '  F.DataEstimata as EtapaUrmatoareData,'
      '  E.CodCPV + '#39' '#39' + E.Denumire as CodCPV,'
      '  A.SumaEstimata,'
      '  A.DataProcedura,'
      '  A.AnuntParticipareNr,'
      '  A.AnuntParticipareData'
      '  from Achizitii A'
      '  left join TipuriAchizitii B'
      '  on A.idTipuriAchizitii = B.idTipuriAchizitii'
      '  left join TipuriContracte C'
      '  on A.idTipuriContracte = C.idTipuriContracte'
      '  left join StariAchizitii D'
      '  on A.idStariAchizitii = D.idStariAchizitii'
      '  left join CoduriCPV E'
      '  on A.idCoduriCPV = E.idCoduriCPV'
      '  left join AchizitiiCalendar F'
      '  on A.idAchizitii = F.idAchizitii and F.idAchizitiiCalendar in'
      '  (select'
      '    top 1 idAchizitiiCalendar'
      '    from AchizitiiCalendar'
      '    where DataEstimata is not null and DataEfectiva is null'
      '    order by DataEstimata)')
    Params = <>
    Left = 400
    Top = 64
  end
  object dsAchizitii: TDataSource
    DataSet = qryAchizitii
    Left = 432
    Top = 64
  end
