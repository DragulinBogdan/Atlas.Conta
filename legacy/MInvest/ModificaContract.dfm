  object qryObiecteOfertantiUSR: TZQuery
    AfterOpen = qryObiecteOfertantiUSRAfterOpen
    SQL.Strings = (
      ' select idContracteOfertanti,         '
      '        idParinte,        '
      '        idInvContabilitate,            '
      '        idContracte,                   '
      '        idFinantariPropuneri,        '
      '        dataCursValutar,    '
      '        cursValutar,                '
      '        pretFaraTVALei,            '
      '        pretFaraTVAEuro,            '
      '        valoareTVALei,            '
      '        pretTVALei,'
      '        stare      '
      ' from ContracteOfertanti            '
      ' where idContracte = :idContracte'
      ' and not idParinte is null        '
      ' and stare = 1'
      ' order by idParinte         '
      '             ')
    Params = <
      item
        DataType = ftInteger
        Precision = 10
        Name = 'idContracte'
        ParamType = ptUnknown
        Size = 4
      end>
    Left = 832
    Top = 456
    ParamData = <
      item
        DataType = ftInteger
        Precision = 10
        Name = 'idContracte'
        ParamType = ptUnknown
        Size = 4
      end>
  end
  object qryContracteOfertantiUSR: TZQuery
    SQL.Strings = (
      'select idContracteOfertanti,             '
      '        idParinte,                  '
      '        idContracte,                '
      '        idOfertanti,                     '
      '        liderAsociere,                '
      '        pretFaraTVALei,                '
      '        pretFaraTVAEuro,                '
      '        valoareTVALei,                '
      '        pretTVALei,                '
      '        contGarantie,      '
      '        contCurent,              '
      '        procentGarantieDepusa,              '
      '        valoareGarantieDepusa,          '
      '        procentGarantieRetinuta,              '
      '        valoareGarantieRetinuta,'
      '        stare           '
      ' from ContracteOfertanti                '
      ' where idContracte = :idContracte'
      ' and idParinte is null            '
      ' and (stare = 1 or stare is null)     ')
    Params = <
      item
        DataType = ftInteger
        Precision = 10
        Name = 'idContracte'
        ParamType = ptUnknown
        Size = 4
      end>
    Left = 832
    Top = 424
    ParamData = <
      item
        DataType = ftInteger
        Precision = 10
        Name = 'idContracte'
        ParamType = ptUnknown
        Size = 4
      end>
  end
