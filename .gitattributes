# Terminatorii de linie: LF peste tot; CRLF doar unde interpretorul îl cere.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Evidența (legacy Delphi, exporturile bazei vechi): octeții rămân neatinși.
legacy/** -text
db/export/** -text

# Artefactele ANAF pin-uite prin SHA-256 (TR-D8 S0): octeții publicați, neatinși.
nou/tools/ModelCheck/Anaf/** -text
