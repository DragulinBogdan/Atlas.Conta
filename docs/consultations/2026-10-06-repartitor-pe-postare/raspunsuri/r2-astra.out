50:         void Plati(List<PostareJurnal> jurnal, Dictionary<Guid, DocPlata> plati) {
51:             var evenimente = jurnal
52:                 .Where(p => p.DocumentId is Guid d && plati.TryGetValue(d, out var info) && info.Fel != FelExtern.Virament
53:                     && p.Fel is N.FelTranzactie.Operare or N.FelTranzactie.Storno)
54:                 .Select(p => (p.TranzactieId, Document: p.DocumentId.Value, p.Fel, p.DataTranzactie)).Distinct()
55:                 .OrderBy(e => e.DataTranzactie)
56:                 .ThenBy(e => documente[e.Document].Numar ?? "", StringComparer.Ordinal)
57:                 .ThenBy(e => e.TranzactieId).ToList();
58:             if (evenimente.Count == 0)
59:                 return;
60:             foreach (var e in evenimente.Where(e => plati[e.Document].Contrapartida == null))
61:                 Refuza(RefuzSursa, $"{Eticheta(e.Document)}: tipul documentului nu declară latura contului propriu.",
62:                     e.Document, e.TranzactieId);
63:             var contra = plati.Values.Where(p => p.Fel != FelExtern.Virament && p.Contrapartida != null)
64:                 .Where(p => evenimente.Any(e => e.Document == p.Id))
65:                 .ToDictionary(p => p.Id, p => p.Contrapartida.Value);
66:             var alocari = Cub.Citiri.Plati.Alocari(os, contra);
67:             var idsEvenimente = evenimente.Select(e => e.TranzactieId).ToList();
68:             var postari = Cub.Citiri.Plati.Postari(os).Where(p => idsEvenimente.Contains(p.TranzactieId)).ToList()
69:                 .GroupBy(p => p.TranzactieId).ToDictionary(g => g.Key, g => g.ToList());
70:             var idsTinte = alocari.Values.SelectMany(a => a.Linii).Select(l => l.DocumentTinta).OfType<Guid>().Distinct().ToList();
71:             var tinte = os.GetObjectsQuery<Document>().Where(d => idsTinte.Contains(d.ID))
72:                 .Select(d => new { d.ID, d.Numar, d.Data }).ToList().ToDictionary(d => d.ID);
73: 
74:             foreach (var e in evenimente.Where(e => contra.ContainsKey(e.Document))) {
75:                 var info = plati[e.Document];
76:                 var a = alocari[e.Document];
77:                 var storno = e.Fel == N.FelTranzactie.Storno;
78:                 var semn = storno ? -1m : 1m;
79:                 var eticheta = Eticheta(e.Document);
80:                 var proprii = postari.GetValueOrDefault(e.TranzactieId, []).Where(p => p.Latura == info.Contrapartida).ToList();
81:                 if (info.Fel == FelExtern.Altul) {
82:                     NeinclusPlata(CauzaNeincludere.DocumentFaraPartener, e.Document, info.Extern, proprii);
83:                     continue;
84:                 }
85:                 if (a.Erori.Count > 0) {
86:                     Refuza(RefuzProvenienta, $"{eticheta}: alocarea plății nu se derivă din cub ({string.Join("; ", a.Erori)}).",
87:                         e.Document, e.TranzactieId);
88:                     continue;
89:                 }
90:                 if (a.Operare.Any(p => p.Valuta != null) || fapte.Keys.Any(k => k.Tranzactie == e.TranzactieId)) {
91:                     Refuza(RefuzSursa, $"{eticheta}: plata are valută sau fapte fiscale, pe care Payments nu le acoperă.",
92:                         e.Document, e.TranzactieId);
93:                     continue;
94:                 }
95:                 if (a.Operare.Select(p => p.Partener).OfType<Guid>().Distinct().Count() > 1) {
96:                     Refuza(RefuzProvenienta, $"{eticheta}: plata are mai mulți parteneri pe contrapartidă.", e.Document, e.TranzactieId);
97:                     continue;
98:                 }
99:                 if (info.Fel == FelExtern.Partener && a.Linii.All(l => Rol(l.Cont) == RolTertCont.Niciunul)) {
100:                     Avert(CodAvertismentSaft.PlataFaraContTert,
101:                         $"{eticheta} n-are pe contrapartidă niciun cont cu rol de terț (`Cont.RolTert`).",
102:                         proprii.Sum(p => p.Valoare));
103:                     NeinclusPlata(CauzaNeincludere.ContFaraRol, e.Document, info.Extern, proprii);
104:                     continue;
105:                 }
106:                 var conservata = proprii.GroupBy(p => (p.Cont, p.Latura))
107:                     .Select(g => (g.Key, Suma: g.Sum(p => p.Valoare)))
108:                     .Concat(a.Linii.GroupBy(l => (l.Cont, l.Latura)).Select(g => (g.Key, Suma: -semn * g.Sum(l => l.Suma))))
109:                     .GroupBy(x => x.Key).All(g => g.Sum(x => x.Suma) == 0m);
110:                 if (!conservata) {
111:                     Refuza(RefuzProvenienta, $"{eticheta}: suma evenimentului nu este suma liniilor de plată pe cont și latură.",
112:                         e.Document, e.TranzactieId);
113:                     continue;
114:                 }
115:                 if (info.Fel == FelExtern.Angajat)
116:                     Avert(CodAvertismentSaft.PlataCatreAngajat,
117:                         $"{eticheta} are ca partener un angajat — `CustomerID`/`SupplierID` ies cu codul societății.");
118: 
119:                 var doc = documente[e.Document];
120:                 var (metoda, mecanism) = SaftReguli.MetodaPlata(info.Instrument);
121:                 var cod = CodTip(e.Document);
122:                 var descriere = $"{tipuriDocument.GetValueOrDefault(cod) ?? cod} {doc.Numar}".Trim() + (storno ? " (storno)" : "");
123:                 var plata = new SaftPlata {
124:                     DocumentId = e.Document, Storno = storno, DocumentTip = cod,
125:                     PaymentRefNo = doc.Numar, TransactionID = e.TranzactieId.ToString(),
126:                     TransactionDate = e.DataTranzactie,
127:                     PaymentMethod = metoda, PaymentMechanism = mecanism, Description = descriere,
128:                 };
129:                 var pozitie = 0;
130:                 foreach (var l in a.Linii
131:                              .OrderBy(l => l.Tinta)
132:                              .ThenBy(l => l.DocumentTinta is Guid t ? tinte[t].Data : DateOnly.MinValue)
133:                              .ThenBy(l => l.DocumentTinta is Guid t ? tinte[t].Numar ?? "" : "", StringComparer.Ordinal)
134:                              .ThenBy(l => l.DocumentTinta)
135:                              .ThenBy(l => Simbol(l.Cont), StringComparer.Ordinal)
136:                              .ThenBy(l => l.Unitate)) {
137:                     if (l.Tinta == TintaPlata.PartidaInitiala)
138:                         Avert(CodAvertismentSaft.PlataPePartidaInitiala, $"{eticheta}: {l.Suma * semn} pe o partidă inițială.");
139:                     var (customer, supplier) = info.Fel == FelExtern.Angajat
140:                         ? (idSocietate, idSocietate)
141:                         : IdentitatiPlata(l.Cont, l.Partener ?? info.Extern, eticheta);
142:                     var chei = l.Contributii.Select(p => (p.CentruCost, p.Proiect, p.UnitateOrganizatorica,
143:                         p.SursaFinantare, p.CodFunctional, p.CodEconomic)).Distinct().ToList();
144:                     if (chei.Count > 1)
145:                         Avert(CodAvertismentSaft.PlataAnalizaMixta, $"{eticheta}: linia pe contul {Simbol(l.Cont)}.");
146:                     var linii = l.Contributii.Select(p => p.LinieId).Distinct().ToList();
147:                     var contributii = l.Contributii.Select(p => p.Id).ToHashSet();
148:                     var surse = (storno
149:                             ? proprii.Where(p => p.InversaDinId is Guid o && contributii.Contains(o)).Select(p => new SursaPlata(p.Spatiu, p.Id))
150:                             : l.Contributii.Select(p => new SursaPlata(p.Spatiu, p.Id)))
Cub/Storno.cs
1: namespace Atlas.Conta.Nucleu;
2: 
3: public static class Storno {
4:     public static Tranzactie Inverseaza(IEnumerable<Postare> cauzateSiAtribuite, Guid document, DateOnly data) =>
5:         Inverseaza(cauzateSiAtribuite, document, data, null);
6: 
7:     // N-D10 amendat (TR-D7a S-D5): reperul fiscal al stornoului e perioada stornării.
8:     public static Tranzactie Inverseaza(
9:             IEnumerable<Postare> cauzateSiAtribuite, Guid document, DateOnly data, int? perioadaDeclarare) {
10:         ArgumentNullException.ThrowIfNull(cauzateSiAtribuite);
11:         // N-D10: fără schimb de latură; cauza și atribuirea rămân ale postării stornate.
12:         var postari = cauzateSiAtribuite
13:             .Select(postare => postare with {
14:                 Coordonate = postare.Coordonate with {
15:                     Data = data,
16:                     ReperFiscal = postare.Coordonate.ReperFiscal is { } reper
17:                         ? reper with { PerioadaD394 = data.Year * 100 + data.Month, DataInregistrare = data }
18:                         : null,
19:                     PerioadaDeclarare = perioadaDeclarare is { } noua && postare.Coordonate.PerioadaDeclarare is not null
20:                         ? noua
21:                         : postare.Coordonate.PerioadaDeclarare,
22:                 },
23:                 Cantitate = -postare.Cantitate,
24:                 ValoareValuta = -postare.ValoareValuta,
25:                 Valoare = -postare.Valoare,
26:             })
27:             .ToArray();
28:         if (postari.Length == 0)
29:             throw new ArgumentException("nu există nicio postare de stornat.", nameof(cauzateSiAtribuite));
30:         return new Tranzactie(FelTranzactie.Storno, data, document, postari);
31:     }
32: 
33:     public static IReadOnlyList<Postare> Selecteaza(
34:         IReadOnlyList<(Guid Id, Postare Postare)> postari,
35:         Guid document) {
36:         ArgumentNullException.ThrowIfNull(postari);
37:         var cauzate = new HashSet<Guid>();
38:         foreach (var (id, postare) in postari)
39:             if (postare.Cauza.Document == document)
40:                 cauzate.Add(id);
41:         var selectate = new List<Postare>();
42:         // Un singur salt: atribuitul e o postare de valoare care arată spre o postare de stoc (N-D10).
43:         foreach (var (id, postare) in postari)
44:             if (cauzate.Contains(id) || (postare.Atribuit is { } tinta && cauzate.Contains(tinta)))
45:                 selectate.Add(postare);
46:         return selectate;
47:     }
48: }
Motor/Mutare.cs
1: namespace Atlas.Conta.Nucleu;
2: 
3: public sealed record Mutare(
4:     Capat DeLa,
5:     Capat La,
6:     Latura Latura,
7:     decimal Cantitate,
8:     decimal ValoareValuta,
9:     decimal Valoare,
10:     Cauza Cauza) {
11: 
12:     public ReferintaPostare? Suport { get; init; }
13: 
14:     // 090f: transferul conservă pe (Cont, Latura), deci cele două postări stau pe ACEEAȘI latură.
15:     public static (Postare Iesire, Postare Intrare) Postari(Mutare mutare, DateOnly data) {
16:         ArgumentNullException.ThrowIfNull(mutare);
17:         if (mutare.DeLa.Cont != mutare.La.Cont)
18:             throw new ArgumentException(
19:                 $"transferul mută între contul {mutare.DeLa.Cont} și contul {mutare.La.Cont}.",
20:                 nameof(mutare));
21:         return (
22:             new Postare(
23:                 mutare.DeLa.Pe(mutare.Latura, data),
24:                 -mutare.Cantitate,
25:                 -mutare.ValoareValuta,
26:                 -mutare.Valoare,
27:                 mutare.Cauza) { Suport = mutare.Suport },
28:             new Postare(
29:                 mutare.La.Pe(mutare.Latura, data),
30:                 mutare.Cantitate,
31:                 mutare.ValoareValuta,
32:                 mutare.Valoare,
33:                 mutare.Cauza) { Suport = mutare.Suport });
34:     }
35: }
Motor/Transformare.cs
1: namespace Atlas.Conta.Nucleu;
2: 
3: public enum RolTransformare { Consum = 1, Produs = 2 }
4: 
5: public sealed record Transformare(
6:     Capat Real,
7:     RolTransformare Rol,
8:     FelTranzactie Fel,
9:     decimal Cantitate,
10:     decimal Valoare,
11:     Cauza Cauza) {
12: 
13:     public static (Postare Reala, Postare Contrapondere) Postari(Transformare linie, DateOnly data) {
14:         ArgumentNullException.ThrowIfNull(linie);
15:         var real = linie.Real;
16:         if (real is null || real.Unitate is not { Fel: FelUnitate.Lot } lot
17:                 || real.Gestiune is null || GestiuniVirtuale.Este(real.Gestiune)
18:                 || real.Produs is null || real.Produs != lot.Produs || real.Cont != lot.Cont
19:                 || real.Carte != Carte.Contabil || real.Partener != null || lot.Partener != null
20:                 || real.CodTva != null || real.PerioadaDeclarare != null || real.Valuta != null)
21:             throw new ArgumentException("Transformarea cere un lot pe gestiune reală, în cartea contabilă, fără terț, TVA sau valută.", nameof(linie));
22:         if (linie.Rol is not (RolTransformare.Consum or RolTransformare.Produs)
23:                 || linie.Fel is not (FelTranzactie.Operare or FelTranzactie.Transfer)
24:                 || linie.Cantitate <= 0m || linie.Valoare < 0m)
25:             throw new ArgumentException("Linia transformării cere rol, fel, cantitate pozitivă și valoare nenegativă.", nameof(linie));
26:         var consum = linie.Rol == RolTransformare.Consum;
27:         var latura = consum && linie.Fel == FelTranzactie.Operare ? Latura.Credit : Latura.Debit;
28:         var cantitate = consum ? -linie.Cantitate : linie.Cantitate;
29:         var valoare = consum && linie.Fel == FelTranzactie.Transfer ? -linie.Valoare : linie.Valoare;
30:         var virtuala = linie.Real with { Gestiune = GestiuniVirtuale.Transformare, Unitate = null };
31:         return (new Postare(linie.Real.Pe(latura, data), cantitate, 0m, valoare, linie.Cauza),
32:             new Postare(virtuala.Pe(latura, data), -cantitate, 0m, 0m, linie.Cauza));
33:     }
34: }
Cub/Unitate.cs
1: using System.Security.Cryptography;
2: 
3: namespace Atlas.Conta.Nucleu;
4: 
5: public sealed record Unitate(
6:     Guid Id,
7:     FelUnitate Fel,
8:     Guid Cont,
9:     Guid? Partener,
10:     Guid? Produs,
11:     DateOnly Deschisa) {
12: 
13:     // `with` ocolește constructorul; cerința se apără și în `init` (N-D6).
14:     readonly Guid? partener = Ceruta(Fel, FelUnitate.Partida, Partener, nameof(Partener));
15:     readonly Guid? produs = Ceruta(Fel, FelUnitate.Lot, Produs, nameof(Produs));
16: 
17:     public Guid? Partener {
18:         get => partener;
19:         init => partener = Ceruta(Fel, FelUnitate.Partida, value, nameof(Partener));
20:     }
21: 
22:     public Guid? Produs {
23:         get => produs;
24:         init => produs = Ceruta(Fel, FelUnitate.Lot, value, nameof(Produs));
25:     }
26: 
27:     public static Unitate DeschidePartida(Guid cont, Guid partener, Guid documentDeschizator, DateOnly data) =>
28:         new(Identitate(documentDeschizator, cont, partener), FelUnitate.Partida, cont, partener, null, data);
29: 
30:     public static Unitate DeschidePartidaInitiala(Guid cont, Guid partener, Guid referinta, DateOnly data) =>
31:         new(Identitate(referinta, cont, partener, initiala: true), FelUnitate.Partida, cont, partener, null, data);
32: 
33:     public decimal? Raport(Sold sold) {
34:         ArgumentNullException.ThrowIfNull(sold);
35:         return Fel switch {
36:             FelUnitate.Lot => sold.Cantitate == 0m ? null : sold.Net / sold.Cantitate,
37:             FelUnitate.Partida => sold.ValoareValuta == 0m ? null : sold.Net / sold.ValoareValuta,
38:             _ => sold.Net,
39:         };
40:     }
41: 
42:     // 092a: SHA-256(document ‖ cont ‖ partener), Guid din primii 16 octeți, versiune 8.
43:     static Guid Identitate(Guid document, Guid cont, Guid partener, bool initiala = false) {
44:         var intrare = new byte[initiala ? 49 : 48];
45:         if (initiala) intrare[48] = 1;
46:         document.ToByteArray().CopyTo(intrare, 0);
47:         cont.ToByteArray().CopyTo(intrare, 16);
48:         partener.ToByteArray().CopyTo(intrare, 32);
49:         var amprenta = SHA256.HashData(intrare);
50:         var id = amprenta[..16];
51:         id[7] = (byte)((id[7] & 0x0F) | 0x80);
52:         return new Guid(id);
53:     }
54: 
55:     static Guid? Ceruta(FelUnitate fel, FelUnitate cere, Guid? valoare, string nume) =>
56:         fel == cere && valoare is null
57:             ? throw new ArgumentException($"unitatea de fel {fel} se cere cu {nume}.", nume)
58:             : valoare;
59: }

