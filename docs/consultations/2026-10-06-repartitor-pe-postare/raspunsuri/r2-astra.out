DeclarantAsamblare.cs
1: #nullable enable
2: using N = Atlas.Conta.Nucleu;
3: 
4: namespace Atlas.Conta.BackOffice.Module.Declaratii;
5: 
6: public sealed class DeclarantAsamblare : IDeclarant {
7:     public static readonly DeclarantAsamblare Instanta = new();
8:     DeclarantAsamblare() { }
9:     public bool CereSoldRegistruPentruEvaluare => true;
10: 
11:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
12:         ArgumentNullException.ThrowIfNull(operand);
13:         ArgumentNullException.ThrowIfNull(rotunjire);
14:         ArgumentNullException.ThrowIfNull(refuzuri);
15:         var doc = operand.Document;
16:         var linii = operand.Linii;
17:         var proprii = linii.Select(l => l.Id).ToHashSet();
18:         if (!linii.Any(l => l.Transformare?.Rol == N.RolTransformare.Consum)
19:                 || !linii.Any(l => l.Transformare?.Rol == N.RolTransformare.Produs))
20:             refuzuri.Add(new(CoduriRefuz.AsamblareStructuraInvalida, "Asamblarea cere consum și produs.", null));
21:         foreach (var l in linii) {
22:             if (l.Transformare?.Rol is not (N.RolTransformare.Consum or N.RolTransformare.Produs))
23:                 refuzuri.Add(new(CoduriRefuz.AsamblareStructuraInvalida, "Linia cere rol consum/produs.", l.Id));
24:             if (l.Cantitate == 0m)
25:                 refuzuri.Add(new(CoduriRefuz.CantitateNepozitiva, "Cantitatea absolută trebuie să fie pozitivă.", l.Id));
26:             if (l.Lot is not { } lot) {
27:                 refuzuri.Add(new(CoduriRefuz.LotLipsa, "Linia cere un lot.", l.Id));
28:                 continue;
29:             }
30:             if (lot.ContImplicitId is null)
31:                 refuzuri.Add(new(CoduriRefuz.ContStocLipsa, "Lotul cere cont de stoc.", l.Id));
32:             if (lot.TipMaterialId != l.TipMaterialId)
33:                 refuzuri.Add(new(CoduriRefuz.AsamblareStructuraInvalida, "Tipul liniei diferă de cel al lotului.", l.Id));
34:             if (l.Transformare?.Rol == N.RolTransformare.Produs) {
35:                 if (lot.LinieIntrareId != l.Id || lot.GestiuneId != doc.Predator.Id
36:                         || (l.ProdusId is Guid produsCules && produsCules != lot.ProdusId)
37:                         || l.Transformare.PretProdus is not > 0m)
38:                     refuzuri.Add(new(CoduriRefuz.AsamblareStructuraInvalida,
39:                         "Produsul cere lot propriu în gestiunea de asamblare și preț pozitiv.", l.Id));
40:             }
41:             else if (lot.LinieIntrareId is Guid intrare && proprii.Contains(intrare))
42:                 refuzuri.Add(new(CoduriRefuz.AsamblareStructuraInvalida, "Consumul nu poate referi lotul propriu documentului.", l.Id));
43:         }
44:         if (refuzuri.Count > 0) return null;
45: 
46:         var decizii = new List<N.Decizie>();
47:         var ipoteze = new List<N.Ipoteza> { operand.PerioadaDeschisa, operand.VersiunePolitica };
48:         var solduriCub = new Dictionary<CheieLotFapt, N.Sold>();
49:         var solduriRegistru = new Dictionary<Guid, N.Sold>();
50:         var valori = new List<ValoriLinie>();
51:         foreach (var l in linii) {
52:             var lot = l.Lot!;
53:             var cheie = new CheieLotFapt(lot.Id, lot.ContImplicitId!.Value, lot.ProdusId, doc.Predator.Id);
54:             var unitate = new N.Unitate(lot.Id, N.FelUnitate.Lot, lot.ContImplicitId!.Value,
55:                 null, lot.ProdusId, lot.Data);
56:             var q = Math.Abs(l.Cantitate);
57:             var produs = l.Transformare!.Rol == N.RolTransformare.Produs;
58:             decimal r = 0m, c = 0m, p = 0m;
59:             if (produs) p = rotunjire.Bani(q * l.Transformare.PretProdus!.Value);
60:             else {
61:                 if (!solduriCub.TryGetValue(cheie, out var sold)) {
62:                     sold = operand.SolduriLoturi.GetValueOrDefault(cheie) ?? N.Sold.Zero;
63:                     solduriRegistru[lot.Id] = operand.SolduriLoturiRegistru.GetValueOrDefault(lot.Id) ?? N.Sold.Zero;
64:                     ipoteze.Add(new N.SoldUnitateCitit(unitate, sold));
65:                 }
66:                 try { c = N.Evaluare.Iesire(sold, q, rotunjire); }
67:                 catch (N.RefuzException e) { refuzuri.Add(e.Refuz with { Linie = l.Id }); continue; }
68:                 var registru = solduriRegistru[lot.Id];
69:                 r = q == registru.Cantitate ? registru.Net : rotunjire.Bani(q * lot.PretUnitar);
70:                 solduriCub[cheie] = sold with { Credit = sold.Credit + c, Cantitate = sold.Cantitate - q };
71:                 solduriRegistru[lot.Id] = registru with { Credit = registru.Credit + r, Cantitate = registru.Cantitate - q };
72:                 decizii.Add(new N.ValoareIesire(l.Id, unitate, q, c));
73:             }
74:             valori.Add(new(l, unitate, q, r, c, p, produs));
75:             decizii.Add(new N.ContRezolvat(l.Id, unitate.Cont, "TipMaterial"));
76:         }
77:         if (refuzuri.Count > 0) return null;
78:         var totalR = valori.Sum(l => l.R);
79:         var totalP = valori.Sum(l => l.P);
80:         if (totalP != totalR) {
81:             refuzuri.Add(new(CoduriRefuz.AsamblareNebalansata,
82:                 $"Consum R={totalR}; produse P={totalP}; diferență P−R={totalP - totalR}. Redistribuiți valoarea.", null));
83:             return null;
84:         }
85: 
86:         var grupuri = valori.GroupBy(l => l.Unitate.Cont).ToList();
87:         var feluri = grupuri.ToDictionary(g => g.Key,
88:             g => g.Sum(l => l.P) == g.Sum(l => l.R) ? N.FelTranzactie.Transfer : N.FelTranzactie.Operare);
89:         var tintaOperare = valori.LastOrDefault(l => l.Produs && feluri[l.Unitate.Cont] == N.FelTranzactie.Operare);
90:         var ajustari = new Dictionary<Guid, decimal>();
91:         foreach (var g in grupuri) {
92:             var r = g.Sum(l => l.R);
93:             var c = g.Sum(l => l.C);
94:             var delta = c - r;
95:             var tinta = g.LastOrDefault(l => l.Produs)
96:                 ?? (feluri[g.Key] == N.FelTranzactie.Operare ? tintaOperare : null);
97:             if (tinta is null) {
98:                 if (delta != 0m)
99:                     refuzuri.Add(new(CoduriRefuz.AsamblareDeltaFaraAncora,
100:                         $"Cont {g.Key}: Δ={delta}, fără produs eligibil pentru absorbție.", null));
101:                 continue;
102:             }
103:             ajustari[tinta.Linie.Id] = ajustari.GetValueOrDefault(tinta.Linie.Id) + delta;
104:             decizii.Add(new N.AbsorbtieEvaluare(doc.Id, tinta.Linie.Id, g.Key, r, c, tinta.P, delta));
105:         }
106:         var transformari = new List<N.Transformare>();
107:         foreach (var l in valori) {
108:             var valoare = l.Produs ? l.P + ajustari.GetValueOrDefault(l.Linie.Id) : l.C;
109:             if (l.Produs && valoare <= 0m)
110:                 refuzuri.Add(new(CoduriRefuz.AsamblareProdusNepozitiv,
111:                     $"Valoarea produsului după absorbție este {valoare}; trebuie să fie pozitivă.", l.Linie.Id));
112:             transformari.Add(new(new N.Capat {
113:                 Cont = l.Unitate.Cont, Unitate = l.Unitate, Produs = l.Unitate.Produs,
114:                 Gestiune = doc.Predator.Id, Analiza = l.Linie.Analiza,
115:             }, l.Produs ? N.RolTransformare.Produs : N.RolTransformare.Consum,
116:                 feluri[l.Unitate.Cont], l.Q, valoare, new N.Cauza(doc.Id, l.Linie.Id)));
117:         }
118:         return refuzuri.Count > 0 ? null
119:             : new N.Declaratie(doc.Id, doc.DataInregistrare, [], [], transformari, decizii, ipoteze);
120:     }
121: 
122:     sealed record ValoriLinie(LinieOperand Linie, N.Unitate Unitate, decimal Q,
123:         decimal R, decimal C, decimal P, bool Produs);
124: }
DeclarantDiferenteInventar.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using Atlas.Conta.BackOffice.Module.Motor;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: public sealed class DeclarantDiferenteInventar : IDeclarant {
9:     public static readonly DeclarantDiferenteInventar Instanta = new();
10:     DeclarantDiferenteInventar() { }
11: 
12:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
13:         ArgumentNullException.ThrowIfNull(operand);
14:         ArgumentNullException.ThrowIfNull(rotunjire);
15:         ArgumentNullException.ThrowIfNull(refuzuri);
16:         var doc = operand.Document;
17:         var proprii = operand.Linii.Select(l => l.Id).ToHashSet();
18:         var miscari = new List<N.Miscare>();
19:         var decizii = new List<N.Decizie>();
20:         var ipoteze = new List<N.Ipoteza>();
21:         var solduri = new Dictionary<CheieLotFapt, N.Sold>();
22:         if (operand.Linii.Count == 0)
23:             refuzuri.Add(new(CoduriRefuz.LiniiLipsa, "Lista de inventar cere cel puțin o linie.", null));
24:         foreach (var culeasa in operand.Linii) {
25:             var initial = refuzuri.Count;
26:             void Refuza(string cod, string mesaj) => refuzuri.Add(new(cod, mesaj, culeasa.Id));
27:             if (culeasa.DiferentaInventar?.Directie is not (DirectieDiferenta.Plus or DirectieDiferenta.Minus)) {
28:                 Refuza(CoduriRefuz.InventarStructuraInvalida, "Linia cere direcția Plus sau Minus.");
29:                 continue;
30:             }
31:             var plus = culeasa.DiferentaInventar.Directie == DirectieDiferenta.Plus;
32:             var q = Math.Abs(culeasa.Cantitate);
33:             var linie = culeasa with { Cantitate = plus ? q : -q };
34:             if (q == 0m) Refuza(CoduriRefuz.CantitateNepozitiva, "Cantitatea absolută trebuie să fie pozitivă.");
35:             if (linie.Natura != NaturaClasa.Stoc)
36:                 Refuza(CoduriRefuz.NaturaNepotrivita, "Diferența de inventar cere natura Stoc.");
37:             if (linie.Lot is not { } lot) {
38:                 Refuza(CoduriRefuz.LotLipsa, "Linia de inventar cere un lot.");
39:                 continue;
40:             }
41:             if (lot.TipMaterialId != linie.TipMaterialId || linie.TipProdusCulesId is Guid tip && tip != linie.TipMaterialId
42:                     || linie.ProdusId is Guid produs && produs != lot.ProdusId)
43:                 Refuza(CoduriRefuz.ProdusAltTip, "Tipul și produsul liniei trebuie să corespundă lotului.");
44:             if (plus) {
45:                 if (lot.LinieIntrareId != linie.Id || lot.GestiuneId != doc.Predator.Id)
46:                     Refuza(CoduriRefuz.InventarStructuraInvalida, "Plusul cere lot propriu în gestiunea inventariată.");
47:                 if (linie.DiferentaInventar!.PretEvaluare is not > 0m)
48:                     Refuza(CoduriRefuz.ValoareNepozitiva, "Plusul cere preț de evaluare pozitiv.");
49:             }
50:             else if (lot.LinieIntrareId is Guid origine && proprii.Contains(origine))
51:                 Refuza(CoduriRefuz.InventarStructuraInvalida, "Minusul nu poate consuma un lot propriu documentului.");
52:             var stoc = Potrivire.Stoc(operand.ReguliStoc, linie.Fapt).SelectMany(p => p.Reguli).ToArray();
53:             if (stoc.Length != 1 || stoc[0].Latura != LaturaDocument.Predator || stoc[0].Semn != 1
54:                     || stoc[0].TipStoc is not (TipStoc.Magazie or TipStoc.Marfuri or TipStoc.Folosinta))
55:                 Refuza(CoduriRefuz.InventarStocNeacoperit, "Lista cere o singură regulă Magazie/Marfuri/Folosinta, +1 pe gestiunea inventariată.");
56:             var contare = Contari.Rezolva(operand, linie, refuzuri);
57:             if (refuzuri.Count != initial) continue;
58:             var cont = contare!.Value;
59:             var contStoc = plus ? cont.ContDebit : cont.ContCredit;
60:             if (contStoc != lot.ContImplicitId) {
61:                 Refuza(CoduriRefuz.ContStocLipsa, "Contul de stoc rezolvat trebuie să fie contul lotului.");
62:                 continue;
63:             }
64:             var cheie = new CheieLotFapt(lot.Id, contStoc, lot.ProdusId, doc.Predator.Id);
65:             var unitate = new N.Unitate(lot.Id, N.FelUnitate.Lot, contStoc, null, lot.ProdusId, lot.Data);
66:             decimal v;
67:             if (plus) {
68:                 v = rotunjire.Bani(q * linie.DiferentaInventar!.PretEvaluare!.Value);
69:             }
70:             else {
71:                 if (!solduri.TryGetValue(cheie, out var sold)) {
72:                     sold = operand.SolduriLoturi.GetValueOrDefault(cheie) ?? N.Sold.Zero;
73:                     ipoteze.Add(new N.SoldUnitateCitit(unitate, sold));
74:                 }
75:                 try { v = N.Evaluare.Iesire(sold, q, rotunjire); }
76:                 catch (N.RefuzException e) { Refuza(e.Refuz.Cod, e.Refuz.Mesaj); continue; }
77:                 solduri[cheie] = sold with { Credit = sold.Credit + v, Cantitate = sold.Cantitate - q };
78:                 decizii.Add(new N.ValoareIesire(linie.Id, unitate, q, v));
79:             }
80:             var real = new N.Capat { Cont = contStoc, Gestiune = doc.Predator.Id, Produs = lot.ProdusId,
81:                 Unitate = unitate, Analiza = Contari.Analiza(linie.Analiza,
82:                     plus ? cont.Regula.OverrideDebit : cont.Regula.OverrideCredit, cont.Regula.Comun) };
83:             var virtuala = new N.Capat { Cont = plus ? cont.ContCredit : cont.ContDebit,
84:                 Gestiune = plus ? N.GestiuniVirtuale.Inventar : N.GestiuniVirtuale.Consum,
85:                 Produs = lot.ProdusId, Analiza = Contari.Analiza(linie.Analiza,
86:                     plus ? cont.Regula.OverrideCredit : cont.Regula.OverrideDebit, cont.Regula.Comun) };
87:             miscari.Add(new(plus ? virtuala : real, plus ? real : virtuala, q, 0m, v, new(doc.Id, linie.Id)));
88:             decizii.Add(new N.ContRezolvat(linie.Id, cont.ContDebit, cont.SursaDebit.ToString()));
89:             decizii.Add(new N.ContRezolvat(linie.Id, cont.ContCredit, cont.SursaCredit.ToString()));
90:         }
91:         if (refuzuri.Count > 0) return null;
92:         ipoteze.Add(operand.PerioadaDeschisa); ipoteze.Add(operand.VersiunePolitica);
93:         return new(doc.Id, doc.DataInregistrare, miscari, decizii, ipoteze);
94:     }
95: }
DeclarantDvi.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using Atlas.Conta.BackOffice.Module.Motor;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: public sealed class DeclarantDvi : IDeclarant {
9:     public static readonly DeclarantDvi Instanta = new();
10:     DeclarantDvi() { }
11: 
12:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
13:         ArgumentNullException.ThrowIfNull(operand);
14:         ArgumentNullException.ThrowIfNull(rotunjire);
15:         ArgumentNullException.ThrowIfNull(refuzuri);
16:         if (operand.Linii.Count == 0)
17:             refuzuri.Add(new(CoduriRefuz.LiniiLipsa, "Declarația vamală cere cel puțin o linie.", null));
18:         if (operand.PoliticaTva is null)
19:             refuzuri.Add(new(CoduriRefuz.PoliticaTvaLipsa, "Declarația vamală cere politică de TVA.", null));
20:         else if (operand.PoliticaTva.Directie != DirectieTva.Deductibil)
21:             refuzuri.Add(new(CoduriRefuz.DirectieTvaNepotrivita, "Declarația vamală cere TVA deductibil.", null));
22:         var tipuri = new TipTvaFapt?[operand.Linii.Count];
23:         for (var i = 0; i < operand.Linii.Count; i++) {
24:             var l = operand.Linii[i];
25:             if (l.Valoare <= 0m)
26:                 refuzuri.Add(new(CoduriRefuz.ValoareNepozitiva, "Baza vamală trebuie să fie pozitivă.", l.Id));
27:             if (l.TipTvaId is not Guid id || !operand.TipuriTva.TryGetValue(id, out var tip)) {
28:                 refuzuri.Add(new(CoduriRefuz.TipTvaLipsa, "Linia cere un tip de TVA de import.", l.Id));
29:                 continue;
30:             }
31:             if (!tip.DeImport || tip.Cota <= 0m || tip.Regim is not (RegimTva.Normal or RegimTva.TaxareInversa))
32:                 refuzuri.Add(new(CoduriRefuz.TvaImportNepotrivit, "Linia cere TVA de import cu cotă pozitivă.", l.Id));
33:             if (tip.ContTvaDeductibilId is null)
34:                 refuzuri.Add(new(CoduriRefuz.ContTvaLipsa, "Baza vamală cere contul de TVA deductibil.", l.Id));
35:             tipuri[i] = tip;
36:         }
37:         if (refuzuri.Count > 0) return null;
38:         var taxa = Fiscal.Taxa(operand, tipuri, rotunjire, refuzuri);
39:         if (refuzuri.Count > 0) return null;
40:         var doc = operand.Document;
41:         var miscari = new List<N.Miscare>();
42:         var decizii = new List<N.Decizie>();
43:         var partide = new Dictionary<Guid, N.Unitate>();
44:         for (var i = 0; i < operand.Linii.Count; i++) {
45:             var l = operand.Linii[i]; var tip = tipuri[i]!.Value;
46:             var impozit = Fiscal.Impozitul(operand, l, tip, taxa, DirectieTva.Deductibil, refuzuri);
47:             if (impozit is not null) {
48:                 Partide.Numeste(operand, impozit.DeLa.Cont, doc.Predator.Id, l.Id, partide, decizii);
49:                 Partide.Numeste(operand, impozit.La.Cont, doc.Predator.Id, l.Id, partide, decizii);
50:                 miscari.Add(impozit with {
51:                     DeLa = Partide.CuPartida(impozit.DeLa, doc.Predator.Id, partide),
52:                     La = Partide.CuPartida(impozit.La, doc.Predator.Id, partide),
53:                 });
54:             }
55:             var ancora = new N.Capat {
56:                 Cont = tip.ContTvaDeductibilId!.Value, Carte = N.Carte.Fiscal,
57:                 Gestiune = Fiscal.GestiuneaInterna(operand), Analiza = Contari.Analiza(l.Analiza, null, null),
58:             };
59:             miscari.Add(new(ancora, Fiscal.CuFapt(operand, ancora, tip, N.RolTva.Baza),
60:                 0m, 0m, l.Valoare, new(doc.Id, l.Id)));
61:         }
62:         return refuzuri.Count > 0 ? null : new(doc.Id, doc.DataInregistrare, miscari, decizii,
63:             [operand.PerioadaDeschisa, operand.VersiunePolitica]);
64:     }
65: }
DeclarantImobilizari.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using N = Atlas.Conta.Nucleu;
4: 
5: namespace Atlas.Conta.BackOffice.Module.Declaratii;
6: 
7: public sealed class DeclarantImobilizari : IDeclarant {
8:     public static readonly DeclarantImobilizari Instanta = new();
9:     DeclarantImobilizari() { }
10: 
11:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
12:         var miscari = new List<N.Miscare>();
13:         var mutari = new List<N.Mutare>();
14:         var folosit = new Dictionary<N.ReferintaPostare, decimal>();
15:         var peDimensiuni = new Dictionary<(N.Capat, N.Latura), decimal>();
16:         var iesiriFiscale = new HashSet<Guid>();
17:         if (operand.Linii.Count == 0)
18:             refuzuri.Add(new(CoduriRefuz.LiniiLipsa, "Documentul cere cel puțin o fișă.", null));
19:         foreach (var linie in operand.Linii) {
20:             var cules = linie.Imobilizare;
21:             if (cules == null || !operand.Fise.TryGetValue(cules.Fisa, out var fisa)) {
22:                 refuzuri.Add(new(CoduriRefuz.FisaLipsa, "Fișa liniei lipsește.", linie.Id));
23:                 continue;
24:             }
25:             var politicaLipsa = cules switch {
26:                 PifCules p => (p.AmortizareInitiala != 0m || p.AmortizareFiscalaInitiala != 0m)
27:                     && fisa.ContAmortizare == Guid.Empty,
28:                 AmoCules => fisa.ContAmortizare == Guid.Empty || fisa.ContCheltuiala == Guid.Empty,
29:                 CasCules => fisa.ContAmortizare == Guid.Empty || fisa.ContCedare == Guid.Empty,
30:                 _ => true,
31:             };
32:             if (fisa.Cont == Guid.Empty || politicaLipsa) {
33:                 refuzuri.Add(new(CoduriRefuz.PoliticaAmortizareLipsa,
34:                     "Fișa cere conturile politicii folosite de operație.", linie.Id));
35:                 continue;
36:             }
37:             var cauza = new N.Cauza(operand.Document.Id, linie.Id);
38:             N.Capat Capat(Guid cont, N.Carte carte, bool nominalizat) => new() {
39:                 Cont = cont, Carte = carte, Gestiune = fisa.Loc, Analiza = linie.Analiza,
40:                 Unitate = nominalizat ? new(fisa.Id, N.FelUnitate.Fisa, cont, null, null, fisa.Deschisa) : null,
41:             };
42:             void Nota(Guid debit, bool fisaDebit, Guid credit, bool fisaCredit, decimal suma, N.Carte carte) {
43:                 if (suma != 0m)
44:                     miscari.Add(new(Capat(credit, carte, fisaCredit), Capat(debit, carte, fisaDebit),
45:                         0m, 0m, suma, cauza));
46:             }
47:             switch (cules) {
48:                 case PifCules pif:
49:                     if (pif.Fel == FelLiniePif.Revizuire) {
50:                         var cap = Capat(fisa.Cont, N.Carte.Contabil, true);
51:                         mutari.Add(new(cap, cap, N.Latura.Debit, 0m, 0m, 0m, cauza));
52:                         break;
53:                     }
54:                     if (linie.Valoare <= 0m || pif.Fiscal < 0m || pif.AmortizareInitiala < 0m
55:                             || pif.AmortizareFiscalaInitiala < 0m) {
56:                         refuzuri.Add(new(CoduriRefuz.ValoareNepozitiva, "Valorile intrării nu sunt valide.", linie.Id));
57:                         break;
58:                     }
59:                     Aloca(fisa.Cont, N.Latura.Debit, linie.Valoare, pif.LinieSursa);
60:                     Aloca(fisa.ContAmortizare, N.Latura.Credit, pif.AmortizareInitiala, null);
61:                     Nota(fisa.Cont, true, fisa.Cont, false, pif.Fiscal, N.Carte.Fiscal);
62:                     Nota(fisa.ContAmortizare, false, fisa.ContAmortizare, true,
63:                         pif.AmortizareFiscalaInitiala, N.Carte.Fiscal);
64:                     break;
65:                 case AmoCules amo:
66:                     Nota(fisa.ContCheltuiala, false, fisa.ContAmortizare, true, linie.Valoare, N.Carte.Contabil);
67:                     Nota(fisa.ContCheltuiala, false, fisa.ContAmortizare, true, amo.Fiscal, N.Carte.Fiscal);
68:                     break;
69:                 case CasCules cas:
70:                     Nota(cas.Fel == FelLinieIesire.AmortizareCumulata ? fisa.ContAmortizare : fisa.ContCedare,
71:                         cas.Fel == FelLinieIesire.AmortizareCumulata, fisa.Cont, true, linie.Valoare, N.Carte.Contabil);
72:                     if (iesiriFiscale.Add(fisa.Id)) {
73:                         Nota(fisa.ContAmortizare, true, fisa.Cont, true, fisa.AmortizareFiscala, N.Carte.Fiscal);
74:                         Nota(fisa.ContCedare, false, fisa.Cont, true,
75:                             fisa.BrutFiscal - fisa.AmortizareFiscala, N.Carte.Fiscal);
76:                     }
77:                     break;
78:             }
79: 
80:             void Aloca(Guid cont, N.Latura latura, decimal suma, Guid? sursa) {
81:                 var ramas = suma;
82:                 foreach (var suport in operand.Suporturi.Where(s => s.Capat.Cont == cont && s.Latura == latura
83:                         && (sursa == null ? s.FaraLinieSursa : s.Linie == sursa)).OrderBy(s => s.Data).ThenBy(s => s.Referinta.Id)) {
84:                     var plafon = operand.DisponibilNominalizare.FirstOrDefault(d => d.Capat == suport.Capat);
85:                     var disponibil = latura == N.Latura.Debit ? plafon?.DebitNetMinim : plafon?.CreditNetMinim;
86:                     var cheie = (suport.Capat, latura);
87:                     var ia = Math.Min(ramas, Math.Min(suport.Disponibil - folosit.GetValueOrDefault(suport.Referinta),
88:                         (disponibil ?? 0m) - peDimensiuni.GetValueOrDefault(cheie)));
89:                     if (ia <= 0m) continue;
90:                     var nominalizat = suport.Capat with {
91:                         Unitate = new(fisa.Id, N.FelUnitate.Fisa, cont, null, null, fisa.Deschisa),
92:                     };
93:                     mutari.Add(new(suport.Capat, nominalizat, latura, 0m, 0m, ia, cauza) { Suport = suport.Referinta });
94:                     folosit[suport.Referinta] = folosit.GetValueOrDefault(suport.Referinta) + ia;
95:                     peDimensiuni[cheie] = peDimensiuni.GetValueOrDefault(cheie) + ia;
96:                     ramas -= ia;
97:                     if (ramas == 0m) break;
98:                 }
99:                 if (ramas > 0m)
100:                     refuzuri.Add(new(CoduriRefuz.SuportInsuficient,
101:                         $"Suport contabil nenominalizat insuficient pe contul {operand.Conturi.GetValueOrDefault(cont)?.Simbol ?? "neconfigurat"}: cerut {suma}, lipsă {ramas}.", linie.Id));
102:             }
103:         }
104:         return refuzuri.Count > 0 ? null : new(operand.Document.Id, operand.Document.DataInregistrare,
105:             miscari, mutari, [], [operand.PerioadaDeschisa, operand.VersiunePolitica]);
106:     }
107: }
Laturi.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using DevExpress.ExpressApp;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: /// <summary>Partea repartitorului față de patrimoniu, derivată din <see cref="FelRepartitor"/> (T-D13).</summary>
9: [Flags]
10: public enum Parte {
11:     Niciuna = 0,
12:     Extern = 1,
13:     Intern = 2,
14:     Propriu = 4,
15: }
16: 
17: /// <summary>
18: /// Contractul unei laturi: părțile permise, calitatea cerută și, doar unde structura o
19: /// cere (lotul trăiește într-o <see cref="BusinessObjects.Gestiune"/>), felul exact.
20: /// </summary>
21: public readonly record struct Latura(
22:         Parte Permisa,
23:         CalitateRepartitor Calitate = CalitateRepartitor.Niciuna,
24:         FelRepartitor? Fel = null) {
25:     public static readonly Latura Externa = new(Parte.Extern);
26:     public static readonly Latura Interna = new(Parte.Intern);
27:     public static readonly Latura Proprie = new(Parte.Propriu);
28:     public static readonly Latura Gestiune = new(Parte.Intern, Fel: FelRepartitor.Gestiune);
29:     public static readonly Latura InternaSauProprie = new(Parte.Intern | Parte.Propriu);
30:     public static readonly Latura ExternaSauProprie = new(Parte.Extern | Parte.Propriu);
31:     public static readonly Latura ExternaSauInterna = new(Parte.Extern | Parte.Intern);
32: 
33:     public Latura Cu(CalitateRepartitor calitate) => this with { Calitate = calitate };
34: 
35:     public bool Admite(RepartitorFapt repartitor) =>
36:         repartitor.Parte is Parte parte
37:         && (Permisa & parte) != 0
38:         && (Fel is null || repartitor.Fel == Fel)
39:         && (Calitate == CalitateRepartitor.Niciuna || repartitor.Calitati.HasFlag(Calitate));
40: }
41: 
42: /// <summary>Laturile permise ale unui tip de document: structură, nu politică (decizia 4).</summary>
43: public sealed record ContractLaturi(Latura Predator, Latura Primitor);
44: 
45: public static class Laturi {
46:     public static Parte? ParteA(FelRepartitor? fel) => fel switch {
47:         FelRepartitor.Partener or FelRepartitor.Angajat => Parte.Extern,
48:         FelRepartitor.Gestiune or FelRepartitor.UnitateInterna => Parte.Intern,
49:         FelRepartitor.ContPropriu => Parte.Propriu,
50:         _ => null,
51:     };
52: 
53:     /// <summary>Refuzurile contractului pe faptele laturilor: aceeași funcție pe ambele uși.</summary>
54:     public static void Verifica(ContractLaturi contract, RepartitorFapt predator, RepartitorFapt primitor,
55:             ICollection<N.Refuz> refuzuri) {
56:         ArgumentNullException.ThrowIfNull(contract);
57:         ArgumentNullException.ThrowIfNull(predator);
58:         ArgumentNullException.ThrowIfNull(primitor);
59:         ArgumentNullException.ThrowIfNull(refuzuri);
60:         if (!contract.Predator.Admite(predator))
61:             refuzuri.Add(new N.Refuz(CoduriRefuz.PredatorNepotrivit,
62:                 Mesaj("Predatorul", contract.Predator, predator), null));
63:         if (!contract.Primitor.Admite(primitor))
64:             refuzuri.Add(new N.Refuz(CoduriRefuz.PrimitorNepotrivit,
65:                 Mesaj("Primitorul", contract.Primitor, primitor), null));
66:     }
67: 
68:     /// <summary>Ușa entității (validarea de operare): faptele laturilor citite din bază, apoi aceeași verificare.</summary>
69:     public static IReadOnlyList<N.Refuz> Verifica(IObjectSpace os, Document doc) {
70:         ArgumentNullException.ThrowIfNull(doc);
71:         var refuzuri = new List<N.Refuz>();
72:         var (predator, primitor) = Motor.Fapte.Laturile(os, doc);
73:         Verifica(doc.Laturi(), predator, primitor, refuzuri);
74:         return refuzuri;
75:     }
76: 
77:     static string Mesaj(string latura, Latura ceruta, RepartitorFapt real) =>
78:         $"{latura} trebuie să fie {Descrie(ceruta)}; e {Descrie(real, ceruta.Calitate)}.";
79: 
80:     static string Descrie(Latura latura) {
81:         if (latura.Fel == FelRepartitor.Gestiune)
82:             return "o gestiune";
83:         if (latura.Fel is FelRepartitor fel)
84:             return $"un repartitor de felul {fel}";
85:         var parti = new List<string>(3);
86:         if (latura.Permisa.HasFlag(Parte.Propriu))
87:             parti.Add("un cont propriu (casă/bancă)");
88:         if (latura.Permisa.HasFlag(Parte.Intern))
89:             parti.Add("un repartitor intern (gestiune sau unitate internă)");
90:         if (latura.Permisa.HasFlag(Parte.Extern))
91:             parti.Add("un terț (partener sau angajat)");
92:         var text = string.Join(" sau ", parti);
93:         return latura.Calitate == CalitateRepartitor.Niciuna ? text : $"{text} cu calitatea {latura.Calitate}";
94:     }
95: 
96:     static string Descrie(RepartitorFapt real, CalitateRepartitor calitate) =>
97:         real.Fel is not FelRepartitor fel ? "lipsă"
98:         : calitate != CalitateRepartitor.Niciuna && !real.Calitati.HasFlag(calitate) ? $"{fel} fără calitatea {calitate}"
99:         : fel.ToString();
100: }

codex
Am găsit o eroare în fișă: trezoreria pune gestiunea pe ambele picioare doar la virament; la plata obișnuită, piciorul terțului rămâne fără gestiune. De asemenea, bonul de consum păstrează lotul pe ambele picioare. Aceste detalii schimbă exemplele și evaluarea cheilor de sold.

