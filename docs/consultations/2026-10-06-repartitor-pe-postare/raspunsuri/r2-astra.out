6:     decimal Cantitate,
7:     decimal ValoareValuta,
8:     decimal Valoare,
9:     Cauza Cauza) {
10: 
11:     public static (Postare Debit, Postare Credit) Postari(Miscare miscare, DateOnly data) => (
12:         new Postare(
13:             miscare.La.Pe(Latura.Debit, data),
14:             miscare.Cantitate,
15:             miscare.ValoareValuta,
16:             miscare.Valoare,
17:             miscare.Cauza),
18:         new Postare(
19:             miscare.DeLa.Pe(Latura.Credit, data),
20:             -miscare.Cantitate,
21:             miscare.ValoareValuta,
22:             miscare.Valoare,
23:             miscare.Cauza));
