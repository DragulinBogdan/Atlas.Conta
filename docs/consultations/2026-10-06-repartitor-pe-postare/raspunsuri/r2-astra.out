55:     }
56: 
57:     public override void ValideazaOperare(DevExpress.ExpressApp.IObjectSpace os, ICollection<string> erori) {
58:         base.ValideazaOperare(os, erori);
59:         // Clasificația bugetară per linie a migrat în PoliticaValidare (32d →
60:         // 3d): regulă de profil, aplicată de motor înaintea acestui hook.
61:         foreach (var d in Detalii)
62:             if (d.Valoare <= 0)
