216:                     && p.Tranzactie.Fel == N.FelTranzactie.Storno).ToList()) {
217:             postare.PerioadaDeclarare = atribuire.PerioadaD300;
218:             postare.PerioadaD394 = atribuire.Reper.PerioadaD394;
219:             postare.RegularizareD300 = atribuire.Reper.RegularizareD300;
220:             postare.InversaTehnica = true;
