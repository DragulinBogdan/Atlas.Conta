BusinessObjects/Nomenclatoare/PlanConturi.cs
1: using DevExpress.ExpressApp.DC;
2: using DevExpress.ExpressApp.Model;
3: using DevExpress.Persistent.Base;
4: 
5: namespace Atlas.Conta.BackOffice.Module.BusinessObjects;
6: 
7: // Decizia 10: plan doar sintetic; analiticele se derivă din dimensiuni la raportare.
8: [NavigationItem("Nomenclatoare")]
9: [XafDefaultProperty(nameof(Simbol))]
10: public class Cont : Nomenclator, ICuCautare, ICuProvenienta {
11:     // F23-D4 — proveniența rândului: o scrie SEED-ul (pe cel creat și pe cel
12:     // găsit pe cheia lui), o stinge GARDIANUL la orice scriere securizată.
13:     [XafDisplayName("Din seed")]
14:     [ModelDefault("AllowEdit", "False")]
15:     public virtual bool DinSeed { get; set; }
16: 
17:     public virtual string Simbol { get; set; }
18:     public virtual string Denumire { get; set; }
19:     public virtual Guid? ParinteId { get; set; }
20:     public virtual Cont Parinte { get; set; }
21:     // FCTCONT legacy (D/C/B) — funcția contului la validarea soldului.
22:     public virtual string Functie { get; set; }
23:     // SUMATOR legacy: însumare vs soldare pe părinți.
24:     public virtual bool Sumator { get; set; }
25:     // Decizia 15: dimensiuni obligatorii per cont (fostele flag-uri R/M/E/B/F/P).
26:     public virtual DimensiuneFlags DimensiuniObligatorii { get; set; }
27: 
28:     // Felia 16 (D16-D3): pe ce conturi stă un client și pe ce conturi un
29:     // furnizor — sursa listelor `Customers`/`Suppliers` din SAF-T și a perechii
30:     // `CustomerID`/`SupplierID` de pe fiecare rând de registru. POLITICĂ per
31:     // profil (seed), nu simbol în cod; bugetarul îl lasă `Niciunul` peste tot.
32:     [XafDisplayName("Rol de terț (SAF-T)")]
33:     public virtual RolTertCont RolTert { get; set; }
34: 
35:     [XafDisplayName("Urmărește partide")]
36:     public virtual bool UrmarestePartide { get; set; }
37: 
38:     /// <summary>Categoria stocului de pe lot în SAF-T S; gol = moștenită de la părinte (SAF-D3=C).</summary>
39:     [XafDisplayName("Categorie stoc (SAF-T)")]
40:     public virtual TipStoc? CategorieStoc { get; set; }
41: 
42:     // F20-D1 — coloana GENERATĂ de căutare fără diacritice; valoarea e a
43:     // BAZEI de date (vezi `Cautare` / `ICuCautare`), EF n-o scrie niciodată.
44:     [XafDisplayName("Căutare")]
45:     [VisibleInListView(false), VisibleInDetailView(false), VisibleInLookupListView(false)]
46:     public virtual string Cautare { get; set; }
47: }
