276:         var conturi = os.GetObjectsQuery<Cont>().ToList()
277:             .GroupBy(c => c.Simbol ?? "", StringComparer.Ordinal)
278:             .ToDictionary(g => g.Key, g => g.First(), StringComparer.Ordinal);
279:         reader.ReadLine(); // header
280:         string line;
281:         while ((line = reader.ReadLine()) != null) {
282:             if (string.IsNullOrWhiteSpace(line))
283:                 continue;
284:             var f = line.Split(',', 4);
285:             // CSV-ul e ordonat pe nivel (părinții înaintea copiilor).
286:             var parinte = f[1].Length > 0 ? conturi.GetValueOrDefault(f[1]) : null;
287:             var simbol = f[0];
288:             var cont = ContaSeeder.Aliniaza(os, simbol, conturi.GetValueOrDefault(simbol),
289:                 c => {
290:                     c.Simbol = simbol;
291:                     c.Denumire = f[3];
292:                     c.Functie = f[2];
293:                     c.ParinteId = parinte?.ID;
294:                 });
295:             if (cont == null)
296:                 continue;
297:             if (parinte is { DinSeed: true })
298:                 parinte.Sumator = true;
299:             conturi[simbol] = cont;
300:         }
301:     }
302: 
303:     // ROLUL DE TERȚ al conturilor (felia 16, D16-D3): pe ce conturi din OMFP
304:     // 1802 „stă" un client și pe ce conturi un furnizor. Sursa listelor
305:     // `Customers`/`Suppliers` din SAF-T și a perechii `CustomerID`/`SupplierID`
306:     // de pe rândul de registru — rolul e al CONTULUI, nu al laturii (partenerul
307:     // de pe DEBITUL unui 401, la plata datoriei, iese tot `SupplierID`).
308:     //
309:     // Potrivirea e pe PREFIX de simbol, ca să prindă și analiticele planului
310:     // (411 → 411, 4111, 4118; 409 → 409, 4091…4094) fără să le enumere: OMFP
311:     // adaugă grade la fiecare revizuire, iar o listă exhaustivă ar rămâne în urmă
312:     // tăcut. Grupele (40, 41, 46) NU intră: sunt sumatoare, iar soldurile de terți
313:     // se citesc pe conturile care chiar poartă partenerul.
314:     //
315:     // Idempotent și AUTORITAR — dar DOAR pe conturile PLANULUI (fixul F8 al
316:     // review-ului) și doar pe cele care poartă timbrul seed-ului (83a). Rolul se
317:     // REscrie la fiecare trecere, inclusiv la `Niciunul`
318:     // pe ce nu mai e în listele de mai jos: e o derivare de seed, ca 6xx=3xx, iar
319:     // o corectare a listei trebuie să ajungă pe bazele existente, nu doar pe cele
320:     // noi. EF nu emite UPDATE pentru o valoare identică.
321:     //
322:     // Autoritatea se OPREȘTE însă la granița resursei: `Cont` e nomenclator VIU
323:     // (planul se completează pe bază — analitice proprii, conturi de decontare
324:     // ale clientului), iar un cont adăugat de operator, cu `RolTert` pus cu mâna,
325:     // nu e „ceva ce seed-ul nu mai vrea", ci ceva ce seed-ul n-a văzut niciodată.
326:     // Trecerea anterioară îl ștergea la fiecare `--updateDatabase`, tăcut, iar
327:     // efectul se vedea abia în D406, ca partener dispărut din `Customers`.
328:     // Aceeași regulă ca la `Functie` din `SeedPlanConturi`: se rescrie ce e în
329:     // CSV, restul rămâne al bazei.
330:     internal static void SeedRolTert(IObjectSpace os) {
331:         // CLIENȚI — grupa 41 „Clienți și conturi asimilate", fără grupa însăși:
332:         //   411  Clienți (+ 4111 Clienți, 4118 Clienți incerți sau în litigiu)
333:         //   413  Efecte de primit de la clienți
334:         //   418  Clienți — facturi de întocmit
335:         //   419  Clienți — creditori (avansurile ÎNCASATE: tot ale clientului)
336:         string[] client = ["411", "413", "418", "419"];
337:         // FURNIZORI — grupa 40 „Furnizori și conturi asimilate", fără grupa însăși:
338:         //   401  Furnizori
339:         //   403  Efecte de plătit
340:         //   404  Furnizori de imobilizări
341:         //   405  Efecte de plătit pentru imobilizări
342:         //   408  Furnizori — facturi nesosite
343:         //   409  Furnizori — debitori (+ 4091…4094: avansurile ACORDATE)
344:         string[] furnizor = ["401", "403", "404", "405", "408", "409"];
345:         // DELIBERAT în afara listelor: 461 „Debitori diverși" și 462 „Creditori
346:         // diverși". Sunt conturi de DECONTĂRI cu oricine (angajați pe decont,
347:         // asociați, despăgubiri), nu de terți comerciali — un rol pe ele ar
348:         // împinge în `Customers`/`Suppliers` repartitori care nu sunt parteneri.
349:         // Contractul cere explicit ca angajatul de pe 461 să iasă în `Neincluse`
350:         // cu cauză; cu rol pe 461 n-ar mai fi ajuns acolo, ci în listă, greșit.
351:         // Restul grupei 46 (463, 466, 467) — la fel.
352: 
353:         var plan = SimboluriPlan();
354:         foreach (var cont in os.GetObjectsQuery<Cont>().ToList()) {
355:             var simbol = cont.Simbol ?? "";
356:             // Contul din afara CSV-ului sau editat pe ușa securizată e al BAZEI,
357:             // nu al seed-ului: nu se atinge (83a).
358:             if (!plan.Contains(simbol) || !cont.DinSeed)
359:                 continue;
360:             cont.RolTert =
361:                 client.Any(p => simbol.StartsWith(p, StringComparison.Ordinal)) ? RolTertCont.Client
362:                 : furnizor.Any(p => simbol.StartsWith(p, StringComparison.Ordinal)) ? RolTertCont.Furnizor
363:                 : RolTertCont.Niciunul;
364:             cont.UrmarestePartide = cont.RolTert != RolTertCont.Niciunul || simbol is "542" or "461";
365:         }
366:     }
DatabaseUpdate/ProfilBugetar.cs
230:     }
231: 
232:     // Planul sintetic complet din CPLAN (decizia 10; nomenclator, nu politică —
233:     // decizia 18). Defalcarea legacy (CPLAN_DEFALCARE) devine DimensiuniObligatorii.
234:     static void SeedPlanConturi(IObjectSpace os) {
235:         using var stream = Assembly.GetExecutingAssembly()
236:             .GetManifestResourceStream("Atlas.Conta.BackOffice.Module.DatabaseUpdate.SeedData.plan-conturi.csv")
237:             ?? throw new InvalidOperationException("Resursa plan-conturi.csv lipsește.");
238:         using var reader = new StreamReader(stream);
239: 
240:         var conturi = os.GetObjectsQuery<Cont>().ToList()
241:             .GroupBy(c => c.Simbol ?? "", StringComparer.Ordinal)
242:             .ToDictionary(g => g.Key, g => g.First(), StringComparer.Ordinal);
243:         reader.ReadLine(); // header
244:         string line;
245:         while ((line = reader.ReadLine()) != null) {
246:             if (string.IsNullOrWhiteSpace(line))
247:                 continue;
248:             var f = line.Split('|');
249:             // CSV-ul e ordonat pe nivel (părinții înaintea copiilor).
250:             var parinte = f[2].Length > 0 ? conturi.GetValueOrDefault(f[2]) : null;
251:             var simbol = f[0];
252:             var cont = ContaSeeder.Aliniaza(os, simbol, conturi.GetValueOrDefault(simbol),
253:                 c => {
254:                     c.Simbol = simbol;
255:                     c.Denumire = f[1];
256:                     c.Functie = f[3];
257:                     c.Sumator = f[4] == "1";
258:                     c.UrmarestePartide = c.RolTert != RolTertCont.Niciunul || simbol is "542.01.00" or "542.02.00"
259:                         or "408.00.00" or "461.01.09" or "428.01.02"
260:                         or "401.01.00" or "404.01.00" or "411.01.01";
261:                     c.DimensiuniObligatorii = ParseDefalcare(f[5]);
262:                     c.ParinteId = parinte?.ID;
263:                 });
264:             if (cont != null)
265:                 conturi[simbol] = cont;
266:         }
267:     }
268: 
269:     // Legenda CPLAN_DEFALCARE: R=Repartitor, M=Material, F=Funcțional, E=Economic,
270:     // B=Sursă de finanțare, P=Proiect; T (Titlu) = nivel al clasificației
271:     // economice → CodEconomic; S=Standard (fără defalcare).
272:     static DimensiuneFlags ParseDefalcare(string cod) {
273:         if (cod is "S" or "")
274:             return DimensiuneFlags.Niciuna;
275:         var flags = DimensiuneFlags.Niciuna;
276:         foreach (var c in cod) {
277:             flags |= c switch {
278:                 'R' => DimensiuneFlags.Repartitor,
279:                 'M' => DimensiuneFlags.Material,
280:                 'F' => DimensiuneFlags.CodFunctional,
281:                 'E' => DimensiuneFlags.CodEconomic,
282:                 'B' => DimensiuneFlags.SursaFinantare,
283:                 'P' => DimensiuneFlags.Proiect,
284:                 'T' => DimensiuneFlags.CodEconomic,
285:                 _ => throw new InvalidOperationException($"Cod de defalcare necunoscut: '{c}' în '{cod}'."),
286:             };
287:         }
288:         return flags;
289:     }
