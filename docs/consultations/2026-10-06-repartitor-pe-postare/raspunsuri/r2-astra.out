Declaratii/Partide.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using N = Atlas.Conta.Nucleu;
4: 
5: namespace Atlas.Conta.BackOffice.Module.Declaratii;
6: 
7: /// <summary>Partida documentului-sursă pe un cont, cu soldul ei citit.</summary>
8: readonly record struct PartidaSursa(N.Unitate Unitate, N.Sold Sold);
9: 
10: /// <summary>Deschiderea și nominalizarea partidelor pe conturile cu urmărire activă.</summary>
11: static class Partide {
12:     public static bool Urmareste(Operand operand, Guid cont) =>
13:         operand.Conturi.GetValueOrDefault(cont)?.UrmarestePartide == true;
14: 
15:     public static N.Unitate Proprie(Operand operand, Guid cont, Guid partener) =>
16:         N.Unitate.DeschidePartida(
17:             cont, partener, operand.Document.Id, operand.Document.DataInregistrare);
18: 
19:     /// <summary>
20:     /// Partida sursei pe contul cerut și soldul ei REAL: restul documentului-sursă
21:     /// e altceva decât ce ține partida lui pe un cont anume (MAJOR-1). Fără rând pe
22:     /// cont soldul e zero — citirea rămâne consemnată ca ipoteză.
23:     /// </summary>
24:     public static PartidaSursa? Sursa(Operand operand, Guid cont, Guid partener) {
25:         if (operand.Document is not { Autogenerat: true, DocumentSursaId: Guid sursaId })
26:             return null;
27:         var net = 0m;
28:         foreach (var (alContului, sold) in operand.PartideSursa)
29:             if (alContului == cont)
30:                 net = sold;
31:         return new PartidaSursa(
32:             Cub.IdentitatiPartide.Gaseste(operand.UnitatiSursa, sursaId, cont, partener)
33:             ?? N.Unitate.DeschidePartida(cont, partener, sursaId,
34:                 operand.DataInregistrareSursa ?? operand.Document.DataInregistrare),
35:             net >= 0m ? new N.Sold(net, 0m, 0m, 0m) : new N.Sold(0m, -net, 0m, 0m));
36:     }
37: 
38:     public static void Numeste(Operand operand, Guid cont, Guid partener, Guid linie,
39:             Dictionary<Guid, N.Unitate> partide, List<N.Decizie> decizii) {
40:         if (partide.ContainsKey(cont) || !Urmareste(operand, cont))
41:             return;
42:         var partida = Proprie(operand, cont, partener);
43:         partide.Add(cont, partida);
44:         decizii.Add(new N.PartidaDeschisa(linie, partida));
45:     }
46: 
47:     /// <summary>
48:     /// Partida se pune pe capătul care n-are deja unitate: pe un cont nominalizat
49:     /// altfel (lotul recepției) partida n-ar avea ce nominaliza.
50:     /// </summary>
51:     public static N.Capat CuPartida(
52:             N.Capat tert, Guid partener, IReadOnlyDictionary<Guid, N.Unitate> partide) {
53:         ArgumentNullException.ThrowIfNull(tert);
54:         return tert.Unitate is null && partide.TryGetValue(tert.Cont, out var partida)
55:             ? tert with { Partener = partener, Unitate = partida }
56:             : tert;
57:     }
58: }
Declaratii/Fiscal.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using Atlas.Conta.BackOffice.Module.Motor;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: /// <summary>
9: /// Faptul fiscal al unui document cu TVA, comun oricărui declarant: taxa liniei
10: /// postată ca atare (109b), taxa documentului × cotă pentru gardul toleranței,
11: /// atributele fiscale ale postării (B-D8 pct. 5) și mișcarea de taxă pe direcția politicii.
12: /// </summary>
13: static class Fiscal {
14:     /// <summary>
15:     /// Taxa nucleului per document × cotă, validată contra celei de pe linii CÂND politica
16:     /// declară o toleranță: Σ per cotă a taxei liniilor, cu toleranța per linie înmulțită
17:     /// cu liniile cotei (MEDIU-4). Fără toleranță (S-D15) taxa culeasă e autoritară fără
18:     /// gard. <c>null</c> = documentul n-are linie cu TVA.
19:     /// </summary>
20:     public static N.TaxaDocument? Taxa(Operand operand, IReadOnlyList<TipTvaFapt?> tipuri,
21:             N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
22:         ArgumentNullException.ThrowIfNull(operand);
23:         ArgumentNullException.ThrowIfNull(tipuri);
24:         ArgumentNullException.ThrowIfNull(refuzuri);
25:         var linii = new List<N.LinieTva>();
26:         var aleLor = new List<(LinieOperand Linie, (N.RegimTva Regim, decimal Cota) Cheie)>();
27:         var chei = new List<(N.RegimTva Regim, decimal Cota)>();
28:         for (var i = 0; i < operand.Linii.Count; i++) {
29:             if (tipuri[i] is not { } tip)
30:                 continue;
31:             var linie = operand.Linii[i];
32:             var cheie = Cheia(tip);
33:             linii.Add(new N.LinieTva(linie.Id, linie.Valoare, cheie.Regim, cheie.Cota));
34:             aleLor.Add((linie, cheie));
35:             if (!chei.Contains(cheie))
36:                 chei.Add(cheie);
37:         }
38:         if (linii.Count == 0)
39:             return null;
40:         var taxa = N.Tva.PeDocument(linii, (N.DirectieTva)(int)operand.PoliticaTva!.Directie, rotunjire);
41:         if (operand.TolerantaTaxa is not decimal toleranta)
42:             return taxa;
43:         foreach (var cheie in chei) {
44:             var aleCheii = aleLor.Where(a => a.Cheie == cheie).ToList();
45:             var refuz = N.Tva.ValideazaData(
46:                 aleCheii.Sum(a => a.Linie.ValoareTva),
47:                 taxa.PerCota[cheie],
48:                 toleranta * aleCheii.Count);
49:             if (refuz is not null)
50:                 refuzuri.Add(refuz);
51:         }
52:         return taxa;
53:     }
54: 
55:     /// <summary>
56:     /// B-D8 pct. 5: faptul fiscal e atribut al postării interne — codul, perioada
57:     /// declarării și partenerul pe care D394 îl cere pe faptă.
58:     /// </summary>
59:     public static N.Capat CuFapt(Operand operand, N.Capat capat, TipTvaFapt tip, N.RolTva rol) {
60:         ArgumentNullException.ThrowIfNull(operand);
61:         ArgumentNullException.ThrowIfNull(capat);
62:         return capat with {
63:             CodTva = new N.CodTva(tip.Id, Sensul(operand), rol) {
64:                 Regim = (N.RegimTva)(int)tip.Regim, Cota = tip.Cota, DeImport = tip.DeImport,
65:             },
66:             ReperFiscal = operand.ReperFiscal,
67:             PerioadaDeclarare = operand.PerioadaDeclarare,
68:             Partener = operand.PoliticaTva!.SursaContrapartida switch {
69:                 SursaCont.RepartitorPredator => operand.Document.Predator.Id,
70:                 SursaCont.RepartitorPrimitor => operand.Document.Primitor.Id,
71:                 _ => null,
72:             },
73:         };
74:     }
75: 
76:     /// <summary>
77:     /// Gestiunea internă a documentului: latura OPUSĂ contrapartidei politicii de TVA.
78:     /// </summary>
79:     public static Guid GestiuneaInterna(Operand operand) {
80:         ArgumentNullException.ThrowIfNull(operand);
81:         return operand.PoliticaTva?.SursaContrapartida == SursaCont.RepartitorPrimitor
82:             ? operand.Document.Predator.Id
83:             : operand.Document.Primitor.Id;
84:     }
85: 
86:     /// <summary>
87:     /// Mișcarea de taxă a liniei: contul de TVA al direcției contra contrapartidei
88:     /// politicii; la taxare inversă contrapartida e contul colectat (4426 = 4427).
89:     /// </summary>
90:     public static N.Miscare? Impozitul(Operand operand, LinieOperand linie, TipTvaFapt? tip,
91:             N.TaxaDocument? taxa, DirectieTva asteptata, ICollection<N.Refuz> refuzuri) {
92:         ArgumentNullException.ThrowIfNull(operand);
93:         ArgumentNullException.ThrowIfNull(linie);
94:         ArgumentNullException.ThrowIfNull(refuzuri);
95:         if (tip is not { } fiscal || taxa is null
96:                 || fiscal.Regim is not (RegimTva.Normal or RegimTva.TaxareInversa))
97:             return null;
98:         var politica = operand.PoliticaTva!;
99:         // F13-D1: autolichidarea e a BENEFICIARULUI; pe livrare taxarea inversă n-are taxă.
100:         if (fiscal.Regim == RegimTva.TaxareInversa && politica.Directie != DirectieTva.Deductibil)
101:             return null;
102:         if (politica.Directie != asteptata) {
103:             refuzuri.Add(new N.Refuz(CoduriRefuz.DirectieTvaNepotrivita,
104:                 $"Documentul cere TVA {asteptata}: politica de TVA a tipului o declară {politica.Directie}.",
105:                 linie.Id));
106:             return null;
107:         }
108:         var valoare = linie.ValoareTva;
109:         if (valoare == 0m)
110:             return null;
111:         var alDirectiei = asteptata == DirectieTva.Deductibil
112:             ? fiscal.ContTvaDeductibilId
113:             : fiscal.ContTvaColectatId;
114:         if (alDirectiei is not Guid contTva) {
115:             refuzuri.Add(new N.Refuz(CoduriRefuz.ContTvaLipsa,
116:                 $"Tipul de TVA {fiscal.Cod} n-are contul de TVA {asteptata}.", linie.Id));
117:             return null;
118:         }
119:         var analiza = Contari.Analiza(linie.Analiza, null, null);
120:         var intern = CuFapt(operand, new N.Capat {
121:             Cont = contTva,
122:             Gestiune = GestiuneaInterna(operand),
123:             Produs = linie.Lot?.ProdusId,
124:             Analiza = analiza,
125:         }, fiscal, N.RolTva.Taxa);
126:         Guid? alTertului = fiscal.Regim == RegimTva.TaxareInversa
127:             ? fiscal.ContTvaColectatId
128:             : Potrivire.Cont(politica.SursaContrapartida, politica.ContrapartidaFallbackId, null,
129:                 operand.Laturi).ContId;
130:         if (alTertului is not Guid cont) {
131:             refuzuri.Add(new N.Refuz(
132:                 fiscal.Regim == RegimTva.TaxareInversa ? CoduriRefuz.ContTvaLipsa : CoduriRefuz.RegulaContareLipsa,
133:                 "Contrapartida rândului de TVA nu se poate rezolva.", linie.Id));
134:             return null;
135:         }
136:         var contrapartida = new N.Capat { Cont = cont, Produs = linie.Lot?.ProdusId, Analiza = analiza };
137:         if (fiscal.Regim == RegimTva.TaxareInversa)
138:             contrapartida = CuFapt(operand, contrapartida, fiscal, N.RolTva.Autocolectare);
139:         // T-D4: pe `Colectat` taxa e CREDITUL (4427) contra contrapartidei debitoare (4111).
140:         var (deLa, la) = asteptata == DirectieTva.Colectat
141:             ? (intern, contrapartida)
142:             : (contrapartida, intern);
143:         return new N.Miscare(deLa, la, 0m, 0m, valoare, new N.Cauza(operand.Document.Id, linie.Id));
144:     }
145: 
146:     public static (N.RegimTva Regim, decimal Cota) Cheia(TipTvaFapt tip) =>
147:         ((N.RegimTva)(int)tip.Regim, tip.Cota);
148: 
149:     static N.SensTva Sensul(Operand operand) =>
150:         operand.PoliticaTva!.Directie == DirectieTva.Colectat ? N.SensTva.Livrare : N.SensTva.Achizitie;
151: }
Declaratii/DeclarantFacturaIntrare.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using Atlas.Conta.BackOffice.Module.Motor;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: /// <summary>
9: /// FCT (B-D6): linia de stoc e RECEPȚIA facturii (TR-D3) — lotul intră în
10: /// gestiunea primitoare de pe capătul virtual al furnizorului; celelalte naturi
11: /// postează netul pe regula lor. Taxa se decide per document × cotă și se
12: /// postează per linie, iar terțul are o singură partidă pe fiecare cont al lui.
13: /// </summary>
14: public sealed class DeclarantFacturaIntrare : IDeclarant {
15:     public static readonly DeclarantFacturaIntrare Instanta = new();
16: 
17:     DeclarantFacturaIntrare() { }
18: 
19:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
20:         ArgumentNullException.ThrowIfNull(operand);
21:         ArgumentNullException.ThrowIfNull(rotunjire);
22:         ArgumentNullException.ThrowIfNull(refuzuri);
23: 
24:         var doc = operand.Document;
25:         Antetul(doc, operand, refuzuri);
26: 
27:         var contari = new ContareLinie?[operand.Linii.Count];
28:         var tipuri = new TipTvaFapt?[operand.Linii.Count];
29:         for (var i = 0; i < operand.Linii.Count; i++)
30:             tipuri[i] = Linia(operand, operand.Linii[i], contari, i, refuzuri);
31: 
32:         var receptia = operand.Linii.Any(l => l.Natura == NaturaClasa.Stoc)
33:             ? Contrapartida(operand, refuzuri)
34:             : null;
35:         var taxa = Fiscal.Taxa(operand, tipuri, rotunjire, refuzuri);
36:         if (refuzuri.Count > 0)
37:             return null;
38: 
39:         var miscari = new List<N.Miscare>(operand.Linii.Count);
40:         var decizii = new List<N.Decizie>();
41:         var partide = new Dictionary<Guid, N.Unitate>();
42:         for (var i = 0; i < operand.Linii.Count; i++) {
43:             var linie = operand.Linii[i];
44:             var (intern, tert, cantitate) = linie.Natura == NaturaClasa.Stoc
45:                 ? Receptia(operand, linie, receptia!.Value, decizii)
46:                 : Netul(operand, linie, contari[i]!.Value, decizii);
47:             var aleLiniei = Netele(operand, linie, intern, tert, cantitate, tipuri[i], rotunjire).ToList();
48:             if (Fiscal.Impozitul(operand, linie, tipuri[i], taxa, DirectieTva.Deductibil, refuzuri) is { } impozit)
49:                 aleLiniei.Add(impozit);
50:             foreach (var miscare in aleLiniei) {
51:                 Partide.Numeste(operand, miscare.DeLa.Cont, doc.Predator.Id, linie.Id, partide, decizii);
52:                 Partide.Numeste(operand, miscare.La.Cont, doc.Predator.Id, linie.Id, partide, decizii);
53:             }
54:             miscari.AddRange(aleLiniei);
55:         }
56:         if (refuzuri.Count > 0)
57:             return null;
58:         return new N.Declaratie(
59:             doc.Id,
60:             doc.DataInregistrare,
61:             [.. miscari.Select(m => m with {
62:                 DeLa = Partide.CuPartida(m.DeLa, doc.Predator.Id, partide),
63:                 La = Partide.CuPartida(m.La, doc.Predator.Id, partide),
64:             })],
65:             decizii,
66:             [operand.PerioadaDeschisa, operand.VersiunePolitica]);
67:     }
68: 
69:     static void Antetul(DocumentFapt doc, Operand operand, ICollection<N.Refuz> refuzuri) {
70:         if (string.IsNullOrWhiteSpace(doc.Numar))
71:             refuzuri.Add(new N.Refuz(CoduriRefuz.NumarLipsa,
72:                 "Factura de intrare poartă numărul furnizorului.", null));
73:         if (operand.Linii.Count == 0)
74:             refuzuri.Add(new N.Refuz(CoduriRefuz.LiniiLipsa,
75:                 "Factura de intrare se cere cu cel puțin o linie.", null));
76:     }
77: 
78:     static TipTvaFapt? Linia(Operand operand, LinieOperand linie, ContareLinie?[] contari, int indice,
79:             ICollection<N.Refuz> refuzuri) {
80:         if (linie.Cantitate <= 0m)
81:             refuzuri.Add(new N.Refuz(CoduriRefuz.CantitateNepozitiva,
82:                 "Cantitatea fiecărei linii de factură trebuie să fie pozitivă.", linie.Id));
83:         var tipProdus = linie.TipProdusCulesId ?? linie.Lot?.TipMaterialId;
84:         if (tipProdus is Guid alProdusului && alProdusului != linie.TipMaterialId)
85:             refuzuri.Add(new N.Refuz(CoduriRefuz.ProdusAltTip,
86:                 "Produsul liniei aparține altui Tip decât Tipul liniei.", linie.Id));
87:         if (linie.Natura == NaturaClasa.Stoc) {
88:             if (linie.Lot is null)
89:                 refuzuri.Add(new N.Refuz(CoduriRefuz.LotLipsa,
90:                     "Liniile de stoc ale facturii își creează lotul la culegere.", linie.Id));
91:             else if (linie.ContImplicitTipId is null)
92:                 refuzuri.Add(new N.Refuz(CoduriRefuz.RegulaContareLipsa,
93:                     "Tipul liniei de stoc n-are cont implicit, deci recepția n-are cont.", linie.Id));
94:         }
95:         else
96:             contari[indice] = Contari.Rezolva(operand, linie, refuzuri);
97:         if (operand.PoliticaTva is null || linie.TipTvaId is not Guid tipTva)
98:             return null;
99:         if (!operand.TipuriTva.TryGetValue(tipTva, out var tip)) {
100:             refuzuri.Add(new N.Refuz(CoduriRefuz.TipTvaLipsa,
101:                 "Tipul de TVA al liniei nu mai există în nomenclator.", linie.Id));
102:             return null;
103:         }
104:         return tip;
105:     }
106: 
107:     // TR-D3: recepția e a facturii, dar regula ei de contare e a NIR-ului conex,
108:     // care nu e în operand; contrapartida e cea DECLARATĂ de politica de TVA a
109:     // tipului, iar regula naturii care postează pe factură rămâne rezerva (MINOR-5).
110:     static RezolvareCont? Contrapartida(Operand operand, ICollection<N.Refuz> refuzuri) {
111:         if (operand.PoliticaTva is { } politica) {
112:             var alPoliticii = Potrivire.Cont(
113:                 politica.SursaContrapartida, politica.ContrapartidaFallbackId, null, operand.Laturi);
114:             if (alPoliticii.ContId != null)
115:                 return alPoliticii;
116:         }
117:         foreach (var regula in operand.ReguliContare) {
118:             if (regula.NaturaFiltru is not (NaturaClasa.Serviciu or NaturaClasa.Cheltuiala))
119:                 continue;
120:             var alRegulii = Potrivire.Cont(regula.SursaContCredit, regula.ContCreditId, null, operand.Laturi);
121:             if (alRegulii.ContId != null)
122:                 return alRegulii;
123:         }
124:         refuzuri.Add(new N.Refuz(CoduriRefuz.RegulaContareLipsa,
125:             "Recepția n-are cont de furnizor: nicio politică de TVA și nicio regulă de contare pe "
126:             + "Serviciu/Cheltuiala nu-l dau.", null));
127:         return null;
128:     }
129: 
130:     static (N.Capat Intern, N.Capat Tert, decimal Cantitate) Receptia(
131:             Operand operand, LinieOperand linie, RezolvareCont contrapartida, List<N.Decizie> decizii) {
132:         var lot = linie.Lot!;
133:         var contStoc = linie.ContImplicitTipId!.Value;
134:         var contTert = contrapartida.ContId!.Value;
135:         // Recepția n-are regulă proprie: rămâne coalesce-ul liniei, ca pe NIR.
136:         var analiza = Contari.Analiza(linie.Analiza, null, null);
137:         decizii.Add(new N.ContRezolvat(linie.Id, contStoc, SursaRezolvata.TipMaterial.ToString()));
138:         decizii.Add(new N.ContRezolvat(linie.Id, contTert, contrapartida.Sursa.ToString()));
139:         return (
140:             new N.Capat {
141:                 Cont = contStoc,
142:                 Gestiune = operand.Document.Primitor.Id,
143:                 Produs = lot.ProdusId,
144:                 Unitate = new N.Unitate(lot.Id, N.FelUnitate.Lot, contStoc, null, lot.ProdusId, lot.Data),
145:                 Analiza = analiza,
146:             },
147:             new N.Capat {
148:                 Cont = contTert,
149:                 // N-D4: cantitatea vine din afara evidenței, pe gestiunea structurală.
150:                 Gestiune = N.GestiuniVirtuale.Furnizor,
151:                 Produs = lot.ProdusId,
152:                 Analiza = analiza,
153:             },
154:             linie.Cantitate);
155:     }
156: 
157:     static (N.Capat Intern, N.Capat Tert, decimal Cantitate) Netul(
158:             Operand operand, LinieOperand linie, ContareLinie contare, List<N.Decizie> decizii) {
159:         decizii.Add(new N.ContRezolvat(linie.Id, contare.ContDebit, contare.SursaDebit.ToString()));
160:         decizii.Add(new N.ContRezolvat(linie.Id, contare.ContCredit, contare.SursaCredit.ToString()));
161:         return (
162:             new N.Capat {
163:                 Cont = contare.ContDebit,
164:                 Gestiune = operand.Document.Primitor.Id,
165:                 Produs = linie.Lot?.ProdusId,
166:                 Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideDebit, contare.Regula.Comun),
167:             },
168:             new N.Capat {
169:                 Cont = contare.ContCredit,
170:                 Produs = linie.Lot?.ProdusId,
171:                 Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideCredit, contare.Regula.Comun),
172:             },
173:             0m);
174:     }
175: 
176:     // Capitalizatul e BRUT pe linie, dar jurnalul îl desface în bază + taxă
177:     // (`RegistruTvaService.Cifre`), iar jurnalul e proiecția pe `CodTva` (090a):
178:     // netul devine DOUĂ mișcări pe același cont de cost, cu Σ neschimbată.
179:     static IEnumerable<N.Miscare> Netele(Operand operand, LinieOperand linie, N.Capat intern, N.Capat tert,
180:             decimal cantitate, TipTvaFapt? tip, N.Rotunjire rotunjire) {
181:         var cauza = new N.Cauza(operand.Document.Id, linie.Id);
182:         var fiscal = tip is { } t ? Fiscal.CuFapt(operand, intern, t, N.RolTva.Baza) : intern;
183:         if (tip is not { Regim: RegimTva.Capitalizat } capitalizat) {
184:             yield return new N.Miscare(tert, fiscal, cantitate, 0m, linie.Valoare, cauza);
185:             yield break;
186:         }
187:         var baza = rotunjire.Bani(linie.Valoare / (1m + (capitalizat.Cota / 100m)));
188:         var taxa = linie.Valoare - baza;
189:         yield return new N.Miscare(tert, fiscal, cantitate, 0m, baza, cauza);
190:         if (taxa != 0m)
191:             yield return new N.Miscare(
192:                 tert, Fiscal.CuFapt(operand, intern, capitalizat, N.RolTva.Taxa), 0m, 0m, taxa, cauza);
193:     }
194: }
Declaratii/DeclarantFacturaIesire.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using Atlas.Conta.BackOffice.Module.Motor;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: /// <summary>
9: /// FCL (T-D4): venitul per linie pe regula de vânzare a Tipului, creanța pe contul
10: /// de terț al debitului și taxa COLECTATĂ per linie; zero postări de stoc —
11: /// descărcarea de gestiune e document propriu (DSC).
12: /// </summary>
13: public sealed class DeclarantFacturaIesire : IDeclarant {
14:     public static readonly DeclarantFacturaIesire Instanta = new();
15: 
16:     DeclarantFacturaIesire() { }
17: 
18:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
19:         ArgumentNullException.ThrowIfNull(operand);
20:         ArgumentNullException.ThrowIfNull(rotunjire);
21:         ArgumentNullException.ThrowIfNull(refuzuri);
22: 
23:         var doc = operand.Document;
24:         Antetul(doc, operand, refuzuri);
25: 
26:         var contari = new ContareLinie?[operand.Linii.Count];
27:         var tipuri = new TipTvaFapt?[operand.Linii.Count];
28:         for (var i = 0; i < operand.Linii.Count; i++)
29:             tipuri[i] = Linia(operand, operand.Linii[i], contari, i, refuzuri);
30: 
31:         var taxa = Fiscal.Taxa(operand, tipuri, rotunjire, refuzuri);
32:         if (refuzuri.Count > 0)
33:             return null;
34: 
35:         var miscari = new List<N.Miscare>(operand.Linii.Count);
36:         var decizii = new List<N.Decizie>();
37:         var partide = new Dictionary<Guid, N.Unitate>();
38:         for (var i = 0; i < operand.Linii.Count; i++) {
39:             var linie = operand.Linii[i];
40:             var aleLiniei = new List<N.Miscare> { Venitul(operand, linie, contari[i]!.Value, tipuri[i], decizii) };
41:             if (Fiscal.Impozitul(operand, linie, tipuri[i], taxa, DirectieTva.Colectat, refuzuri) is { } impozit)
42:                 aleLiniei.Add(impozit);
43:             foreach (var miscare in aleLiniei) {
44:                 Partide.Numeste(operand, miscare.DeLa.Cont, doc.Primitor.Id, linie.Id, partide, decizii);
45:                 Partide.Numeste(operand, miscare.La.Cont, doc.Primitor.Id, linie.Id, partide, decizii);
46:             }
47:             miscari.AddRange(aleLiniei);
48:         }
49:         if (refuzuri.Count > 0)
50:             return null;
51:         return new N.Declaratie(
52:             doc.Id,
53:             doc.DataInregistrare,
54:             [.. miscari.Select(m => m with {
55:                 DeLa = Partide.CuPartida(m.DeLa, doc.Primitor.Id, partide),
56:                 La = Partide.CuPartida(m.La, doc.Primitor.Id, partide),
57:             })],
58:             decizii,
59:             [operand.PerioadaDeschisa, operand.VersiunePolitica]);
60:     }
61: 
62:     static void Antetul(DocumentFapt doc, Operand operand, ICollection<N.Refuz> refuzuri) {
63:         if (operand.Linii.Count == 0)
64:             refuzuri.Add(new N.Refuz(CoduriRefuz.LiniiLipsa,
65:                 "Factura de ieșire se cere cu cel puțin o linie.", null));
66:     }
67: 
68:     // T-D4: FCL n-are recepție și n-are stoc — linia de natură `Stoc` e linie de VENIT
69:     // prin regula de vânzare a Tipului, deci nu cere nici lot, nici produs.
70:     static TipTvaFapt? Linia(Operand operand, LinieOperand linie, ContareLinie?[] contari, int indice,
71:             ICollection<N.Refuz> refuzuri) {
72:         if (linie.Cantitate <= 0m)
73:             refuzuri.Add(new N.Refuz(CoduriRefuz.CantitateNepozitiva,
74:                 "Cantitatea fiecărei linii de factură trebuie să fie pozitivă.", linie.Id));
75:         var tipProdus = linie.TipProdusCulesId ?? linie.Lot?.TipMaterialId;
76:         if (tipProdus is Guid alProdusului && alProdusului != linie.TipMaterialId)
77:             refuzuri.Add(new N.Refuz(CoduriRefuz.ProdusAltTip,
78:                 "Produsul liniei aparține altui Tip decât Tipul liniei.", linie.Id));
79:         contari[indice] = Contari.Rezolva(operand, linie, refuzuri);
80:         if (operand.PoliticaTva is null || linie.TipTvaId is not Guid tipTva)
81:             return null;
82:         if (!operand.TipuriTva.TryGetValue(tipTva, out var tip)) {
83:             refuzuri.Add(new N.Refuz(CoduriRefuz.TipTvaLipsa,
84:                 "Tipul de TVA al liniei nu mai există în nomenclator.", linie.Id));
85:             return null;
86:         }
87:         return tip;
88:     }
89: 
90:     static N.Miscare Venitul(Operand operand, LinieOperand linie, ContareLinie contare, TipTvaFapt? tip,
91:             List<N.Decizie> decizii) {
92:         var doc = operand.Document;
93:         decizii.Add(new N.ContRezolvat(linie.Id, contare.ContDebit, contare.SursaDebit.ToString()));
94:         decizii.Add(new N.ContRezolvat(linie.Id, contare.ContCredit, contare.SursaCredit.ToString()));
95:         var intern = new N.Capat {
96:             Cont = contare.ContCredit,
97:             Gestiune = doc.Predator.Id,
98:             Produs = linie.Lot?.ProdusId,
99:             Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideCredit, contare.Regula.Comun),
100:         };
101:         var tert = new N.Capat {
102:             Cont = contare.ContDebit,
103:             Produs = linie.Lot?.ProdusId,
104:             Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideDebit, contare.Regula.Comun),
105:         };
106:         return new N.Miscare(
107:             tip is { } fiscal ? Fiscal.CuFapt(operand, intern, fiscal, N.RolTva.Baza) : intern,
108:             tert,
109:             0m,
110:             0m,
111:             linie.Valoare,
112:             new N.Cauza(doc.Id, linie.Id));
113:     }
114: }

