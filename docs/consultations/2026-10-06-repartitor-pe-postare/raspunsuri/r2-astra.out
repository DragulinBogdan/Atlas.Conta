32: public static class Contabil {
33:     static IQueryable<Postare> Domeniu(IObjectSpace os) => os.GetObjectsQuery<Postare>()
34:         .Where(p => p.Carte == N.Carte.Contabil).Where(Transformare.FaraContrapondere);
35: 
36:     public static IQueryable<Postare> Postari(IObjectSpace os) {
37:         var toate = os.GetObjectsQuery<Postare>();
38:         return from p in Domeniu(os)
39:                join original in toate on new { Id = p.InversaDinId, Spatiu = p.InversaDinSpatiu }
40:                    equals new { Id = (Guid?)original.ID, Spatiu = (N.Spatiu?)original.Spatiu } into originale
41:                from original in originale.DefaultIfEmpty()
42:                where p.Tranzactie.Fel == N.FelTranzactie.Operare || p.Tranzactie.Fel == N.FelTranzactie.Deschidere
43:                    || p.Tranzactie.Fel == N.FelTranzactie.Storno && original != null
44:                        && (original.Tranzactie.Fel == N.FelTranzactie.Operare || original.Tranzactie.Fel == N.FelTranzactie.Deschidere)
45:                select p;
46:     }
47: 
48:     public static IQueryable<PostareJurnal> Jurnal(IObjectSpace os, DateOnly deLa, DateOnly panaLa) =>
49:         Postari(os).Where(p => p.Data >= deLa && p.Data <= panaLa).Select(p => new PostareJurnal {
50:             Id = p.ID, Spatiu = p.Spatiu, TranzactieId = p.TranzactieId, Fel = p.Tranzactie.Fel,
51:             DataTranzactie = p.Tranzactie.Data, ScrisLa = p.Tranzactie.ScrisLa,
52:             DocumentId = p.DocumentId, LinieId = p.LinieId, Data = p.Data, Cont = p.Cont,
53:             Latura = p.Latura, Valoare = p.Valoare, Partener = p.Partener,
54:             TipTvaId = p.TipTvaId, RolTva = p.RolTva, SensTva = p.SensTva,
55:             CodFunctional = p.CodFunctional, CodEconomic = p.CodEconomic, SursaFinantare = p.SursaFinantare,
56:             UnitateOrganizatorica = p.UnitateOrganizatorica, Proiect = p.Proiect, CentruCost = p.CentruCost,
57:         });
58: }
