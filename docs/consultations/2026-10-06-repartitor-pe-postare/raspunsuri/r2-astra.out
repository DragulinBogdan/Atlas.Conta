DeclarantTrezorerie.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using Atlas.Conta.BackOffice.Module.Motor;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: /// <summary>
9: /// PLT și INC (B-D5): o mișcare per linie de defalcare — banii trec de pe contul
10: /// unei laturi pe al celeilalte, iar partida terțului se nominalizează pe
11: /// documentul-sursă cât ține restul lui, apoi pe a documentului însuși. Plata și
12: /// încasarea diferă prin regula de contare și prin latura care poartă terțul, nu
13: /// prin cod.
14: /// </summary>
15: public sealed class DeclarantTrezorerie : IDeclarant {
16:     public static readonly DeclarantTrezorerie Instanta = new();
17: 
18:     DeclarantTrezorerie() { }
19: 
20:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
21:         ArgumentNullException.ThrowIfNull(operand);
22:         ArgumentNullException.ThrowIfNull(rotunjire);
23:         ArgumentNullException.ThrowIfNull(refuzuri);
24: 
25:         var doc = operand.Document;
26:         var esteVirament = doc.Predator.Parte == Parte.Propriu && doc.Primitor.Parte == Parte.Propriu;
27:         if (doc.Predator.Id == doc.Primitor.Id)
28:             refuzuri.Add(new N.Refuz(CoduriRefuz.LaturiIdentice,
29:                 "Predatorul și primitorul sunt același repartitor.", null));
30:         Liniile(operand, esteVirament, refuzuri);
31: 
32:         var contari = new ContareLinie?[operand.Linii.Count];
33:         for (var i = 0; i < operand.Linii.Count; i++)
34:             contari[i] = Contari.Rezolva(operand, operand.Linii[i], refuzuri);
35:         if (refuzuri.Count > 0)
36:             return null;
37: 
38:         var tert = doc.Predator.Parte == Parte.Extern ? doc.Predator.Id
39:             : doc.Primitor.Parte == Parte.Extern ? doc.Primitor.Id
40:             : (Guid?)null;
41:         var miscari = new List<N.Miscare>(operand.Linii.Count);
42:         var decizii = new List<N.Decizie>();
43:         var ipoteze = new List<N.Ipoteza>();
44:         var rest = operand.RestPartidaSursa ?? 0m;
45:         var citite = new List<Guid>();
46:         var alePartidelorSursei = new Dictionary<Guid, decimal>();
47:         var proprieDeclarata = false;
48: 
49:         for (var i = 0; i < operand.Linii.Count; i++) {
50:             var linie = operand.Linii[i];
51:             var contare = contari[i]!.Value;
52:             decizii.Add(new N.ContRezolvat(linie.Id, contare.ContDebit, contare.SursaDebit.ToString()));
53:             decizii.Add(new N.ContRezolvat(linie.Id, contare.ContCredit, contare.SursaCredit.ToString()));
54: 
55:             var (gestiuneDebit, gestiuneCredit) = Gestiuni(doc, contare.Regula, esteVirament);
56:             var debit = new N.Capat {
57:                 Cont = contare.ContDebit,
58:                 Gestiune = gestiuneDebit,
59:                 Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideDebit, contare.Regula.Comun),
60:             };
61:             var credit = new N.Capat {
62:                 Cont = contare.ContCredit,
63:                 Gestiune = gestiuneCredit,
64:                 Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideCredit, contare.Regula.Comun),
65:             };
66: 
67:             var peDebit = tert is not null && Partide.Urmareste(operand, contare.ContDebit);
68:             var contTert = peDebit ? contare.ContDebit
69:                 : tert is not null && Partide.Urmareste(operand, contare.ContCredit) ? contare.ContCredit
70:                 : (Guid?)null;
71:             if (contTert is not Guid cont || tert is not Guid partener) {
72:                 miscari.Add(new N.Miscare(credit, debit, 0m, 0m, linie.Valoare, new N.Cauza(doc.Id, linie.Id)));
73:                 continue;
74:             }
75: 
76:             var proprie = Partide.Proprie(operand, cont, partener);
77:             var bucati = new List<(N.Unitate Partida, decimal Suma)>(2);
78:             // TR-D2a: stingerea E postarea care numește partida stinsă; restul liniei
79:             // rămâne avans pe partida proprie, ca azi excedentul. Plafonul e ce ține
80:             // partida sursei pe ACEST cont, nu restul documentului-sursă (MAJOR-1).
81:             if (Partide.Sursa(operand, cont, partener) is { } sursa) {
82:                 if (!citite.Contains(cont)) {
83:                     ipoteze.Add(new N.SoldUnitateCitit(sursa.Unitate, sursa.Sold));
84:                     citite.Add(cont);
85:                 }
86:                 if (!alePartidelorSursei.TryGetValue(cont, out var alPartidei))
87:                     alePartidelorSursei[cont] = alPartidei = (peDebit ? sursa.Sold.Net < 0m : sursa.Sold.Net > 0m)
88:                         ? Math.Min(Math.Abs(sursa.Sold.Net), operand.DisponibilPartideSursa.GetValueOrDefault(cont, Math.Abs(sursa.Sold.Net)))
89:                         : 0m;
90:                 var plafon = Math.Min(rest, alPartidei);
91:                 if (plafon > 0m)
92:                     try {
93:                         var nominalizare = N.Fifo.Nominalizeaza(
94:                             linie.Valoare, [new N.Disponibil(sursa.Unitate, plafon)]);
95:                         foreach (var alocare in nominalizare.Alocari) {
96:                             bucati.Add((alocare.Unitate, alocare.Masura));
97:                             decizii.Add(new N.AlocareFifo(linie.Id, alocare.Unitate, alocare.Masura));
98:                             rest -= alocare.Masura;
99:                             alePartidelorSursei[cont] -= alocare.Masura;
100:                         }
101:                         if (nominalizare.Ramas > 0m)
102:                             bucati.Add((proprie, nominalizare.Ramas));
103:                     }
104:                     catch (N.RefuzException e) {
105:                         // Refuzul e al liniei, nu al documentului: iterarea continuă
106:                         // ca să iasă TOATE refuzurile, nu primul (B-D2, MINOR-1).
107:                         refuzuri.Add(new N.Refuz(e.Refuz.Cod, e.Refuz.Mesaj, linie.Id));
108:                         continue;
109:                     }
110:             }
111:             if (bucati.Count == 0)
112:                 bucati.Add((proprie, linie.Valoare));
113: 
114:             if (!proprieDeclarata && bucati.Any(b => b.Partida.Id == proprie.Id)) {
115:                 decizii.Add(new N.PartidaDeschisa(linie.Id, proprie));
116:                 proprieDeclarata = true;
117:             }
118:             foreach (var (partida, suma) in bucati)
119:                 miscari.Add(new N.Miscare(
120:                     peDebit ? credit : credit with { Partener = partener, Unitate = partida },
121:                     peDebit ? debit with { Partener = partener, Unitate = partida } : debit,
122:                     0m,
123:                     0m,
124:                     suma,
125:                     new N.Cauza(doc.Id, linie.Id)));
126:         }
127:         if (refuzuri.Count > 0)
128:             return null;
129:         ipoteze.Add(operand.PerioadaDeschisa);
130:         ipoteze.Add(operand.VersiunePolitica);
131:         return new N.Declaratie(doc.Id, doc.DataInregistrare, miscari, decizii, ipoteze);
132:     }
133: 
134:     static void Liniile(Operand operand, bool esteVirament, ICollection<N.Refuz> refuzuri) {
135:         if (operand.Linii.Count == 0) {
136:             refuzuri.Add(new N.Refuz(CoduriRefuz.LiniiLipsa,
137:                 "Documentul de trezorerie se cere cu cel puțin o linie de defalcare.", null));
138:             return;
139:         }
140:         var deVirament = 0;
141:         foreach (var linie in operand.Linii) {
142:             if (linie.Valoare <= 0m)
143:                 refuzuri.Add(new N.Refuz(CoduriRefuz.ValoareNepozitiva,
144:                     "Fiecare linie poartă o valoare pozitivă (defalcarea sumei).", linie.Id));
145:             if (linie.Natura == NaturaClasa.Virament)
146:                 deVirament++;
147:         }
148:         if (esteVirament ? deVirament != operand.Linii.Count : deVirament > 0)
149:             refuzuri.Add(new N.Refuz(CoduriRefuz.ViramentMixt,
150:                 "Cuplajul laturi ↔ natură: viramentul intern cere ambele laturi conturi proprii ȘI toate "
151:                 + "liniile de natură Virament.", null));
152:     }
153: 
154:     // B-D8 pct. 9: gestiunea stă pe piciorul PROPRIU — cel al cărui cont îl ia
155:     // regula de la repartitorul intern; piciorul de terț rămâne fără ea. La
156:     // virament ambele picioare sunt ale aceluiași cont propriu, iar regula îl
157:     // numește prin latura care nu e contul de tranzit (`GetContPropriuId` de azi).
158:     static (Guid? Debit, Guid? Credit) Gestiuni(DocumentFapt doc, RegulaContareFapt regula, bool esteVirament) {
159:         var peDebit = Numit(doc, regula.SursaContDebit);
160:         var peCredit = Numit(doc, regula.SursaContCredit);
161:         if (esteVirament) {
162:             var propriu = peDebit is null ? peCredit : peCredit is null ? peDebit : null;
163:             return (propriu, propriu);
164:         }
165:         var intern = doc.Predator.Parte == Parte.Propriu ? doc.Predator.Id
166:             : doc.Primitor.Parte == Parte.Propriu ? doc.Primitor.Id
167:             : (Guid?)null;
168:         return intern is null ? (null, null)
169:             : peDebit == intern ? (intern, null)
170:             : peCredit == intern ? (null, intern)
171:             : (null, null);
172:     }
173: 
174:     static Guid? Numit(DocumentFapt doc, SursaCont sursa) => sursa switch {
175:         SursaCont.RepartitorPredator => doc.Predator.Id,
176:         SursaCont.RepartitorPrimitor => doc.Primitor.Id,
177:         _ => null,
178:     };
179: }
DeclarantDecont.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using Atlas.Conta.BackOffice.Module.Motor;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: public sealed class DeclarantDecont : IDeclarant {
9:     public static readonly DeclarantDecont Instanta = new();
10:     DeclarantDecont() { }
11: 
12:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
13:         var miscari = new List<N.Miscare>();
14:         var decizii = new List<N.Decizie>();
15:         var partide = new Dictionary<(Guid, Guid), N.Unitate>();
16:         var tipuri = new TipTvaFapt?[operand.Linii.Count];
17:         if (operand.Linii.Count == 0)
18:             refuzuri.Add(new(CoduriRefuz.LiniiLipsa, "Decontul cere cel puțin o linie.", null));
19:         for (var i = 0; i < operand.Linii.Count; i++) {
20:             var l = operand.Linii[i];
21:             if (l.Valoare <= 0)
22:                 refuzuri.Add(new(CoduriRefuz.ValoareNepozitiva, "Cheltuiala justificată trebuie să fie pozitivă.", l.Id));
23:             if (operand.PoliticaTva != null && l.TipTvaId is Guid id) {
24:                 if (!operand.TipuriTva.TryGetValue(id, out var tip))
25:                     refuzuri.Add(new(CoduriRefuz.TipTvaLipsa, "Tipul TVA nu există.", l.Id));
26:                 else tipuri[i] = tip;
27:             }
28:         }
29:         var taxa = Fiscal.Taxa(operand, tipuri, rotunjire, refuzuri);
30:         if (refuzuri.Count > 0) return null;
31:         for (var i = 0; i < operand.Linii.Count; i++) {
32:             var l = operand.Linii[i];
33:             var regula = Potrivire.Contare(operand.ReguliContare, l.Fapt).Castigator;
34:             if (regula is null) {
35:                 refuzuri.Add(new(CoduriRefuz.RegulaContareLipsa, "Linia de decont cere regulă de contare.", l.Id));
36:                 continue;
37:             }
38:             var debit = l.ContDebitId ?? Potrivire.Cont(regula.Value.SursaContDebit,
39:                 regula.Value.ContDebitId, l.ContImplicitTipId, operand.Laturi).ContId;
40:             var credit = l.ContCreditId ?? Potrivire.Cont(regula.Value.SursaContCredit,
41:                 regula.Value.ContCreditId, l.ContImplicitTipId, operand.Laturi).ContId;
42:             if (debit is not Guid d || credit is not Guid c || !operand.Conturi.ContainsKey(d) || !operand.Conturi.ContainsKey(c)) {
43:                 refuzuri.Add(new(CoduriRefuz.ContExplicitLipsa, "Conturile liniei nu pot fi rezolvate.", l.Id));
44:                 continue;
45:             }
46:             var rd = l.RepartitorDebitId ?? regula.Value.OverrideDebit?.RepartitorId
47:                 ?? regula.Value.Comun?.RepartitorId ?? operand.Document.Predator.Id;
48:             var rc = l.RepartitorCreditId ?? regula.Value.OverrideCredit?.RepartitorId
49:                 ?? regula.Value.Comun?.RepartitorId ?? operand.Document.Predator.Id;
50:             var capD = Capat(d, rd, Contari.Analiza(l.Analiza, regula.Value.OverrideDebit, regula.Value.Comun), l.Id);
51:             var capC = Capat(c, rc, Contari.Analiza(l.Analiza, regula.Value.OverrideCredit, regula.Value.Comun), l.Id);
52:             var baza = tipuri[i] is { } tipBaza ? Fiscal.CuFapt(operand, capD, tipBaza, N.RolTva.Baza) : capD;
53:             var cauza = new N.Cauza(operand.Document.Id, l.Id);
54:             if (tipuri[i] is { Regim: RegimTva.Capitalizat } cap) {
55:                 var net = rotunjire.Bani(l.Valoare / (1m + cap.Cota / 100m));
56:                 miscari.Add(new(capC, baza, 0, 0, net, cauza));
57:                 if (l.Valoare != net) miscari.Add(new(capC, Fiscal.CuFapt(operand, capD, cap, N.RolTva.Taxa),
58:                     0, 0, l.Valoare - net, cauza));
59:             }
60:             else miscari.Add(new(capC, baza, 0, 0, l.Valoare, cauza));
61:             if (Fiscal.Impozitul(operand, l, tipuri[i], taxa, DirectieTva.Deductibil, refuzuri) is { } impozit)
62:                 miscari.Add(impozit with { DeLa = Capat(impozit.DeLa.Cont, operand.Document.Predator.Id,
63:                     impozit.DeLa.Analiza, l.Id) with {
64:                         CodTva = impozit.DeLa.CodTva, ReperFiscal = impozit.DeLa.ReperFiscal,
65:                         PerioadaDeclarare = impozit.DeLa.PerioadaDeclarare,
66:                     } });
67:         }
68:         return refuzuri.Count > 0 ? null : new(operand.Document.Id, operand.Document.DataInregistrare,
69:             miscari, decizii, [operand.PerioadaDeschisa, operand.VersiunePolitica]);
70: 
71:         N.Capat Capat(Guid cont, Guid repartitor, N.Analiza analiza, Guid linie) {
72:             decizii.Add(new N.ContRezolvat(linie, cont, "decont"));
73:             if (!operand.Repartitori.TryGetValue(repartitor, out var r) || r.Parte == null) {
74:                 refuzuri.Add(new(CoduriRefuz.RepartitorExplicitLipsa, "Repartitorul liniei nu poate fi rezolvat.", linie));
75:                 return new() { Cont = cont, Analiza = analiza };
76:             }
77:             N.Unitate? unitate = null;
78:             if (r.Parte == Parte.Extern && Partide.Urmareste(operand, cont)) {
79:                 if (!partide.TryGetValue((cont, repartitor), out unitate)) {
80:                     unitate = Partide.Proprie(operand, cont, repartitor);
81:                     partide.Add((cont, repartitor), unitate);
82:                     decizii.Add(new N.PartidaDeschisa(linie, unitate));
83:                 }
84:             }
85:             return new() { Cont = cont, Analiza = analiza, Unitate = unitate,
86:                 Partener = r.Parte == Parte.Extern ? r.Id : null,
87:                 Gestiune = r.Parte is Parte.Intern or Parte.Propriu ? r.Id : null };
88:         }
89:     }
90: }
DeclarantNotaContabila.cs
1: #nullable enable
2: using N = Atlas.Conta.Nucleu;
3: 
4: namespace Atlas.Conta.BackOffice.Module.Declaratii;
5: 
6: public sealed class DeclarantNotaContabila : IDeclarant {
7:     public static readonly DeclarantNotaContabila Instanta = new();
8:     DeclarantNotaContabila() { }
9: 
10:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
11:         ArgumentNullException.ThrowIfNull(operand);
12:         ArgumentNullException.ThrowIfNull(rotunjire);
13:         ArgumentNullException.ThrowIfNull(refuzuri);
14:         if (operand.Linii.Count == 0)
15:             refuzuri.Add(new(CoduriRefuz.LiniiLipsa, "Nota contabilă cere cel puțin o linie.", null));
16:         foreach (var l in operand.Linii) {
17:             if (l.ContDebitId is not Guid d || !operand.Conturi.ContainsKey(d)
18:                 || l.ContCreditId is not Guid c || !operand.Conturi.ContainsKey(c))
19:                 refuzuri.Add(new(CoduriRefuz.ContExplicitLipsa, "Linia cere ambele conturi explicite.", l.Id));
20:             if (l.Valoare == 0m)
21:                 refuzuri.Add(new(CoduriRefuz.ValoareZero, "Valoarea liniei trebuie să fie nenulă.", l.Id));
22:             foreach (var id in new[] { l.RepartitorDebitId, l.RepartitorCreditId }.OfType<Guid>())
23:                 if (!operand.Repartitori.TryGetValue(id, out var r) || r.Parte is null)
24:                     refuzuri.Add(new(CoduriRefuz.RepartitorExplicitLipsa, "Repartitorul explicit nu poate fi rezolvat.", l.Id));
25:         }
26:         if (refuzuri.Count > 0) return null;
27: 
28:         var miscari = new List<N.Miscare>();
29:         var decizii = new List<N.Decizie>();
30:         var ipoteze = new List<N.Ipoteza> { operand.PerioadaDeschisa, operand.VersiunePolitica };
31:         var solduri = operand.PartideDisponibile.ToDictionary(p => p.Unitate.Id, p => Math.Sign(p.Sold.Net) * p.Disponibil);
32:         var citite = new HashSet<Guid>();
33:         var deschise = new HashSet<Guid>();
34:         foreach (var l in operand.Linii) {
35:             var debit = Nominalizeaza(l, l.ContDebitId!.Value, l.RepartitorDebitId,
36:                 operand.Document.Predator, N.Latura.Debit);
37:             var credit = Nominalizeaza(l, l.ContCreditId!.Value, l.RepartitorCreditId,
38:                 operand.Document.Primitor, N.Latura.Credit);
39:             var i = 0; var j = 0;
40:             var rd = debit[0].Suma; var rc = credit[0].Suma;
41:             while (i < debit.Count && j < credit.Count) {
42:                 var suma = Math.Min(rd, rc);
43:                 miscari.Add(new(credit[j].Capat, debit[i].Capat, 0m, 0m,
44:                     Math.Sign(l.Valoare) * suma, new(operand.Document.Id, l.Id)));
45:                 rd -= suma; rc -= suma;
46:                 if (rd == 0 && ++i < debit.Count) rd = debit[i].Suma;
47:                 if (rc == 0 && ++j < credit.Count) rc = credit[j].Suma;
48:             }
49:         }
50:         return new(operand.Document.Id, operand.Document.DataInregistrare, miscari, decizii, ipoteze);
51: 
52:         List<(N.Capat Capat, decimal Suma)> Nominalizeaza(LinieOperand linie, Guid cont,
53:                 Guid? repartitorId, RepartitorFapt implicitul, N.Latura latura) {
54:             var repartitor = repartitorId is Guid id ? operand.Repartitori[id] : implicitul;
55:             var externul = repartitorId != null && repartitor.Parte == Parte.Extern;
56:             var capat = new N.Capat {
57:                 Cont = cont, Analiza = linie.Analiza,
58:                 Gestiune = repartitor.Parte is Parte.Intern or Parte.Propriu ? repartitor.Id : null,
59:                 Partener = externul ? repartitor.Id : null,
60:             };
61:             var cerere = Math.Abs(linie.Valoare);
62:             decizii.Add(new N.ContRezolvat(linie.Id, cont, "explicit"));
63:             if (!externul || !Partide.Urmareste(operand, cont)) return [(capat, cerere)];
64:             var sens = (latura == N.Latura.Debit ? 1 : -1) * Math.Sign(linie.Valoare);
65:             var candidati = new List<N.Disponibil>();
66:             foreach (var p in operand.PartideDisponibile.Where(p =>
67:                          p.Unitate.Cont == cont && p.Unitate.Partener == repartitor.Id)) {
68:                 if (citite.Add(p.Unitate.Id)) ipoteze.Add(new N.SoldUnitateCitit(p.Unitate, p.Sold));
69:                 var rest = -sens * solduri[p.Unitate.Id];
70:                 if (rest > 0m) candidati.Add(new(p.Unitate, rest));
71:             }
72:             var alocare = N.Fifo.Nominalizeaza(cerere, candidati);
73:             var rezultat = new List<(N.Capat Capat, decimal Suma)>();
74:             foreach (var a in alocare.Alocari) {
75:                 rezultat.Add((capat with { Unitate = a.Unitate, Partener = a.Unitate.Partener }, a.Masura));
76:                 solduri[a.Unitate.Id] += sens * a.Masura;
77:                 decizii.Add(new N.AlocareFifo(linie.Id, a.Unitate, a.Masura));
78:             }
79:             if (alocare.Ramas > 0m) {
80:                 var proprie = Partide.Proprie(operand, cont, repartitor.Id);
81:                 rezultat.Add((capat with { Unitate = proprie }, alocare.Ramas));
82:                 if (deschise.Add(proprie.Id)) decizii.Add(new N.PartidaDeschisa(linie.Id, proprie));
83:             }
84:             return rezultat;
85:         }
86:     }
87: }
DeclarantNotaTransfer.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using N = Atlas.Conta.Nucleu;
4: 
5: namespace Atlas.Conta.BackOffice.Module.Declaratii;
6: 
7: /// <summary>
8: /// BTR (T-D2): o mutare per linie — lotul își schimbă gestiunea pe contul lui de
9: /// stoc, evaluat pe raportul curent al gestiunii predatoare. Contul nu se schimbă,
10: /// deci declarația e numai `Mutari` și motorul o închide într-un `Transfer`.
11: /// </summary>
12: public sealed class DeclarantNotaTransfer : IDeclarant {
13:     public static readonly DeclarantNotaTransfer Instanta = new();
14: 
15:     DeclarantNotaTransfer() { }
16: 
17:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
18:         ArgumentNullException.ThrowIfNull(operand);
19:         ArgumentNullException.ThrowIfNull(rotunjire);
20:         ArgumentNullException.ThrowIfNull(refuzuri);
21: 
22:         var doc = operand.Document;
23:         if (doc.Predator.Id == doc.Primitor.Id)
24:             refuzuri.Add(new N.Refuz(CoduriRefuz.GestiuniIdentice,
25:                 "Gestiunea sursă și cea destinație trebuie să difere.", null));
26:         if (operand.Linii.Count == 0)
27:             refuzuri.Add(new N.Refuz(CoduriRefuz.LiniiLipsa,
28:                 "Nota de transfer se cere cu cel puțin o linie.", null));
29: 
30:         foreach (var linie in operand.Linii) {
31:             if (linie.Lot is null)
32:                 refuzuri.Add(new N.Refuz(CoduriRefuz.LotLipsa,
33:                     "Fiecare linie de transfer referă un lot.", linie.Id));
34:             else if (linie.Lot.ContImplicitId is null)
35:                 refuzuri.Add(new N.Refuz(CoduriRefuz.ContStocLipsa,
36:                     "Lotul transferat n-are cont de stoc pe tipul lui de material.", linie.Id));
37:             if (linie.Cantitate <= 0m)
38:                 refuzuri.Add(new N.Refuz(CoduriRefuz.CantitateNepozitiva,
39:                     "Cantitatea transferată trebuie să fie pozitivă.", linie.Id));
40:         }
41:         if (refuzuri.Count > 0)
42:             return null;
43: 
44:         var mutari = new List<N.Mutare>(operand.Linii.Count);
45:         var decizii = new List<N.Decizie>();
46:         var ipoteze = new List<N.Ipoteza>();
47:         var solduri = new Dictionary<CheieLotFapt, N.Sold>();
48:         foreach (var linie in operand.Linii) {
49:             var lot = linie.Lot!;
50:             var cont = lot.ContImplicitId!.Value;
51:             var cheie = new CheieLotFapt(lot.Id, cont, lot.ProdusId, doc.Predator.Id);
52:             var unitate = new N.Unitate(lot.Id, N.FelUnitate.Lot, cont, null, lot.ProdusId, lot.Data);
53:             if (!solduri.TryGetValue(cheie, out var sold)) {
54:                 sold = operand.SolduriLoturi.GetValueOrDefault(cheie) ?? N.Sold.Zero;
55:                 solduri[cheie] = sold;
56:                 ipoteze.Add(new N.SoldUnitateCitit(unitate, sold));
57:             }
58:             decimal valoare;
59:             try {
60:                 // N-D7: raportul CURENT al lotului în gestiunea predatoare, în secvența liniilor.
61:                 valoare = N.Evaluare.Iesire(sold, linie.Cantitate, rotunjire);
62:             }
63:             catch (N.RefuzException e) {
64:                 refuzuri.Add(new N.Refuz(e.Refuz.Cod, e.Refuz.Mesaj, linie.Id));
65:                 continue;
66:             }
67:             solduri[cheie] = new N.Sold(
68:                 sold.Debit, sold.Credit + valoare, sold.Cantitate - linie.Cantitate, sold.ValoareValuta);
69: 
70:             decizii.Add(new N.ContRezolvat(linie.Id, cont, SursaCont.TipMaterial.ToString()));
71:             decizii.Add(new N.ValoareIesire(linie.Id, unitate, linie.Cantitate, valoare));
72: 
73:             var capat = new N.Capat {
74:                 Cont = cont,
75:                 Gestiune = doc.Predator.Id,
76:                 Produs = lot.ProdusId,
77:                 Unitate = unitate,
78:             };
79:             mutari.Add(new N.Mutare(
80:                 capat,
81:                 capat with { Gestiune = doc.Primitor.Id },
82:                 N.Latura.Debit,
83:                 linie.Cantitate,
84:                 0m,
85:                 valoare,
86:                 new N.Cauza(doc.Id, linie.Id)));
87:         }
88:         if (refuzuri.Count > 0)
89:             return null;
90:         ipoteze.Add(operand.PerioadaDeschisa);
91:         ipoteze.Add(operand.VersiunePolitica);
92:         return new N.Declaratie(doc.Id, doc.DataInregistrare, [], mutari, decizii, ipoteze);
93:     }
94: }
DeclarantBonConsum.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using N = Atlas.Conta.Nucleu;
4: 
5: namespace Atlas.Conta.BackOffice.Module.Declaratii;
6: 
7: /// <summary>
8: /// BCS (B-D4): o mișcare per linie — lotul iese din gestiunea predatoare pe
9: /// contul de stoc al regulii și intră pe contul de cheltuială al locului de
10: /// consum, evaluat pe raportul curent al lotului.
11: /// </summary>
12: public sealed class DeclarantBonConsum : IDeclarant {
13:     public static readonly DeclarantBonConsum Instanta = new();
14: 
15:     DeclarantBonConsum() { }
16: 
17:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
18:         ArgumentNullException.ThrowIfNull(operand);
19:         ArgumentNullException.ThrowIfNull(rotunjire);
20:         ArgumentNullException.ThrowIfNull(refuzuri);
21: 
22:         var doc = operand.Document;
23:         if (operand.Linii.Count == 0)
24:             refuzuri.Add(new N.Refuz(CoduriRefuz.LiniiLipsa,
25:                 "Bonul de consum se cere cu cel puțin o linie.", null));
26: 
27:         var contari = new ContareLinie?[operand.Linii.Count];
28:         for (var i = 0; i < operand.Linii.Count; i++) {
29:             var linie = operand.Linii[i];
30:             if (linie.Lot is null)
31:                 refuzuri.Add(new N.Refuz(CoduriRefuz.LotLipsa,
32:                     "Fiecare linie de consum referă un lot.", linie.Id));
33:             if (linie.Cantitate <= 0m)
34:                 refuzuri.Add(new N.Refuz(CoduriRefuz.CantitateNepozitiva,
35:                     "Cantitatea consumată trebuie să fie pozitivă.", linie.Id));
36:             contari[i] = Contari.Rezolva(operand, linie, refuzuri);
37:         }
38:         if (refuzuri.Count > 0)
39:             return null;
40: 
41:         var miscari = new List<N.Miscare>(operand.Linii.Count);
42:         var decizii = new List<N.Decizie>();
43:         var ipoteze = new List<N.Ipoteza>();
44:         var solduri = new Dictionary<CheieLotFapt, N.Sold>();
45:         for (var i = 0; i < operand.Linii.Count; i++) {
46:             var linie = operand.Linii[i];
47:             var contare = contari[i]!.Value;
48:             var lot = linie.Lot!;
49:             var cheie = new CheieLotFapt(lot.Id, contare.ContCredit, lot.ProdusId, doc.Predator.Id);
50:             var iesit = new N.Unitate(
51:                 lot.Id, N.FelUnitate.Lot, contare.ContCredit, null, lot.ProdusId, lot.Data);
52:             if (!solduri.TryGetValue(cheie, out var sold)) {
53:                 sold = operand.SolduriLoturi.GetValueOrDefault(cheie) ?? N.Sold.Zero;
54:                 solduri[cheie] = sold;
55:                 ipoteze.Add(new N.SoldUnitateCitit(iesit, sold));
56:             }
57:             decimal valoare;
58:             try {
59:                 // N-D7/N-r3: raportul CURENT al lotului, în secvența liniilor.
60:                 valoare = N.Evaluare.Iesire(sold, linie.Cantitate, rotunjire);
61:             }
62:             catch (N.RefuzException e) {
63:                 // Refuzul e al liniei, nu al documentului: iterarea continuă ca să
64:                 // iasă TOATE refuzurile, nu primul (B-D2, MINOR-1).
65:                 refuzuri.Add(new N.Refuz(e.Refuz.Cod, e.Refuz.Mesaj, linie.Id));
66:                 continue;
67:             }
68:             solduri[cheie] = new N.Sold(
69:                 sold.Debit, sold.Credit + valoare, sold.Cantitate - linie.Cantitate, sold.ValoareValuta);
70: 
71:             decizii.Add(new N.ContRezolvat(linie.Id, contare.ContDebit, contare.SursaDebit.ToString()));
72:             decizii.Add(new N.ContRezolvat(linie.Id, contare.ContCredit, contare.SursaCredit.ToString()));
73:             decizii.Add(new N.ValoareIesire(linie.Id, iesit, linie.Cantitate, valoare));
74: 
75:             miscari.Add(new N.Miscare(
76:                 new N.Capat {
77:                     Cont = contare.ContCredit,
78:                     Gestiune = doc.Predator.Id,
79:                     Produs = lot.ProdusId,
80:                     Unitate = iesit,
81:                     Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideCredit, contare.Regula.Comun),
82:                 },
83:                 new N.Capat {
84:                     Cont = contare.ContDebit,
85:                     Gestiune = doc.Primitor.Id,
86:                     Produs = lot.ProdusId,
87:                     // C5 cere unitatea pe contul postării.
88:                     Unitate = iesit with { Cont = contare.ContDebit },
89:                     Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideDebit, contare.Regula.Comun),
90:                 },
91:                 linie.Cantitate,
92:                 0m,
93:                 valoare,
94:                 new N.Cauza(doc.Id, linie.Id)));
95:         }
96:         if (refuzuri.Count > 0)
97:             return null;
98:         ipoteze.Add(operand.PerioadaDeschisa);
99:         ipoteze.Add(operand.VersiunePolitica);
100:         return new N.Declaratie(doc.Id, doc.DataInregistrare, miscari, decizii, ipoteze);
101:     }
102: }

