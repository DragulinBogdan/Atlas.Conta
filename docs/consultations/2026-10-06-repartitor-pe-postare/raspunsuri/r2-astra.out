162:     public static SortingInfo[] OrdineJurnalTva() => new[] {
163:         OrdineLista.Crescator(nameof(JurnalTvaRand.Data)),
164:         OrdineLista.Crescator(nameof(JurnalTvaRand.DocumentId)),
165:         OrdineLista.Crescator(nameof(JurnalTvaRand.TipTvaId)),
166:         OrdineLista.Crescator(nameof(JurnalTvaRand.Storno))
167:     };
