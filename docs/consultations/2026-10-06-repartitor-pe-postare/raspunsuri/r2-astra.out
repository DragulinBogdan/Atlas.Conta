195: 
196:     public static IQueryable<BalantaRand> Balanta(
197:         IObjectSpace os, DateOnly dataStart, DateOnly dataEnd, bool analitic = false,
198:         Guid? repartitorId = null, Guid? materialId = null, Guid? codFunctionalId = null,
199:         Guid? codEconomicId = null, Guid? sursaFinantareId = null, Guid? unitateId = null,
200:         Guid? proiectId = null, Guid? centruCostId = null, Guid? gestiuneId = null,
201:         CitireCumul citire = CitireCumul.Vizibila) {
202: 
203:         var atomi = dataStart == DateOnly.MinValue ? Atomi(os).Where(a => a.Data <= dataEnd)
204:             : SolduriService.AtomiCumulati(os, citire, dataEnd, dataStart.AddDays(-1));
205: 
206:         if (gestiuneId is Guid vGest) atomi = atomi.Where(a => a.GestiuneId == vGest);
207:         if (repartitorId is Guid vRep) atomi = atomi.Where(a => a.RepartitorId == vRep);
208:         if (materialId is Guid vMat) atomi = atomi.Where(a => a.MaterialId == vMat);
209:         if (codFunctionalId is Guid vCf) atomi = atomi.Where(a => a.CodFunctionalId == vCf);
210:         if (codEconomicId is Guid vCe) atomi = atomi.Where(a => a.CodEconomicId == vCe);
211:         if (sursaFinantareId is Guid vSf) atomi = atomi.Where(a => a.SursaFinantareId == vSf);
212:         if (unitateId is Guid vUn) atomi = atomi.Where(a => a.UnitateId == vUn);
213:         if (proiectId is Guid vPr) atomi = atomi.Where(a => a.ProiectId == vPr);
214:         if (centruCostId is Guid vCc) atomi = atomi.Where(a => a.CentruCostId == vCc);
215: 
216:         var conturi = os.GetObjectsQuery<Cont>();
217:         IQueryable<AgregatBalanta> etichetate;
218: 
219:         if (analitic) {
220:             var agregate = atomi
221:                 .GroupBy(a => new { a.ContId, a.RepartitorId })
222:                 .Select(g => new {
223:                     g.Key.ContId,
224:                     g.Key.RepartitorId,
225:                     InitialDebit = g.Sum(a => a.Data < dataStart ? a.Debit : 0m),
226:                     InitialCredit = g.Sum(a => a.Data < dataStart ? a.Credit : 0m),
227:                     RulajDebit = g.Sum(a => a.Data >= dataStart ? a.Debit : 0m),
228:                     RulajCredit = g.Sum(a => a.Data >= dataStart ? a.Credit : 0m)
229:                 });
230:             etichetate =
231:                 from a in agregate
232:                 join c in conturi on a.ContId equals c.ID into grupCont
233:                 from c in grupCont.DefaultIfEmpty()
234:                 join r in os.GetObjectsQuery<Repartitor>()
235:                     on a.RepartitorId equals (Guid?)r.ID into grupRep
236:                 from r in grupRep.DefaultIfEmpty()
237:                 select new AgregatBalanta {
238:                     ContId = a.ContId,
239:                     ContSimbol = c == null ? null : c.Simbol,
240:                     ContDenumire = c == null ? null : c.Denumire,
241:                     RepartitorId = a.RepartitorId,
242:                     RepartitorDenumire = r == null ? null : r.Denumire,
243:                     InitialDebit = a.InitialDebit, InitialCredit = a.InitialCredit,
244:                     RulajDebit = a.RulajDebit, RulajCredit = a.RulajCredit
245:                 };
246:         }
247:         else {
248:             var agregate = atomi
249:                 .GroupBy(a => a.ContId)
250:                 .Select(g => new {
251:                     ContId = g.Key,
252:                     InitialDebit = g.Sum(a => a.Data < dataStart ? a.Debit : 0m),
253:                     InitialCredit = g.Sum(a => a.Data < dataStart ? a.Credit : 0m),
254:                     RulajDebit = g.Sum(a => a.Data >= dataStart ? a.Debit : 0m),
255:                     RulajCredit = g.Sum(a => a.Data >= dataStart ? a.Credit : 0m)
256:                 });
257:             etichetate =
258:                 from a in agregate
259:                 join c in conturi on a.ContId equals c.ID into grupCont
260:                 from c in grupCont.DefaultIfEmpty()
261:                 select new AgregatBalanta {
262:                     ContId = a.ContId,
263:                     ContSimbol = c == null ? null : c.Simbol,
264:                     ContDenumire = c == null ? null : c.Denumire,
265:                     RepartitorId = null, RepartitorDenumire = null,
266:                     InitialDebit = a.InitialDebit, InitialCredit = a.InitialCredit,
267:                     RulajDebit = a.RulajDebit, RulajCredit = a.RulajCredit
268:                 };
269:         }
270: 
271:         return from a in etichetate
272:                let netInitial = a.InitialDebit - a.InitialCredit
273:                let netFinal = a.InitialDebit - a.InitialCredit + a.RulajDebit - a.RulajCredit
274:                select new BalantaRand {
275:                    ContId = a.ContId,
276:                    ContSimbol = a.ContSimbol,
277:                    ContDenumire = a.ContDenumire,
278:                    RepartitorId = a.RepartitorId,
279:                    RepartitorDenumire = a.RepartitorDenumire,
280:                    InitialDebit = a.InitialDebit,
281:                    InitialCredit = a.InitialCredit,
282:                    SoldInitialDebit = netInitial > 0m ? netInitial : 0m,
283:                    SoldInitialCredit = netInitial < 0m ? -netInitial : 0m,
284:                    RulajDebit = a.RulajDebit,
285:                    RulajCredit = a.RulajCredit,
286:                    SoldFinalDebit = netFinal > 0m ? netFinal : 0m,
287:                    SoldFinalCredit = netFinal < 0m ? -netFinal : 0m
288:                };
289:     }
