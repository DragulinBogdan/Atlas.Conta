200:     public static Guid DesfaceTransfer(IObjectSpace os, Guid document, Guid transfer, DateOnly data) {
201:         var postari = os.GetObjectsQuery<Postare>().Where(p => p.TranzactieId == transfer
202:             && p.DocumentId == document && p.Tranzactie.Fel == N.FelTranzactie.Transfer).ToList();
203:         if (postari.Count == 0)
204:             throw new OperareException("IMPERECHERE_FARA_EFECT: transferul legăturii nu există.");
205:         var invers = new N.Tranzactie(N.FelTranzactie.Transfer, data, document,
206:             postari.Select(p => { var original = Randuri.Citeste(p); return original with {
207:                 Coordonate = original.Coordonate with { Data = data }, Valoare = -p.Valoare, Cantitate = -p.Cantitate }; }).ToArray());
208:         var refuzuri = N.Conservare.Verifica(invers);
209:         if (refuzuri.Count != 0) throw new OperareException(string.Join("\n", Mesaje(refuzuri)));
210:         return Scrie(os, document, invers);
211:     }
