29:     /// <summary>
30:     /// Lipsurile pe capetele mișcărilor din <c>Carte = Contabil</c>. Repartitorul unei laturi
31:     /// e partenerul sau gestiunea capătului, apoi cel al documentului, dacă e dat.
32:     /// </summary>
33:     public static IReadOnlyList<string> Lipsuri(
34:             IEnumerable<N.Miscare> miscari,
35:             IReadOnlyDictionary<Guid, ContFapt> conturi,
36:             IReadOnlyDictionary<Guid, LinieFapt> linii,
37:             Guid? repartitorDebit = null,
38:             Guid? repartitorCredit = null) {
39:         ArgumentNullException.ThrowIfNull(miscari);
40:         ArgumentNullException.ThrowIfNull(conturi);
41:         ArgumentNullException.ThrowIfNull(linii);
42:         var lipsuri = new List<string>();
43:         foreach (var miscare in miscari) {
44:             var linie = miscare.Cauza.Linie is Guid id ? linii.GetValueOrDefault(id) : default;
45:             Latura(miscare.La, "debit", repartitorDebit);
46:             Latura(miscare.DeLa, "credit", repartitorCredit);
47: 
48:             void Latura(N.Capat capat, string latura, Guid? alDocumentului) {
49:                 if (capat.Carte != N.Carte.Contabil || !conturi.TryGetValue(capat.Cont, out var cont))
50:                     return;
51:                 MotorOperare.VerificaLatura(cont.Simbol, cont.Flags,
52:                     Dimensiuni(capat.Partener ?? capat.Gestiune ?? alDocumentului, capat.Produs, capat.Analiza),
53:                     linie.Angajament, latura, linie.Denumire, lipsuri);
54:             }
55:         }
56:         return [.. lipsuri.Distinct()];
57:     }
