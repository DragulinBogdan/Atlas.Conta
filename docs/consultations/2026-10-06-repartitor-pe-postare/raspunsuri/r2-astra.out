20: public static class Loturi {
21:     public static IQueryable<Postare> Postari(IObjectSpace os) => os.GetObjectsQuery<Postare>()
22:         .Where(p => p.Spatiu == N.Spatiu.Stoc && p.Carte == N.Carte.Contabil && p.FelUnitate == N.FelUnitate.Lot
23:             && p.Unitate != null && p.Produs != null && p.Gestiune != null);
24: 
25:     public static IQueryable<RandDatat<SoldLot>> Miscari(IObjectSpace os, Guid? faraDocumentId = null) {
26:         var postari = Postari(os);
27:         if (faraDocumentId is { } document) postari = postari.Where(p => p.DocumentId != document);
28:         return postari.Select(p => new RandDatat<SoldLot> {
29:             Data = p.Data,
30:             Rand = new SoldLot {
31:                 LotId = p.Unitate.Value, ContId = p.Cont, ProdusId = p.Produs.Value, GestiuneId = p.Gestiune.Value,
32:                 Deschisa = p.UnitateDeschisa ?? p.Data, Cantitate = p.Cantitate,
33:                 Valoare = p.Latura == N.Latura.Debit ? p.Valoare : -p.Valoare
34:             }
35:         });
36:     }
37: 
38:     static IQueryable<SoldLot> Grupeaza(IQueryable<SoldLot> miscari) => miscari
39:         .GroupBy(s => new { s.LotId, s.ContId, s.ProdusId, s.GestiuneId })
40:         .Select(g => new SoldLot { LotId = g.Key.LotId, ContId = g.Key.ContId,
41:             ProdusId = g.Key.ProdusId, GestiuneId = g.Key.GestiuneId, Deschisa = g.Min(s => s.Deschisa),
42:             Cantitate = g.Sum(s => s.Cantitate), Valoare = g.Sum(s => s.Valoare) })
43:         .Where(s => s.Cantitate != 0m || s.Valoare != 0m);
44: 
45:     public static IQueryable<SoldLot> Solduri(IObjectSpace os, DateOnly? laData = null,
46:             Guid? faraDocumentId = null) =>
47:         Grupeaza(Miscari(os, faraDocumentId).Where(m => m.Data <= (laData ?? DateOnly.MaxValue)).Select(m => m.Rand));
48: 
49:     public static IQueryable<SoldLot> Disponibile(IObjectSpace os, CitireCumul citire, DateOnly laData,
50:             Guid produsId, Guid gestiuneId, Guid contId) =>
51:         from sold in Cumulate(os, citire, laData)
52:         join gestiune in os.GetObjectsQuery<BusinessObjects.Gestiune>() on sold.GestiuneId equals gestiune.ID
53:         where sold.ProdusId == produsId && sold.GestiuneId == gestiuneId
54:             && sold.ContId == contId && sold.Cantitate > 0m
55:         orderby sold.Deschisa, sold.LotId
56:         select sold;
