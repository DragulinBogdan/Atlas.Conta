62:             Id = p.ID, Spatiu = p.Spatiu, TranzactieId = p.TranzactieId, Fel = p.Tranzactie.Fel,
63:             DataTranzactie = p.Tranzactie.Data, DocumentId = p.DocumentId.Value, LinieId = p.LinieId,
64:             Cont = p.Cont, Latura = p.Latura, Valoare = p.Valoare, Partener = p.Partener,
