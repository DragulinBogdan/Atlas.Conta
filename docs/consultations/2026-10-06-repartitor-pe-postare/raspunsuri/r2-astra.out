46: 
47:     // Cantitatea e pro-formă: lipsa ei înseamnă o bucată.
48:     public override decimal? BazaLinie(DevExpress.ExpressApp.IObjectSpace os, DocumentDetaliu linie) =>
49:         linie is DecontDetaliu d ? d.PretUnitar * (d.Cantitate == 0 ? 1 : d.Cantitate) : null;
