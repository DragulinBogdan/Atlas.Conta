97:     public static IQueryable<FaptFiscal> IntreLuni(IQueryable<FaptFiscal> fapte,
98:             DateOnly? deLa, DateOnly? panaLa, FormularFiscal formular = FormularFiscal.D300) {
99:         if (deLa is { } de) {
100:             var perioada = de.Year * 100 + de.Month;
101:             fapte = formular == FormularFiscal.D394
102:                 ? fapte.Where(f => f.PerioadaD394 >= perioada) : fapte.Where(f => f.PerioadaD300 >= perioada);
103:         }
104:         if (panaLa is { } la) {
105:             var perioada = la.Year * 100 + la.Month;
106:             fapte = formular == FormularFiscal.D394
107:                 ? fapte.Where(f => f.PerioadaD394 <= perioada) : fapte.Where(f => f.PerioadaD300 <= perioada);
108:         }
109:         return fapte;
110:     }
111: }
Cub/Citiri/Invarianti.cs
1: using Atlas.Conta.BackOffice.Module.BusinessObjects;
2: using Atlas.Conta.BackOffice.Module.Motor;
3: using DevExpress.ExpressApp;
4: using DevExpress.ExpressApp.EFCore;
5: using Microsoft.EntityFrameworkCore;
6: using N = Atlas.Conta.Nucleu;
7: 
8: namespace Atlas.Conta.BackOffice.Module.Cub.Citiri;
9: 
10: /// <summary>Invarianții cubului pe baza întreagă, negarantați de scriere; proba ModelCheck, nu cale de host (102d).</summary>
11: public static class Invarianti {
12:     public static void Verifica(IObjectSpace os) {
13:         VerificaProvenienta(os);
14:         VerificaFiscal(os);
15:         VerificaTaxaLiniilor(os);
16:         Loturi.VerificaAcoperire(os);
17:         var ctx = ((EFCoreObjectSpace)os).DbContext;
18:         var postari = os.GetObjectsQuery<Postare>();
19:         var lipsuri = os.GetObjectsQuery<RegistruContabil>().Where(r => r.DocumentId != null
20:             && (!postari.Any(p => p.DocumentId == r.DocumentId && p.Carte == N.Carte.Contabil
21:                 && (r.DetaliuId == null || p.LinieId == r.DetaliuId)
22:                 && p.Cont == r.ContDebitId && p.Latura == N.Latura.Debit
23:                 && (p.Tranzactie.Fel == N.FelTranzactie.Storno) == r.Storno)
24:                 || !postari.Any(p => p.DocumentId == r.DocumentId && p.Carte == N.Carte.Contabil
25:                     && (r.DetaliuId == null || p.LinieId == r.DetaliuId)
26:                     && p.Cont == r.ContCreditId && p.Latura == N.Latura.Credit
27:                     && (p.Tranzactie.Fel == N.FelTranzactie.Storno) == r.Storno)))
28:             .Select(r => r.DocumentId.Value).Distinct().ToList();
29:         var absorbite = Receptii.Legaturi(ctx, lipsuri);
30:         lipsuri = lipsuri.Where(id => !absorbite.ContainsKey(id)).ToList();
31:         if (lipsuri.Count != 0)
32:             throw new OperareException($"CITIRE_ISTORIC_INCOMPLET: {lipsuri.Count} documente cu linii sau laturi contabile neacoperite; exemple: "
33:                 + string.Join(", ", lipsuri.Take(10)));
34: 
35:         var dezechilibrate = postari.GroupBy(p => new { p.TranzactieId, p.Carte })
36:             .Where(g => g.Sum(p => p.Latura == N.Latura.Debit ? p.Valoare : -p.Valoare) != 0m).LongCount();
37:         if (dezechilibrate != 0)
38:             throw new OperareException($"CITIRE_CUB_DEZECHILIBRAT: {dezechilibrate} tranzacții/cărți cu debit diferit de credit.");
39: 
40:         VerificaTransferuri(os);
41: 
42:         var deschideri = os.GetObjectsQuery<RegistruContabil>().Where(r => r.DocumentId == null);
43:         if (deschideri.Any()) {
44:             var vechi = deschideri.Select(r => new { Cont = r.ContDebitId, Debit = r.Valoare, Credit = 0m })
45:                 .Concat(deschideri.Select(r => new { Cont = r.ContCreditId, Debit = 0m, Credit = r.Valoare }))
46:                 .GroupBy(r => r.Cont).Select(g => new { Cont = g.Key, Debit = g.Sum(r => r.Debit), Credit = g.Sum(r => r.Credit) })
47:                 .ToList();
48:             var noi = Contabil.Postari(os).Where(p => p.Tranzactie.Fel == N.FelTranzactie.Deschidere)
49:                 .GroupBy(p => p.Cont).Select(g => new { Cont = g.Key,
50:                     Debit = g.Sum(p => p.Latura == N.Latura.Debit ? p.Valoare : 0m),
51:                     Credit = g.Sum(p => p.Latura == N.Latura.Credit ? p.Valoare : 0m) }).ToDictionary(r => r.Cont);
52:             if (vechi.Any(v => !noi.TryGetValue(v.Cont, out var n) || n.Debit != v.Debit || n.Credit != v.Credit))
53:                 throw new OperareException("CITIRE_DESCHIDERE_INCOMPLETA: soldurile istorice fără document nu sunt acoperite de deschiderea cubului.");
54:         }
55:         Partide.VerificaAcoperire(os);
56:         Proiectii.ImperecheriProiectii.VerificaAcoperire(os);
57:         Imobilizari.VerificaAcoperire(os);
58:         Explicatii.VerificaAcoperire(os);
59:     }
60: 
61:     public const string TransferNeconservat = "CITIRE_TRANSFER_NECONSERVAT";
62: 
63:     /// <summary>Un transfer persistat conservă valoarea pe (cont, latură) și cantitatea pe (cont, produs), ca la contractare (090f).</summary>
64:     public static void VerificaTransferuri(IObjectSpace os) {
65:         var transferuri = os.GetObjectsQuery<Postare>().Where(p => p.Tranzactie.Fel == N.FelTranzactie.Transfer);
66:         var valoric = transferuri.GroupBy(p => new { p.TranzactieId, p.Cont, p.Latura })
67:             .Where(g => g.Sum(p => p.Valoare) != 0m).Select(g => g.Key.TranzactieId).Take(10).ToList();
68:         var cantitativ = transferuri.Where(p => p.Cantitate != 0m).GroupBy(p => new { p.TranzactieId, p.Cont, p.Produs })
69:             .Where(g => g.Sum(p => p.Cantitate) != 0m).Select(g => g.Key.TranzactieId).Take(10).ToList();
70:         var neconservate = valoric.Concat(cantitativ).Distinct().Take(10).ToList();
71:         if (neconservate.Count != 0)
72:             throw new OperareException($"{TransferNeconservat}: transferuri care nu conservă valoarea pe (cont, latură) "
73:                 + "sau cantitatea pe (cont, produs); exemple: " + string.Join(", ", neconservate));
74:     }
75: 
76:     public const string TaxaDiferitaDeLinie = "CITIRE_TAXA_DIFERITA_DE_LINIE";
77: 
78:     /// <summary>Taxa postată separat la operare este taxa liniei documentului (109b).</summary>
79:     public static void VerificaTaxaLiniilor(IObjectSpace os) {
80:         var diferite = os.GetObjectsQuery<Postare>()
81:             .Where(p => p.RolTva == N.RolTva.Taxa && p.RegimTva != N.RegimTva.Capitalizat && p.LinieId != null
82:                 && p.Tranzactie.Fel == N.FelTranzactie.Operare)
83:             .GroupBy(p => p.LinieId)
84:             .Select(g => new { Linie = g.Key, Taxa = g.Sum(p => p.Valoare) })
85:             .Join(os.GetObjectsQuery<DocumentDetaliu>(), t => t.Linie, l => l.ID,
86:                 (t, l) => new { l.DocumentId, t.Taxa, l.ValoareTva })
87:             .Where(x => x.Taxa != x.ValoareTva)
88:             .Take(10).ToList();
89:         if (diferite.Count != 0)
90:             throw new OperareException($"{TaxaDiferitaDeLinie}: documente a căror taxă postată diferă de taxa liniei; exemple: "
91:                 + string.Join(", ", diferite.Select(x => $"{x.DocumentId} (postat {x.Taxa}, pe linie {x.ValoareTva})")));
92:     }
93: 
94:     public static void VerificaProvenienta(IObjectSpace os) {
95:         var toate = os.GetObjectsQuery<Postare>();
96:         var lipsa = os.GetObjectsQuery<Postare>().Where(p => p.Carte == N.Carte.Contabil).Where(Transformare.FaraContrapondere)
97:             .LongCount(p => p.Tranzactie.Fel == N.FelTranzactie.Storno
98:                 && !toate.Any(o => o.ID == p.InversaDinId && o.Spatiu == p.InversaDinSpatiu
99:                     && o.Tranzactie.Fel != N.FelTranzactie.Storno));
100:         if (lipsa != 0)
101:             throw new OperareException($"CITIRE_PROVENIENTA_LIPSA: {lipsa} postări Storno fără origine verificabilă.");
102:     }
103: 
104:     public static void VerificaFiscal(IObjectSpace os) {
105:         var postari = os.GetObjectsQuery<Postare>();
106:         var fapte = Fiscale.Postari(os);
107:         if (fapte.Any(p => p.DocumentId == null || p.LinieId == null || p.SensTva == null
108:                 || p.RolTva == null || p.RegimTva == null || p.CotaTva == null || p.DeImport == null
109:                 || p.DocumentFiscalId == null || p.DataDocument == null || p.DataExigibilitate == null
110:                 || p.DataInregistrare == null || p.PerioadaDeclarare == null || p.PerioadaD394 == null
111:                 || (p.SensTva == N.SensTva.Achizitie && p.DataPrimire == null)
112:                 || p.RolTva < N.RolTva.Baza || p.RolTva > N.RolTva.Autocolectare))
113:             throw new OperareException("CITIRE_FISCAL_INCOMPLET: calificare sau reper fiscal absent.");
114:         if (fapte.Any(p => p.RolTva == N.RolTva.Autocolectare
115:                 && (p.RegimTva != N.RegimTva.TaxareInversa || p.SensTva != N.SensTva.Achizitie)))
116:             throw new OperareException("CITIRE_FISCAL_AUTOLICHIDARE: autocolectare în afara unei achiziții cu taxare inversă.");
117:         if (fapte.GroupBy(p => new { p.TranzactieId, p.LinieId, p.TipTvaId, p.SensTva, p.Partener, p.RolTva })
118:                 .Any(g => g.Count() != 1))
119:             throw new OperareException("CITIRE_FISCAL_DUPLICAT: mai multe postări pentru același rol fiscal.");
120:         if (fapte.Select(p => new { p.TranzactieId, p.LinieId, p.TipTvaId, p.SensTva, p.Partener,
121:                 p.RegimTva, p.CotaTva, p.DeImport, p.DocumentFiscalId, p.DataDocument, p.DataExigibilitate,
122:                 p.DataPrimire, p.DataInregistrare, p.PerioadaDeclarare, p.PerioadaD394,
123:                 p.InversaTehnica, p.RegularizareD300 }).Distinct()
124:                 .GroupBy(p => new { p.TranzactieId, p.LinieId, p.TipTvaId, p.SensTva, p.Partener })
125:                 .Any(g => g.Count() != 1))
126:             throw new OperareException("CITIRE_FISCAL_CALIFICARE: calificări incompatibile în același fapt.");
127:         if (fapte.Any(p => p.InversaDinId != null && !postari.Any(o => o.ID == p.InversaDinId
128:                 && o.Spatiu == p.InversaDinSpatiu && o.TipTvaId == p.TipTvaId && o.RolTva == p.RolTva
129:                 && o.SensTva == p.SensTva && o.RegimTva == p.RegimTva && o.CotaTva == p.CotaTva
130:                 && o.DeImport == p.DeImport && o.DocumentFiscalId == p.DocumentFiscalId
131:                 && o.Valoare == -p.Valoare)))
132:             throw new OperareException("CITIRE_FISCAL_INVERSA: inversa nu păstrează calificarea și suma originalului.");
133:     }
134: }

