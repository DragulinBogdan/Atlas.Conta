8: namespace Atlas.Conta.BackOffice.Module.Motor;
9: 
10: // F27-D6 — corecția unui document operat: storno-ul originalului la o dată din
11: // perioada deschisă + un DRAFT nou cu aceeași culegere, legat de original și
12: // motivat. Nu e o a doua cale de stornare: `MotorOperare.Storneaza` rămâne
13: // neatins, cu toți gardienii lui (dependenți, împerecheri, sold, perioadă).
14: //
15: // Ce copiază: TOATE proprietățile scalare și FK-urile MAPATE ale tipului concret,
16: // prin metadata EF — nu o listă scrisă de mână pe 15 tipuri, care ar fi tăcut
17: // incompletă la primul câmp nou al unei frunze. Ce NU copiază e o listă mică și
18: // justificabilă: identitatea (`ID`, discriminatorul `ClrType`), ce stăpânește motorul (`Stare`,
19: // `DataOperare`, `Autogenerat`, `DocumentSursaId`, `TotalStingere`), datele proprii corecției
20: // (`DataInregistrare`, `CorecteazaId`, `MotivCorectie`) și câmpurile de
21: // blocare optimistă.
22: //
23: // `Numar` și `Data` se PĂSTREAZĂ: documentul fizic e același (aceeași factură a
24: // furnizorului, același număr de serie), doar evidența lui se reface. Seria nu
25: // se consumă din nou — `AsignaNumar` onorează un număr deja completat.
26: public static class CorectieService {
27:     // Proprietățile care NU se copiază pe documentul nou.
28:     static readonly HashSet<string> ExcluseDocument = new(StringComparer.Ordinal) {
29:         nameof(Document.ID), nameof(Document.Stare), nameof(Document.DataOperare),
30:         nameof(Document.DataInregistrare), nameof(Document.DocumentSursaId),
31:         nameof(Document.Autogenerat), nameof(Document.CorecteazaId), nameof(Document.MotivCorectie),
32:         nameof(Document.TotalStingere), nameof(Document.ClrType),
33:         nameof(Editabila.OptimisticLockField),
34:     };
35: 
36:     // Liniile: identitatea și gazda. `LotId` se copiază de aici (linia care
37:     // CONSUMĂ un lot îl păstrează) și se rescrie mai jos doar pe linia care l-a
38:     // NĂSCUT.
39:     static readonly HashSet<string> ExcluseLinie = new(StringComparer.Ordinal) {
40:         nameof(DocumentDetaliu.ID), nameof(DocumentDetaliu.DocumentId), nameof(DocumentDetaliu.ClrType),
41:         nameof(Editabila.OptimisticLockField),
42:     };
43: 
44:     // Lotul renăscut: identitatea, linia-mamă și cele două câmpuri pe care le
45:     // scrie MOTORUL la operare (26e) — noul lot pornește nefinalizat, ca orice
46:     // lot născut la culegere.
47:     static readonly HashSet<string> ExcluseLot = new(StringComparer.Ordinal) {
48:         nameof(Lot.ID), nameof(Lot.LinieIntrareId), nameof(Lot.Data), nameof(Lot.PretUnitar),
49:         nameof(Editabila.OptimisticLockField),
50:     };
51: 
52:     public static (Document Storno, Document Corectie) Corecteaza(IObjectSpace os, Guid documentId,
53:             DateOnly dataCorectie, MotivCorectie motiv) {
54:         using var tx = TranzactieComanda.Incepe(os);
55:         var original = Rezolva.Cere<Document>(os, documentId, "Documentul");
56:         // Ordinea celor două refuzuri: cel SPECIFIC întâi. Un original corectat e
57:         // deja `Stornat`, deci verificarea de stare l-ar fi înghițit cu mesajul
58:         // generic, iar operatorul n-ar fi aflat CINE îl corectează.
59:         var deja = os.GetObjectsQuery<Document>()
60:             .Where(d => d.CorecteazaId == documentId)
61:             .Select(d => new { d.Numar, d.Data })
62:             .FirstOrDefault();
63:         if (deja != null)
64:             throw new OperareException(
65:                 $"Documentul {Eticheta(original.Numar, original.Data)} e deja corectat de "
66:                 + $"{Eticheta(deja.Numar, deja.Data)} — legătura de corecție e 1:1.");
67:         if (original.Stare != StareDocument.Operat)
68:             throw new OperareException("Se corectează doar un document operat.");
69: 
70:         // Storno-ul, cu toți gardienii lui (perioada corecției deschisă, data
71:         // ≥ data înregistrării, fără dependenți, fără împerecheri).
72:         MotorOperare.Storneaza(os, original, dataCorectie);
73: 
74:         var db = DbContext(os);
75:         var corectie = (Document)os.CreateObject(db.Entry(original).Metadata.ClrType);
76:         Copiaza(db, original, corectie, ExcluseDocument);
77:         corectie.DataInregistrare = dataCorectie;
78:         corectie.CorecteazaId = original.ID;
79:         corectie.MotivCorectie = motiv;
80:         corectie.Stare = StareDocument.Draft;
81:         if (motiv == MotivCorectie.FaptNou && corectie is IDocumentFiscal faptNou) {
82:             corectie.Data = dataCorectie;
83:             faptNou.DataExigibilitate = dataCorectie;
84:             if (faptNou is IDocumentFiscalPrimit primit) primit.DataPrimire = dataCorectie;
85:         }
86: 
87:         foreach (var linie in os.GetObjectsQuery<DocumentDetaliu>()
88:                 .Where(d => d.DocumentId == documentId).ToList()) {
89:             var copie = (DocumentDetaliu)os.CreateObject(db.Entry(linie).Metadata.ClrType);
90:             Copiaza(db, linie, copie, ExcluseLinie);
91:             copie.Document = corectie;
92:             RenasteLotul(os, db, linie, copie);
93:         }
94: 
95:         if (motiv == MotivCorectie.EroareMateriala && FiscalitateService.Original(os, documentId) is { } fiscal) {
96:             var atribuire = FiscalitateService.Corectie(os, fiscal, dataCorectie);
97:             foreach (var rand in os.GetObjectsQuery<RegistruTva>()
98:                     .Where(r => r.DocumentId == documentId && r.Storno).ToList()) {
99:                 rand.PerioadaAn = atribuire.PerioadaD300 / 100;
100:                 rand.PerioadaLuna = atribuire.PerioadaD300 % 100;
101:             }
102:             Cub.Materializare.ReatribuieInversaFiscala(os, documentId, atribuire);
103:         }
104: 
105:         var erori = new List<string>();
106:         GardianEditare.VerificaLegaturaCorectiei(os, corectie, erori);
107:         if (erori.Count > 0)
108:             throw new OperareException(string.Join("\n", erori));
109: 
110:         os.CommitChanges();
111:         tx.Commit();
112:         return (original, corectie);
113:     }
