14:         Dictionary<Guid, DocPlata> PregatestePlati(List<PostareJurnal> jurnal) {
15:             var ids = jurnal.Where(p => p.DocumentId != null && p.Fel is N.FelTranzactie.Operare or N.FelTranzactie.Storno)
16:                 .Select(p => p.DocumentId.Value).Distinct().ToList();
17:             var docs = os.GetObjectsQuery<DocumentTrezorerie>().Where(d => ids.Contains(d.ID))
18:                 .Select(d => new { d.ID, d.TipInstrument, d.PredatorId, d.PrimitorId, d.ClrType }).ToList();
19:             if (docs.Count == 0)
20:                 return [];
21:             var laturi = docs.SelectMany(d => new[] { d.PredatorId, d.PrimitorId }).Distinct().ToList();
22:             var proprii = os.GetObjectsQuery<ContPropriu>().Where(c => laturi.Contains(c.ID)).Select(c => c.ID).ToList().ToHashSet();
23:             var angajati = os.GetObjectsQuery<Angajat>().Where(c => laturi.Contains(c.ID)).Select(c => c.ID).ToList().ToHashSet();
24:             var externi = os.GetObjectsQuery<Partener>().Where(c => laturi.Contains(c.ID)).Select(c => c.ID).ToList().ToHashSet();
25:             var clase = docs.Select(d => d.ClrType).Distinct().ToList();
26:             var laturaPropriu = os.GetObjectsQuery<TipDocument>().Where(t => clase.Contains(t.ClrType))
27:                 .Select(t => new { t.ClrType, t.LaturaContPropriu }).ToList()
28:                 .GroupBy(t => t.ClrType, StringComparer.Ordinal)
29:                 .ToDictionary(g => g.Key, g => g.Select(t => t.LaturaContPropriu).Distinct().ToList(), StringComparer.Ordinal);
30:             return docs.ToDictionary(d => d.ID, d => {
31:                 var propriu = laturaPropriu.TryGetValue(d.ClrType, out var l) && l.Count == 1 ? l[0] : null;
32:                 Guid? extern_ = propriu switch {
33:                     LaturaDocument.Predator => d.PrimitorId,
34:                     LaturaDocument.Primitor => d.PredatorId,
35:                     _ => null,
36:                 };
37:                 var fel = proprii.Contains(d.PredatorId) && proprii.Contains(d.PrimitorId) ? FelExtern.Virament
38:                     : extern_ is Guid e && externi.Contains(e) ? FelExtern.Partener
39:                     : extern_ is Guid a && angajati.Contains(a) ? FelExtern.Angajat
40:                     : FelExtern.Altul;
41:                 N.Latura? contrapartida = propriu switch {
42:                     LaturaDocument.Predator => N.Latura.Debit,
43:                     LaturaDocument.Primitor => N.Latura.Credit,
44:                     _ => null,
45:                 };
46:                 return new DocPlata(d.ID, d.TipInstrument, contrapartida, extern_, fel);
47:             });
48:         }
