12: namespace Atlas.Conta.BackOffice.Module.Motor;
13: 
14: /// <summary>Cifrele unei perioade de referință la reconstrucție, înainte de rescriere.</summary>
15: public sealed record RandReconstructie(int An, int Luna,
16:     long ContabilExistente, long ContabilRecalculate, long ContabilDiferite,
17:     long StocExistente, long StocRecalculate, long StocDiferite,
18:     decimal DiferentaDebit, decimal DiferentaCredit, decimal DiferentaCantitate, decimal DiferentaValoare,
19:     long PartideExistente, long PartideRecalculate, long PartideDiferite, decimal DiferentaRest);
20: 
21: /// <summary>Raportul comenzii de reconstrucție: un rând per perioadă de referință, chiar și fără diferențe.</summary>
22: public sealed record RaportReconstructie(IReadOnlyList<RandReconstructie> Referinte);
23: 
24: // Formele pe care le cere `SqlQuery<T>` pentru un rezultat NEscalar: publice,
25: // nesigilate, cu proprietăți `virtual` — `UseChangeTrackingProxies` refuză
26: // altfel tipul, la execuție (precedentul `FisaContSql`).
27: public class DiferentaContabilSql {
28:     public virtual long Existente { get; set; }
29:     public virtual long Recalculate { get; set; }
30:     public virtual long Diferite { get; set; }
31:     public virtual decimal DiferentaDebit { get; set; }
32:     public virtual decimal DiferentaCredit { get; set; }
33: }
34: 
35: public class DiferentaStocSql {
36:     public virtual long Existente { get; set; }
37:     public virtual long Recalculate { get; set; }
38:     public virtual long Diferite { get; set; }
39:     public virtual decimal DiferentaCantitate { get; set; }
40:     public virtual decimal DiferentaValoare { get; set; }
41: }
42: 
43: public class DiferentaPartideSql {
44:     public virtual long Existente { get; set; }
45:     public virtual long Recalculate { get; set; }
46:     public virtual long Diferite { get; set; }
47:     public virtual decimal DiferentaRest { get; set; }
48: }
49: 
50: public class PerioadaSnapshotSql {
51:     public virtual int An { get; set; }
52:     public virtual int Luna { get; set; }
53: }
54: 
55: public struct SnapshotPartida {
56:     public Guid UnitateId { get; set; }
57:     public Guid ContId { get; set; }
58:     public Guid PartenerId { get; set; }
59:     public DateOnly Deschisa { get; set; }
60:     public Guid? DocumentId { get; set; }
61:     public decimal Debit { get; set; }
62:     public decimal Credit { get; set; }
63: }
64: 
65: // Soldurile materializate la închidere (F27-D3). Scrierea e SQL brut Postgres,
66: // în tranzacția comenzii: cheia completă a atomului are 9 coloane și 8 dintre
67: // ele sunt nullable, deci incrementala se face `UNION ALL` + `GROUP BY`, nu
68: // JOIN — `IS NOT DISTINCT FROM` nu e hashable, iar planul ar cădea pe nested
69: // loop (spike B.1).
70: public static class SolduriService {
71:     static readonly string[] Dimensiuni = [
72:         "RepartitorId", "GestiuneId", "MaterialId", "CodFunctionalId", "CodEconomicId",
73:         "SursaFinantareId", "UnitateId", "ProiectId", "CentruCostId"
74:     ];
75: 
76:     const string Contabil = "\"SolduriPerioadaContabil\"";
77:     const string Stoc = "\"SolduriPerioadaStoc\"";
78:     const string Partide = "\"PartideDeschise\"";
79: 
80:     // Sentinela de comparare a dimensiunilor lipsă: `IS NOT DISTINCT FROM` ar
81:     // fi corect, dar nu e hashable. `Guid.Empty` nu poate fi id de rând real
82:     // (FK-urile trimit în nomenclatoare), deci coalescența e fără pierdere.
83:     const string Nil = "'00000000-0000-0000-0000-000000000000'::uuid";
84: 
85:     /// <summary>Perioadele DE REFERINȚĂ: ultima închisă plus fiecare decembrie închis.</summary>
86:     public static IReadOnlyList<(int An, int Luna)> Referinte(IObjectSpace os) {
87:         var inchise = os.GetObjectsQuery<PerioadaFiscala>()
88:             .Where(p => p.Inchisa)
89:             .Select(p => new { p.An, p.Luna })
90:             .ToList()
91:             .OrderBy(p => p.An).ThenBy(p => p.Luna)
92:             .ToList();
93:         if (inchise.Count == 0)
94:             return [];
95:         var referinte = new SortedSet<(int An, int Luna)>();
96:         referinte.Add((inchise[^1].An, inchise[^1].Luna));
97:         foreach (var p in inchise.Where(p => p.Luna == 12))
98:             referinte.Add((p.An, p.Luna));
99:         return referinte.ToList();
100:     }
101: 
102:     /// <summary>Scrie snapshot-ul perioadei: incremental din P−1 dacă îl are, altfel `SUM` integral.</summary>
103:     public static void Materializeaza(IObjectSpace os, int an, int luna) {
104:         CereNesecurizat(os);
105:         Elimina(os, an, luna);
106:         var (anPrec, lunaPrec) = Precedenta(an, luna);
107:         var precedentaContabil = AreRanduri(os, Contabil, anPrec, lunaPrec) ? (anPrec, lunaPrec) : ((int, int)?)null;
108:         var precedentaStoc = AreRanduri(os, Stoc, anPrec, lunaPrec) ? (anPrec, lunaPrec) : ((int, int)?)null;
109:         ScrieContabil(os, an, luna, precedentaContabil);
110:         ScrieStoc(os, an, luna, precedentaStoc);
111:         MaterializeazaPartide(os, an, luna);
112:     }
113: 
114:     public static void MaterializeazaPartide(IObjectSpace os, int an, int luna) {
115:         CereNesecurizat(os);
116:         EliminaPartide(os, an, luna);
117:         var argumente = new List<object>();
118:         string P(object v) { argumente.Add(v); return "{" + (argumente.Count - 1) + "}"; }
119:         var sursa = SursaPartide(os, P, an, luna);
120:         Executa(os, $"""
121:             INSERT INTO {Partide} ("ID", "An", "Luna",
122:                 "UnitateId", "ContId", "PartenerId", "Deschisa", "DocumentId", "Debit", "Credit", "Rest")
123:             SELECT gen_random_uuid(), {P(an)}, {P(luna)},
124:                 s."UnitateId", s."ContId", s."PartenerId", s."Deschisa", s."DocumentId",
125:                 s."Debit", s."Credit", ABS(s."Debit" - s."Credit")
126:             FROM ({sursa}) s
127:             """, argumente.ToArray());
128:     }
129: 
130:     static string SursaPartide(IObjectSpace os, Func<object, string> parametrul, int an, int luna) {
131:         CereNesecurizat(os);
132:         return SqlInterogare.Compune(
133:             from s in Cub.Citiri.Partide.Solduri(os, Sfarsit(an, luna))
134:             join o in Cub.Citiri.Partide.Origini(os)
135:                 on new { s.UnitateId, s.ContId, s.PartenerId } equals new { o.UnitateId, o.ContId, o.PartenerId } into origine
136:             from o in origine.DefaultIfEmpty()
137:             where s.Debit != s.Credit
138:             select new SnapshotPartida { UnitateId = s.UnitateId, ContId = s.ContId,
139:                 PartenerId = s.PartenerId, Deschisa = s.Deschisa,
140:                 DocumentId = o.DocumentId, Debit = s.Debit, Credit = s.Credit }, parametrul);
141:     }
142: 
143:     /// <summary>Perioada are deja snapshot scris?</summary>
144:     public static bool AreSnapshot(IObjectSpace os, int an, int luna) =>
145:         AreRanduri(os, Contabil, an, luna) || AreRanduri(os, Stoc, an, luna)
146:         || AreRanduri(os, Partide, an, luna);
147: 
148:     /// <summary>Șterge fizic snapshot-urile contabile, de stoc și de partide ale perioadei.</summary>
149:     public static void Elimina(IObjectSpace os, int an, int luna) {
150:         CereNesecurizat(os);
151:         Executa(os, $"DELETE FROM {Contabil} WHERE \"An\" = {{0}} AND \"Luna\" = {{1}}", an, luna);
152:         Executa(os, $"DELETE FROM {Stoc} WHERE \"An\" = {{0}} AND \"Luna\" = {{1}}", an, luna);
153:         EliminaPartide(os, an, luna);
154:     }
155: 
156:     static void EliminaPartide(IObjectSpace os, int an, int luna) =>
157:         Executa(os, $"DELETE FROM {Partide} WHERE \"An\" = {{0}} AND \"Luna\" = {{1}}", an, luna);
158: 
159:     // Prima instrucțiune a comenzii, ca `PerioadaService.Blocheaza`: fără ea o
160:     // închidere care comite după citirea referințelor ar rămâne fără snapshot —
161:     // pasul final de mai jos îl șterge ca „perioadă care nu e referință”.
162:     // Subiectul e LANȚUL ÎNTREG, nu o lună: reconstrucția atinge toate
163:     // referințele, iar ea e rară.
164:     static void BlocheazaLantul(IObjectSpace os) {
165:         const string sql = """
166:             SELECT "ID" AS "Value"
167:             FROM "PerioadeFiscale"
168:             FOR UPDATE
169:             """;
170:         Interogheaza<Guid>(os, sql);
171:     }
172: 
173:     /// <summary>Recalculează integral fiecare referință, RAPORTEAZĂ diferențele, apoi rescrie.</summary>
174:     public static RaportReconstructie Reconstruieste(IObjectSpace os) {
175:         CereNesecurizat(os);
176:         BlocheazaLantul(os);
177:         var referinte = Referinte(os);
178:         var randuri = new List<RandReconstructie>();
179:         foreach (var (an, luna) in referinte) {
180:             var contabil = DiferenteContabil(os, an, luna);
181:             var stoc = DiferenteStoc(os, an, luna);
182:             var partide = DiferentePartide(os, an, luna);
183:             randuri.Add(new RandReconstructie(an, luna,
184:                 contabil.Existente, contabil.Recalculate, contabil.Diferite,
185:                 stoc.Existente, stoc.Recalculate, stoc.Diferite,
186:                 contabil.DiferentaDebit, contabil.DiferentaCredit,
187:                 stoc.DiferentaCantitate, stoc.DiferentaValoare,
188:                 partide.Existente, partide.Recalculate, partide.Diferite, partide.DiferentaRest));
189:         }
190:         // Rescrierea vine DUPĂ raport (35b): diferența se constată pe ce era în
191:         // bază, nu pe ce urmează să scriem.
192:         foreach (var (an, luna) in referinte) {
193:             Elimina(os, an, luna);
194:             ScrieContabil(os, an, luna, null);
195:             ScrieStoc(os, an, luna, null);
196:             MaterializeazaPartide(os, an, luna);
197:         }
198:         foreach (var p in PerioadeCuSnapshot(os).Where(p => !referinte.Contains(p)))
199:             Elimina(os, p.An, p.Luna);
200:         return new RaportReconstructie(randuri);
201:     }
202: 
203:     // ═══════════════════ citirea ═══════════════════
204: 
205:     /// <summary>Ultima perioadă de referință al cărei sfârșit e `&lt;= panaLa`; null cere citire integrală din cub.</summary>
206:     public static (int An, int Luna, DateOnly Sfarsit)? Referinta(IObjectSpace os, DateOnly panaLa) {
207:         (int An, int Luna, DateOnly Sfarsit)? gasita = null;
208:         foreach (var (an, luna) in Referinte(os)) {
209:             var sfarsit = Sfarsit(an, luna);
210:             if (sfarsit <= panaLa && (gasita == null || sfarsit > gasita.Value.Sfarsit))
211:                 gasita = (an, luna, sfarsit);
212:         }
213:         return gasita;
214:     }
215: 
216:     /// <summary>Atomii contabili până la `panaLa`, porniți de la ultima referință care se termină până la `granita`.</summary>
217:     public static IQueryable<AtomContabil> AtomiCumulati(IObjectSpace os, CitireCumul citire, DateOnly panaLa,
218:             DateOnly? granita = null) {
219:         var atomi = ContabilProiectii.Atomi(os)
220:             .Select(a => new RandDatat<AtomContabil> { Data = a.Data, Rand = a });
221:         var snapshot = os.GetObjectsQuery<SoldPerioadaContabil>().IgnoreAutoIncludes()
222:             .Select(s => new SoldLunar<AtomContabil> {
223:                 An = s.An, Luna = s.Luna,
224:                 Rand = new AtomContabil {
225:                     Data = new DateOnly(s.An, s.Luna, 1).AddMonths(1).AddDays(-1),
226:                     ContId = s.ContId, Debit = s.Debit, Credit = s.Credit,
227:                     RepartitorId = s.RepartitorId, GestiuneId = s.GestiuneId,
228:                     MaterialId = s.MaterialId, CodFunctionalId = s.CodFunctionalId,
229:                     CodEconomicId = s.CodEconomicId, SursaFinantareId = s.SursaFinantareId,
230:                     UnitateId = s.UnitateId, ProiectId = s.ProiectId, CentruCostId = s.CentruCostId
231:                 }
232:             });
233:         return CumulPerioade.Citeste(os, citire, atomi, snapshot, panaLa, granita);
234:     }
235: 
236:     // ═══════════════════ scrierea ═══════════════════
237: 
238:     static void ScrieContabil(IObjectSpace os, int an, int luna, (int An, int Luna)? precedenta) {
239:         var argumente = new List<object>();
240:         string P(object v) { argumente.Add(v); return "{" + (argumente.Count - 1) + "}"; }
241:         var sb = new StringBuilder();
242:         sb.Append($"INSERT INTO {Contabil} (\"ID\", \"An\", \"Luna\", \"ContId\", ");
243:         sb.Append(string.Join(", ", Dimensiuni.Select(d => $"\"{d}\"")));
244:         sb.Append(", \"Debit\", \"Credit\")\n");
245:         sb.Append($"SELECT gen_random_uuid(), {P(an)}, {P(luna)}, k.\"ContId\", ");
246:         sb.Append(string.Join(", ", Dimensiuni.Select(d => $"k.\"{d}\"")));
247:         sb.Append(", SUM(k.\"Debit\"), SUM(k.\"Credit\")\n");
248:         sb.Append($"FROM (\n{SursaContabil(os, P, an, luna, precedenta)}\n) k\n");
249:         sb.Append("GROUP BY k.\"ContId\", ");
250:         sb.Append(string.Join(", ", Dimensiuni.Select(d => $"k.\"{d}\"")));
251:         // Cheile integral zero se OMIT: „absentă” și „zero” sunt același răspuns
252:         // pentru consumator, iar pe stoc taie ~93 % din rânduri (spike B.4).
253:         sb.Append("\nHAVING SUM(k.\"Debit\") <> 0 OR SUM(k.\"Credit\") <> 0");
254:         Executa(os, sb.ToString(), argumente.ToArray());
255:     }
256: 
257:     static void ScrieStoc(IObjectSpace os, int an, int luna, (int An, int Luna)? precedenta) {
258:         var argumente = new List<object>();
259:         string P(object v) { argumente.Add(v); return "{" + (argumente.Count - 1) + "}"; }
260:         var sursa = SursaStoc(os, P, an, luna, precedenta);
261:         Executa(os, $"""
262:             INSERT INTO {Stoc} ("ID", "An", "Luna",
263:                 "LotId", "ContId", "ProdusId", "GestiuneId", "Deschisa", "Cantitate", "Valoare")
264:             SELECT gen_random_uuid(), {P(an)}, {P(luna)},
265:                 k."LotId", k."ContId", k."ProdusId", k."GestiuneId", MIN(k."Deschisa"),
266:                 SUM(k."Cantitate"), SUM(k."Valoare")
267:             FROM ({sursa}) k
268:             GROUP BY k."LotId", k."ContId", k."ProdusId", k."GestiuneId"
269:             HAVING SUM(k."Cantitate") <> 0 OR SUM(k."Valoare") <> 0
270:             """, argumente.ToArray());
271:     }
272: 
273:     static string SursaContabil(IObjectSpace os, Func<object, string> P, int an, int luna, (int An, int Luna)? precedenta) {
274:         CereNesecurizat(os);
275:         var sfarsit = Sfarsit(an, luna);
276:         var atomi = ContabilProiectii.Atomi(os).Where(a => a.Data <= sfarsit);
277:         if (precedenta != null) {
278:             var inceput = Inceput(an, luna);
279:             atomi = atomi.Where(a => a.Data >= inceput);
280:         }
281:         var sursa = SqlInterogare.Compune(atomi.Select(a => new AtomContabil {
282:             ContId = a.ContId, RepartitorId = a.RepartitorId, GestiuneId = a.GestiuneId,
283:             MaterialId = a.MaterialId, CodFunctionalId = a.CodFunctionalId, CodEconomicId = a.CodEconomicId,
284:             SursaFinantareId = a.SursaFinantareId, UnitateId = a.UnitateId, ProiectId = a.ProiectId,
285:             CentruCostId = a.CentruCostId, Debit = a.Debit, Credit = a.Credit
286:         }), P);
287:         if (precedenta is not { } prec) return sursa;
288:         var dim = string.Join(", ", Dimensiuni.Select(d => $"\"{d}\""));
289:         return $"SELECT \"ContId\", {dim}, \"Debit\", \"Credit\" FROM {Contabil} "
290:             + $"WHERE \"An\" = {P(prec.An)} AND \"Luna\" = {P(prec.Luna)}\nUNION ALL\n{sursa}";
291:     }
292: 
293:     static string SursaStoc(IObjectSpace os, Func<object, string> P, int an, int luna, (int An, int Luna)? precedenta) {
294:         CereNesecurizat(os);
295:         var sfarsit = Sfarsit(an, luna);
296:         var miscari = Loturi.Miscari(os).Where(p => p.Data <= sfarsit);
297:         if (precedenta != null) {
298:             var inceput = Inceput(an, luna);
299:             miscari = miscari.Where(p => p.Data >= inceput);
300:         }
301:         var sursa = SqlInterogare.Compune(miscari.Select(m => m.Rand), P);
302:         if (precedenta is not { } prec) return sursa;
303:         return $"""
304:             SELECT "LotId", "ContId", "ProdusId", "GestiuneId", "Deschisa", "Cantitate", "Valoare"
305:             FROM {Stoc} WHERE "An" = {P(prec.An)} AND "Luna" = {P(prec.Luna)}
306:             UNION ALL
307:             {sursa}
308:             """;
309:     }
310: 
311:     // ═══════════════════ reconstrucția ═══════════════════
312: 
313:     static DiferentaContabilSql DiferenteContabil(IObjectSpace os, int an, int luna) {
314:         var argumente = new List<object>();
315:         string P(object v) { argumente.Add(v); return "{" + (argumente.Count - 1) + "}"; }
316:         var dim = string.Join(", ", Dimensiuni.Select(d => $"\"{d}\""));
317:         var kdim = string.Join(", ", Dimensiuni.Select(d => $"k.\"{d}\""));
318:         var potrivire = string.Join("\n     AND ", Dimensiuni.Select(d =>
319:             $"COALESCE(e.\"{d}\", {Nil}) = COALESCE(r.\"{d}\", {Nil})"));
320:         var sql = $"""
321:             WITH recalc AS (
322:               SELECT k."ContId", {kdim}, SUM(k."Debit") AS "Debit", SUM(k."Credit") AS "Credit"
323:               FROM (
324:             {SursaContabil(os, P, an, luna, null)}
325:               ) k
326:               GROUP BY k."ContId", {kdim}
327:               HAVING SUM(k."Debit") <> 0 OR SUM(k."Credit") <> 0
328:             ),
329:             existent AS (
330:               SELECT "ContId", {dim}, "Debit", "Credit" FROM {Contabil}
331:               WHERE "An" = {P(an)} AND "Luna" = {P(luna)}
332:             ),
333:             j AS (
334:               SELECT e."ContId" AS "ContIdE", r."ContId" AS "ContIdR",
335:                      e."Debit" AS "DebitE", e."Credit" AS "CreditE",
336:                      r."Debit" AS "DebitR", r."Credit" AS "CreditR"
337:               FROM existent e FULL OUTER JOIN recalc r
338:                 ON e."ContId" = r."ContId"
339:                AND {potrivire}
340:             )
341:             SELECT (SELECT COUNT(*) FROM existent) AS "Existente",
342:                    (SELECT COUNT(*) FROM recalc) AS "Recalculate",
343:                    COUNT(*) FILTER (WHERE "ContIdE" IS NULL OR "ContIdR" IS NULL
344:                                        OR "DebitE" <> "DebitR" OR "CreditE" <> "CreditR") AS "Diferite",
345:                    COALESCE(SUM(ABS(COALESCE("DebitR", 0) - COALESCE("DebitE", 0))), 0) AS "DiferentaDebit",
346:                    COALESCE(SUM(ABS(COALESCE("CreditR", 0) - COALESCE("CreditE", 0))), 0) AS "DiferentaCredit"
347:             FROM j
348:             """;
349:         return Interogheaza<DiferentaContabilSql>(os, sql, argumente.ToArray()).Single();
350:     }
351: 
352:     static DiferentaStocSql DiferenteStoc(IObjectSpace os, int an, int luna) {
353:         var argumente = new List<object>();
354:         string P(object v) { argumente.Add(v); return "{" + (argumente.Count - 1) + "}"; }
355:         var sql = $"""
356:             WITH recalc AS (
357:               SELECT k."LotId", k."ContId", k."ProdusId", k."GestiuneId", MIN(k."Deschisa") AS "Deschisa",
358:                      SUM(k."Cantitate") AS "Cantitate", SUM(k."Valoare") AS "Valoare"
359:               FROM (
360:             {SursaStoc(os, P, an, luna, null)}
361:               ) k
362:               GROUP BY k."LotId", k."ContId", k."ProdusId", k."GestiuneId"
363:               HAVING SUM(k."Cantitate") <> 0 OR SUM(k."Valoare") <> 0
364:             ),
365:             existent AS (
366:               SELECT "LotId", "ContId", "ProdusId", "GestiuneId", "Deschisa", "Cantitate", "Valoare" FROM {Stoc}
367:               WHERE "An" = {P(an)} AND "Luna" = {P(luna)}
368:             ),
369:             j AS (
370:               SELECT e."LotId" AS "LotIdE", r."LotId" AS "LotIdR",
371:                      e."Cantitate" AS "CantitateE", e."Valoare" AS "ValoareE",
372:                      r."Cantitate" AS "CantitateR", r."Valoare" AS "ValoareR",
373:                      e."Deschisa" AS "DeschisaE", r."Deschisa" AS "DeschisaR"
374:               FROM existent e FULL OUTER JOIN recalc r
375:                 ON e."LotId" = r."LotId" AND e."ContId" = r."ContId"
376:                AND e."ProdusId" = r."ProdusId" AND e."GestiuneId" = r."GestiuneId"
377:             )
378:             SELECT (SELECT COUNT(*) FROM existent) AS "Existente",
379:                    (SELECT COUNT(*) FROM recalc) AS "Recalculate",
380:                    COUNT(*) FILTER (WHERE "LotIdE" IS NULL OR "LotIdR" IS NULL
381:                                        OR "CantitateE" <> "CantitateR" OR "ValoareE" <> "ValoareR"
382:                                        OR "DeschisaE" <> "DeschisaR") AS "Diferite",
383:                    COALESCE(SUM(ABS(COALESCE("CantitateR", 0) - COALESCE("CantitateE", 0))), 0) AS "DiferentaCantitate",
384:                    COALESCE(SUM(ABS(COALESCE("ValoareR", 0) - COALESCE("ValoareE", 0))), 0) AS "DiferentaValoare"
385:             FROM j
386:             """;
387:         return Interogheaza<DiferentaStocSql>(os, sql, argumente.ToArray()).Single();
388:     }
389: 
390:     static DiferentaPartideSql DiferentePartide(IObjectSpace os, int an, int luna) {
391:         var argumente = new List<object>();
392:         string P(object v) { argumente.Add(v); return "{" + (argumente.Count - 1) + "}"; }
393:         var sursa = SursaPartide(os, P, an, luna);
394:         var sql = $"""
395:             WITH recalc AS ({sursa}), existent AS (
396:                 SELECT * FROM {Partide} WHERE "An" = {P(an)} AND "Luna" = {P(luna)}
397:             ), j AS (
398:                 SELECT e."ID", r."UnitateId", e."Deschisa" AS "DataE", r."Deschisa" AS "DataR",
399:                     e."DocumentId" AS "DocE", r."DocumentId" AS "DocR",
400:                     e."Debit" AS "DE", e."Credit" AS "CE", e."Rest" AS "RE",
401:                     r."Debit" AS "DR", r."Credit" AS "CR"
402:                 FROM existent e FULL OUTER JOIN recalc r
403:                     ON e."UnitateId" = r."UnitateId" AND e."ContId" = r."ContId" AND e."PartenerId" = r."PartenerId"
404:             )
405:             SELECT (SELECT COUNT(*) FROM existent) AS "Existente", (SELECT COUNT(*) FROM recalc) AS "Recalculate",
406:                 COUNT(*) FILTER (WHERE "ID" IS NULL OR "UnitateId" IS NULL
407:                     OR "DE" <> "DR" OR "CE" <> "CR" OR "RE" <> ABS("DR" - "CR")
408:                     OR "DataE" <> "DataR" OR "DocE" IS DISTINCT FROM "DocR") AS "Diferite",
409:                 COALESCE(SUM(ABS(COALESCE(ABS("DR" - "CR"), 0) - COALESCE("RE", 0))), 0) AS "DiferentaRest"
410:             FROM j
411:             """;
412:         return Interogheaza<DiferentaPartideSql>(os, sql, argumente.ToArray()).Single();
413:     }
414: 
415:     static IReadOnlyList<(int An, int Luna)> PerioadeCuSnapshot(IObjectSpace os) {
416:         const string sql = $"""
417:             SELECT "An", "Luna" FROM {Contabil} GROUP BY "An", "Luna"
418:             UNION
419:             SELECT "An", "Luna" FROM {Stoc} GROUP BY "An", "Luna"
420:             UNION
421:             SELECT "An", "Luna" FROM {Partide} GROUP BY "An", "Luna"
422:             """;
423:         return Interogheaza<PerioadaSnapshotSql>(os, sql).Select(p => (p.An, p.Luna)).ToList();
424:     }
425: 
426:     // ═══════════════════ primitivele ═══════════════════
427: 
428:     // 104-r2: scrierile globale refuză securitatea activă până când coaja perioadei își alege singură contextul.
429:     static void CereNesecurizat(IObjectSpace os) {
430:         if (os is ISecuredObjectSpace && (os is not EFCoreObjectSpace ef
431:                 || ef.DbContext.GetService<ISecurityEnabledOption>().EnableSecurity))
432:             throw new InvalidOperationException("SNAPSHOT_OS_SECURIZAT: scrierea globală cere un ObjectSpace nesecurizat.");
433:     }
434: 
435:     static bool AreRanduri(IObjectSpace os, string tabela, int an, int luna) =>
436:         Interogheaza<long>(os, $"SELECT COUNT(*) AS \"Value\" FROM {tabela} WHERE \"An\" = {{0}} AND \"Luna\" = {{1}}",
437:             an, luna).Single() > 0;
438: 
439:     static void Executa(IObjectSpace os, string sql, params object[] argumente) =>
440:         Db(os).ExecuteSql(FormattableStringFactory.Create(sql, argumente));
441: 
442:     static IReadOnlyList<T> Interogheaza<T>(IObjectSpace os, string sql, params object[] argumente) =>
443:         Db(os).SqlQuery<T>(FormattableStringFactory.Create(sql, argumente)).ToList();
444: 
445:     static DatabaseFacade Db(IObjectSpace os) {
446:         if (os is not EFCoreObjectSpace efCore)
447:             throw new InvalidOperationException(
448:                 $"Soldurile de perioadă cer un ObjectSpace EF Core; „{os?.GetType().Name ?? "null"}” nu expune `DbContext`.");
449:         return efCore.DbContext.Database;
450:     }
451: 
452:     static (int An, int Luna) Precedenta(int an, int luna) => luna == 1 ? (an - 1, 12) : (an, luna - 1);
453: 
454:     static DateOnly Inceput(int an, int luna) => new(an, luna, 1);
455: 
456:     static DateOnly Sfarsit(int an, int luna) => new(an, luna, DateTime.DaysInMonth(an, luna));
457: }
