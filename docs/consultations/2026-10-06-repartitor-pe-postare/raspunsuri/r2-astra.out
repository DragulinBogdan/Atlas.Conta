Cub/Citiri/Partide.cs
150:     public static Guid Identitate(Guid document, Guid cont, Guid partener) =>
151:         N.Unitate.DeschidePartida(cont, partener, document, DateOnly.MinValue).Id;
152: 
153:     public static IQueryable<OriginePartida> Origini(IObjectSpace os) => Postari(os)
154:         .Where(p => p.DocumentId == null && p.Tranzactie.Fel == N.FelTranzactie.Deschidere
155:             || p.DocumentId != null && p.Unitate == Identitate(p.DocumentId.Value, p.Cont, p.Partener.Value))
156:         .Select(p => new OriginePartida { UnitateId = p.Unitate.Value, ContId = p.Cont,
157:             PartenerId = p.Partener.Value, DocumentId = p.DocumentId }).Distinct();
158: 
159:     public static IQueryable<SoldPartida> Cumulate(IObjectSpace os, CitireCumul citire, DateOnly panaLa) {
160:         var snapshot = os.GetObjectsQuery<PartidaDeschisa>().Select(s => new SoldLunar<SoldPartida> {
161:             An = s.An, Luna = s.Luna,
162:             Rand = new SoldPartida { UnitateId = s.UnitateId, ContId = s.ContId,
163:                 PartenerId = s.PartenerId, Deschisa = s.Deschisa, Debit = s.Debit, Credit = s.Credit }
164:         });
165:         var miscari = Postari(os).Select(p => new RandDatat<SoldPartida> {
166:             Data = p.Data,
167:             Rand = new SoldPartida { UnitateId = p.Unitate.Value, ContId = p.Cont,
168:                 PartenerId = p.Partener.Value, Deschisa = p.UnitateDeschisa.Value,
169:                 Debit = p.Latura == N.Latura.Debit ? p.Valoare : 0m,
170:                 Credit = p.Latura == N.Latura.Credit ? p.Valoare : 0m }
171:         });
172:         return CumulPerioade.Citeste(os, citire, miscari, snapshot, panaLa)
173:             .GroupBy(p => new { p.UnitateId, p.ContId, p.PartenerId })
174:             .Select(g => new SoldPartida { UnitateId = g.Key.UnitateId, ContId = g.Key.ContId,
175:                 PartenerId = g.Key.PartenerId, Deschisa = g.Min(p => p.Deschisa),
176:                 Debit = g.Sum(p => p.Debit), Credit = g.Sum(p => p.Credit) });
177:     }
178:     public static IQueryable<Postare> Postari(IObjectSpace os) => os.GetObjectsQuery<Postare>().Where(Transformare.FaraContrapondere)
179:         .Where(p => p.Spatiu == N.Spatiu.Contabil && p.Carte == N.Carte.Contabil
180:             && p.FelUnitate == N.FelUnitate.Partida && p.Unitate != null
181:             && p.Partener != null && p.UnitateDeschisa != null);
182: 
183:     public static IQueryable<SoldPartida> Solduri(IObjectSpace os, DateOnly panaLa, Guid? faraDocument = null) =>
184:         Postari(os).Where(p => p.Data <= panaLa && (faraDocument == null || p.DocumentId != faraDocument))
185:             .GroupBy(p => new { p.Unitate, p.Cont, p.Partener })
186:             .Select(g => new SoldPartida {
187:                 UnitateId = g.Key.Unitate.Value, ContId = g.Key.Cont, PartenerId = g.Key.Partener.Value,
188:                 Deschisa = g.Min(p => p.UnitateDeschisa.Value),
189:                 Debit = g.Sum(p => p.Latura == N.Latura.Debit ? p.Valoare : 0m),
190:                 Credit = g.Sum(p => p.Latura == N.Latura.Credit ? p.Valoare : 0m)
191:             });
192: 
193:     public static void VerificaAcoperire(IObjectSpace os) {
194:         var externi = os.GetObjectsQuery<Partener>().Select(p => p.ID)
195:             .Concat(os.GetObjectsQuery<Angajat>().Select(p => p.ID));
196:         var documente = os.GetObjectsQuery<Document>();
197:         var conturi = os.GetObjectsQuery<Cont>().Where(c => c.UrmarestePartide);
198:         var lipsuri = os.GetObjectsQuery<Postare>().Where(Transformare.FaraContrapondere)
199:             .Where(p => p.Carte == N.Carte.Contabil
200:                 && (p.FelUnitate == N.FelUnitate.Partida
201:                     && (p.Unitate == null || p.Partener == null || p.UnitateDeschisa == null)
202:                 || p.Unitate == null && conturi.Any(c => c.ID == p.Cont)
203:                     && (p.Partener != null || documente.Any(d => d.ID == p.DocumentId
204:                         && (externi.Contains(d.PredatorId) || externi.Contains(d.PrimitorId))))))
205:             .Select(p => new { p.ID, p.DocumentId, p.Cont, p.LinieId });
206:         var numar = lipsuri.LongCount();
207:         if (numar != 0)
208:             throw new OperareException($"CITIRE_PARTIDE_INCOMPLETE: {numar} postări fără identitate completă de partidă; exemple: "
209:                 + string.Join("; ", lipsuri.OrderBy(p => p.ID).Take(10).ToList()
210:                     .Select(p => $"postare {p.ID}, document {p.DocumentId}, cont {p.Cont}, linie {p.LinieId}")));
211:     }
212: }
