217:     public static RectificativaTva Rectificativa(IObjectSpace os, int an, int luna) {
218:         var rezultat = new RectificativaTva { An = an, Luna = luna };
219:         rezultat.PerioadaDeschisa = os.GetObjectsQuery<PerioadaFiscala>()
220:             .Any(p => p.An == an && p.Luna == luna && !p.Inchisa);
221:         var codPerioada = an * 100 + luna;
222:         var reper = os.GetObjectsQuery<DepunereDeclaratie>()
223:             .Where(d => d.Formular == FormularFiscal.D394 && d.Perioada == codPerioada)
