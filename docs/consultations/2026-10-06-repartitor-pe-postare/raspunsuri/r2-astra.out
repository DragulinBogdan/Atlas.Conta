DeclarantNir.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using N = Atlas.Conta.Nucleu;
4: 
5: namespace Atlas.Conta.BackOffice.Module.Declaratii;
6: 
7: public sealed partial class DeclarantNir : IDeclarant {
8:     public static readonly DeclarantNir Instanta = new();
9:     public string SursaValoareDeclarata => SurseValoare.Receptie;
10:     DeclarantNir() { }
11:     public bool PermiteDeclaratieFaraMiscari(Operand operand) => operand.ReceptieSursa is not null;
12: 
13:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
14:         ArgumentNullException.ThrowIfNull(operand);
15:         ArgumentNullException.ThrowIfNull(rotunjire);
16:         ArgumentNullException.ThrowIfNull(refuzuri);
17:         if (operand.ReceptieSursa is not null) return DeclaraDiferenta(operand, rotunjire, refuzuri);
18:         var doc = operand.Document;
19:         var miscari = new List<N.Miscare>();
20:         var decizii = new List<N.Decizie>();
21:         var partide = new Dictionary<Guid, N.Unitate>();
22:         if (operand.Linii.Count == 0)
23:             refuzuri.Add(new(CoduriRefuz.LiniiLipsa, "Recepția cere cel puțin o linie.", null));
24:         foreach (var linie in operand.Linii) {
25:             var initial = refuzuri.Count;
26:             void Refuza(string cod, string mesaj) => refuzuri.Add(new(cod, mesaj, linie.Id));
27:             if (linie.Cantitate <= 0) Refuza(CoduriRefuz.CantitateNepozitiva, "Cantitatea recepționată trebuie să fie pozitivă.");
28:             if (linie.Natura != NaturaClasa.Stoc) Refuza(CoduriRefuz.NaturaNepotrivita, "Recepția cere natura Stoc.");
29:             if (linie.Lot is not { } lot) { Refuza(CoduriRefuz.LotLipsa, "Recepția cere lot."); continue; }
30:             if (lot.GestiuneId != doc.Primitor.Id)
31:                 Refuza(CoduriRefuz.ReceptieStructuraInvalida, "Lotul trebuie să aparțină gestiunii primitoare.");
32:             if (lot.TipMaterialId != linie.TipMaterialId || linie.TipProdusCulesId is Guid tip && tip != linie.TipMaterialId
33:                     || linie.ProdusId is Guid produs && produs != lot.ProdusId)
34:                 Refuza(CoduriRefuz.ProdusAltTip, "Produsul și tipul liniei trebuie să corespundă lotului.");
35:             var propriu = lot.LinieIntrareId == linie.Id;
36:             if (propriu && linie.PretUnitar is <= 0)
37:                 Refuza(CoduriRefuz.ValoareNepozitiva, "Prețul de recepție trebuie să fie pozitiv.");
38:             var valoare = propriu
39:                 ? linie.PretUnitar is decimal pret ? rotunjire.Bani(pret * linie.Cantitate) : linie.Valoare
40:                 : rotunjire.Bani(lot.PretUnitar * linie.Cantitate);
41:             if (valoare < 0) Refuza(CoduriRefuz.ValoareNepozitiva, "Valoarea recepției nu poate fi negativă.");
42:             var contare = Contari.Rezolva(operand, linie, refuzuri);
43:             if (refuzuri.Count != initial) continue;
44:             var cont = contare!.Value;
45:             if (cont.ContDebit != lot.ContImplicitId) {
46:                 Refuza(CoduriRefuz.ContStocLipsa, "Contul de recepție trebuie să fie contul lotului."); continue;
47:             }
48:             Partide.Numeste(operand, cont.ContCredit, doc.Predator.Id, linie.Id, partide, decizii);
49:             var externCapat = Partide.CuPartida(new N.Capat {
50:                 Cont = cont.ContCredit, Gestiune = N.GestiuniVirtuale.Furnizor, Produs = lot.ProdusId,
51:                 Analiza = Contari.Analiza(linie.Analiza, cont.Regula.OverrideCredit, cont.Regula.Comun),
52:             }, doc.Predator.Id, partide);
53:             var internCapat = new N.Capat {
54:                 Cont = cont.ContDebit, Gestiune = doc.Primitor.Id, Produs = lot.ProdusId,
55:                 Unitate = new N.Unitate(lot.Id, N.FelUnitate.Lot, cont.ContDebit, null, lot.ProdusId, lot.Data),
56:                 Analiza = Contari.Analiza(linie.Analiza, cont.Regula.OverrideDebit, cont.Regula.Comun),
57:             };
58:             miscari.Add(new(externCapat, internCapat, linie.Cantitate, 0, valoare, new(doc.Id, linie.Id)));
59:             decizii.Add(new N.ContRezolvat(linie.Id, cont.ContDebit, cont.SursaDebit.ToString()));
60:             decizii.Add(new N.ContRezolvat(linie.Id, cont.ContCredit, cont.SursaCredit.ToString()));
61:         }
62:         return refuzuri.Count > 0 ? null : new(doc.Id, doc.DataInregistrare, miscari, decizii,
63:             [operand.PerioadaDeschisa, operand.VersiunePolitica]);
64:     }
65: }
DeclarantNir.Diferenta.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using N = Atlas.Conta.Nucleu;
4: 
5: namespace Atlas.Conta.BackOffice.Module.Declaratii;
6: 
7: public sealed partial class DeclarantNir {
8:     public const string Structura = CoduriRefuz.NirDeltaStructura;
9:     public const string CauzaInvalida = CoduriRefuz.NirDeltaCauza;
10:     public const string PoliticaLipsa = CoduriRefuz.NirDeltaPolitica;
11: 
12:     static N.Declaratie? DeclaraDiferenta(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
13:         var sursa = operand.ReceptieSursa!;
14:         var doc = operand.Document;
15:         var miscari = new List<N.Miscare>();
16:         var decizii = new List<N.Decizie>();
17:         var partide = new HashSet<Guid>();
18:         foreach (var original in sursa.Linii)
19:             if (sursa.Constatari.Values.Count(c => c.LinieSursa == original.Linie) != 1)
20:                 refuzuri.Add(new(Structura, "Fiecare linie recepționată de factură trebuie păstrată o singură dată.", original.Linie));
21:         foreach (var linie in operand.Linii) {
22:             var initial = refuzuri.Count;
23:             void Refuza(string cod, string mesaj) => refuzuri.Add(new(cod, mesaj, linie.Id));
24:             var constatare = sursa.Constatari[linie.Id];
25:             var original = sursa.Linii.SingleOrDefault(l => l.Linie == constatare.LinieSursa);
26:             if (constatare.LinieSursa != null && original == null) {
27:                 Refuza(Structura, "Linia-sursă nu aparține recepției facturii."); continue;
28:             }
29:             if (linie.Lot is not { } lot || linie.Natura != NaturaClasa.Stoc) {
30:                 Refuza(Structura, "Constatarea cere un lot de stoc."); continue;
31:             }
32:             if (lot.GestiuneId != doc.Primitor.Id || lot.TipMaterialId != linie.TipMaterialId
33:                     || linie.ProdusId is Guid produs && produs != lot.ProdusId
34:                     || linie.Cantitate < 0)
35:                 Refuza(Structura, "Cantitatea, produsul, tipul și gestiunea trebuie să corespundă lotului.");
36:             N.Capat stoc;
37:             decimal q, v;
38:             if (original != null) {
39:                 stoc = original.Stoc;
40:                 if (stoc.Unitate?.Id != lot.Id || stoc.Produs != lot.ProdusId
41:                         || original.TipMaterial != linie.TipMaterialId || stoc.Gestiune != doc.Primitor.Id)
42:                     Refuza(Structura, "Lotul recepționat se corectează pe factură, nu prin reidentificarea conexului.");
43:                 q = linie.Cantitate - original.Cantitate;
44:                 v = (q == 0 ? original.Valoare : rotunjire.Bani(original.Valoare * linie.Cantitate / original.Cantitate))
45:                     - original.Valoare;
46:             }
47:             else {
48:                 if (lot.LinieIntrareId != linie.Id || linie.Cantitate <= 0 || linie.PretUnitar is not > 0)
49:                     Refuza(Structura, "Linia adăugată cere lot propriu, cantitate și preț pozitive.");
50:                 var contare = Contari.Rezolva(operand, linie, refuzuri);
51:                 if (contare is not { } cont || cont.ContDebit != lot.ContImplicitId) {
52:                     Refuza(Structura, "Plusul cere contul lotului."); continue;
53:                 }
54:                 stoc = new N.Capat { Cont = cont.ContDebit, Gestiune = doc.Primitor.Id, Produs = lot.ProdusId,
55:                     Unitate = new N.Unitate(lot.Id, N.FelUnitate.Lot, cont.ContDebit, null, lot.ProdusId, lot.Data),
56:                     Analiza = Contari.Analiza(linie.Analiza, cont.Regula.OverrideDebit, cont.Regula.Comun) };
57:                 q = linie.Cantitate;
58:                 v = rotunjire.Bani(linie.PretUnitar.GetValueOrDefault() * q);
59:             }
60:             if (refuzuri.Count != initial || q == 0 && v == 0) continue;
61:             var cauza = constatare.Cauza ?? (q < 0 ? CauzaDiferentei.InClarificare : CauzaDiferentei.Plus);
62:             if (!sursa.CauzePermise.Contains(cauza) || (q > 0) != (cauza == CauzaDiferentei.Plus)) {
63:                 Refuza(CauzaInvalida, "Cauza diferenței nu este permisă pe acest sens."); continue;
64:             }
65:             var politici = sursa.Politici.Where(p => p.Clasa == linie.ClasaId && p.Cauza == cauza).ToList();
66:             if (politici.Count != 1) { Refuza(PoliticaLipsa, "Cauza și clasa cer o singură politică de diferență."); continue; }
67:             Guid? partener = cauza == CauzaDiferentei.Imputabila ? constatare.Imputat
68:                 : cauza == CauzaDiferentei.Plus ? doc.Predator.Id : null;
69:             var tert = partener is Guid id ? operand.Repartitori.GetValueOrDefault(id) : null;
70:             if (cauza == CauzaDiferentei.Imputabila && tert?.Fel is not (FelRepartitor.Partener or FelRepartitor.Angajat)) {
71:                 Refuza(CauzaInvalida, "Lipsa imputabilă cere furnizorul, transportatorul sau angajatul pe linie."); continue;
72:             }
73:             var politica = politici[0];
74:             var contDiferenta = tert?.Fel == FelRepartitor.Angajat ? politica.ContPersonal ?? politica.Cont : politica.Cont;
75:             if (!operand.Conturi.ContainsKey(contDiferenta)
76:                     || cauza == CauzaDiferentei.Imputabila && !Partide.Urmareste(operand, contDiferenta)) {
77:                 Refuza(PoliticaLipsa, "Contul diferenței trebuie să existe; imputarea cere urmărire pe partide."); continue;
78:             }
79:             N.Unitate? partida = partener is Guid titular && Partide.Urmareste(operand, contDiferenta)
80:                 ? Partide.Proprie(operand, contDiferenta, titular) : null;
81:             if (partida != null && partide.Add(partida.Id)) decizii.Add(new N.PartidaDeschisa(linie.Id, partida));
82:             var a = stoc.Analiza;
83:             var analiza = Contari.Analiza(linie.Analiza, new Dimensiuni {
84:                 CodFunctionalId = a.CodFunctional, CodEconomicId = a.CodEconomic, SursaFinantareId = a.SursaFinantare,
85:                 UnitateId = a.UnitateOrganizatorica, ProiectId = a.Proiect, CentruCostId = a.CentruCost }, null);
86:             var diferenta = new N.Capat { Cont = contDiferenta, Gestiune = N.GestiuniVirtuale.Inventar,
87:                 Produs = lot.ProdusId, Partener = partener, Unitate = partida, Analiza = analiza };
88:             miscari.Add(q < 0 ? new(stoc, diferenta, -q, 0, -v, new(doc.Id, linie.Id))
89:                 : new(diferenta, stoc, q, 0, v, new(doc.Id, linie.Id)));
90:             decizii.Add(new N.ContRezolvat(linie.Id, contDiferenta, $"Diferență: {cauza}"));
91:             if (q < 0)
92:                 decizii.Add(new N.ValoareDeclarata(linie.Id, stoc.Unitate!, -q, -v, SurseValoare.Receptie));
93:         }
94:         return refuzuri.Count > 0 || miscari.Count == 0 ? null : new(doc.Id, doc.DataInregistrare, miscari, decizii,
95:             [operand.PerioadaDeschisa, operand.VersiunePolitica]);
96:     }
97: }
DeclarantReturFurnizor.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using Atlas.Conta.BackOffice.Module.Motor;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: public sealed class DeclarantReturFurnizor : IDeclarant {
9:     public static readonly DeclarantReturFurnizor Instanta = new();
10:     public string SursaValoareDeclarata => SurseValoare.Linie;
11:     DeclarantReturFurnizor() { }
12: 
13:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
14:         ArgumentNullException.ThrowIfNull(operand);
15:         ArgumentNullException.ThrowIfNull(rotunjire);
16:         ArgumentNullException.ThrowIfNull(refuzuri);
17:         if (operand.Linii.Count == 0)
18:             refuzuri.Add(new(CoduriRefuz.LiniiLipsa, "Returul cere cel puțin o linie.", null));
19:         var contari = new ContareLinie?[operand.Linii.Count];
20:         var fiscale = new TipTvaFapt?[operand.Linii.Count];
21:         for (var i = 0; i < operand.Linii.Count; i++) {
22:             var l = operand.Linii[i];
23:             if (l.Lot is null)
24:                 refuzuri.Add(new(CoduriRefuz.LotLipsa, "Returul descarcă lotul original.", l.Id));
25:             if (l.Cantitate == 0m)
26:                 refuzuri.Add(new(CoduriRefuz.CantitateZero, "Cantitatea returnată nu poate fi zero.", l.Id));
27:             if (l.Lot?.TipMaterialId is Guid tipLot && tipLot != l.TipMaterialId)
28:                 refuzuri.Add(new(CoduriRefuz.ProdusAltTip, "Lotul aparține altui Tip decât linia.", l.Id));
29:             contari[i] = Contari.Rezolva(operand, l, refuzuri);
30:             if (operand.PoliticaTva is null || l.TipTvaId is not Guid id) continue;
31:             if (!operand.TipuriTva.TryGetValue(id, out var tip))
32:                 refuzuri.Add(new(CoduriRefuz.TipTvaLipsa, "Tipul de TVA nu poate fi rezolvat.", l.Id));
33:             else if (tip.Regim == RegimTva.Capitalizat)
34:                 refuzuri.Add(new(CoduriRefuz.TvaCapitalizat, "TVA capitalizat nu este admis pe retur.", l.Id));
35:             else fiscale[i] = tip;
36:         }
37:         if (refuzuri.Count > 0) return null;
38:         var taxa = Fiscal.Taxa(operand, fiscale, rotunjire, refuzuri);
39:         if (refuzuri.Count > 0) return null;
40:         var doc = operand.Document;
41:         var miscari = new List<N.Miscare>();
42:         var decizii = new List<N.Decizie>();
43:         var partide = new Dictionary<Guid, N.Unitate>();
44:         for (var i = 0; i < operand.Linii.Count; i++) {
45:             var l = operand.Linii[i]; var lot = l.Lot!; var contare = contari[i]!.Value;
46:             decizii.Add(new N.ContRezolvat(l.Id, contare.ContDebit, contare.SursaDebit.ToString()));
47:             decizii.Add(new N.ContRezolvat(l.Id, contare.ContCredit, contare.SursaCredit.ToString()));
48:             var intern = new N.Capat {
49:                 Cont = contare.ContDebit, Gestiune = doc.Predator.Id, Produs = lot.ProdusId,
50:                 Unitate = new N.Unitate(lot.Id, N.FelUnitate.Lot, contare.ContDebit, null, lot.ProdusId, lot.Data),
51:                 Analiza = Contari.Analiza(l.Analiza, contare.Regula.OverrideDebit, contare.Regula.Comun),
52:             };
53:             var tert = new N.Capat {
54:                 Cont = contare.ContCredit, Gestiune = N.GestiuniVirtuale.Furnizor, Produs = lot.ProdusId,
55:                 Analiza = Contari.Analiza(l.Analiza, contare.Regula.OverrideCredit, contare.Regula.Comun),
56:             };
57:             if (fiscale[i] is { } tip) intern = Fiscal.CuFapt(operand, intern, tip, N.RolTva.Baza);
58:             // T-D6: nota fiscală păstrează q × prețul lotului, inclusiv la golire.
59:             // Nu se aplică Evaluare.Iesire; eventualul reziduu rămâne explicit.
60:             miscari.Add(new(tert, intern, l.Cantitate, 0m, l.Valoare, new(doc.Id, l.Id)));
61:             if (l.Cantitate < 0m)
62:                 decizii.Add(new N.ValoareDeclarata(l.Id, intern.Unitate!, -l.Cantitate, -l.Valoare, SurseValoare.Linie));
63:             Partide.Numeste(operand, intern.Cont, doc.Primitor.Id, l.Id, partide, decizii);
64:             Partide.Numeste(operand, tert.Cont, doc.Primitor.Id, l.Id, partide, decizii);
65:             var impozit = Fiscal.Impozitul(operand, l, fiscale[i], taxa, DirectieTva.Deductibil, refuzuri);
66:             if (impozit is not null) {
67:                 miscari.Add(impozit);
68:                 Partide.Numeste(operand, impozit.DeLa.Cont, doc.Primitor.Id, l.Id, partide, decizii);
69:                 Partide.Numeste(operand, impozit.La.Cont, doc.Primitor.Id, l.Id, partide, decizii);
70:             }
71:         }
72:         if (refuzuri.Count > 0) return null;
73:         return new(doc.Id, doc.DataInregistrare, [.. miscari.Select(m => m with {
74:             DeLa = Partide.CuPartida(m.DeLa, doc.Primitor.Id, partide),
75:             La = Partide.CuPartida(m.La, doc.Primitor.Id, partide),
76:         })], decizii, [operand.PerioadaDeschisa, operand.VersiunePolitica]);
77:     }
78: }
DeclarantReturClient.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using Atlas.Conta.BackOffice.Module.Motor;
4: using N = Atlas.Conta.Nucleu;
5: 
6: namespace Atlas.Conta.BackOffice.Module.Declaratii;
7: 
8: public sealed class DeclarantReturClient : IDeclarant {
9:     public static readonly DeclarantReturClient Instanta = new();
10:     public string SursaValoareDeclarata => SurseValoare.Linie;
11:     DeclarantReturClient() { }
12: 
13:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
14:         ArgumentNullException.ThrowIfNull(operand);
15:         ArgumentNullException.ThrowIfNull(rotunjire);
16:         ArgumentNullException.ThrowIfNull(refuzuri);
17:         if (operand.Linii.Count == 0)
18:             refuzuri.Add(new(CoduriRefuz.LiniiLipsa, "Returul cere cel puțin o linie.", null));
19:         var contari = new ContareLinie?[operand.Linii.Count];
20:         var fiscale = new TipTvaFapt?[operand.Linii.Count];
21:         for (var i = 0; i < operand.Linii.Count; i++) {
22:             var l = operand.Linii[i];
23:             var cost = l.LotId != null;
24:             if (l.Natura != (cost ? NaturaClasa.Stoc : NaturaClasa.Serviciu))
25:                 refuzuri.Add(new(CoduriRefuz.NaturaNepotrivita, "Returul cere Tip de stoc pe cost și Tip de venit pe linia fără lot.", l.Id));
26:             if (cost && l.Lot is null)
27:                 refuzuri.Add(new(CoduriRefuz.LotLipsa, "Costul returnat cere lotul original.", l.Id));
28:             if (cost && l.Cantitate == 0m)
29:                 refuzuri.Add(new(CoduriRefuz.CantitateZero, "Cantitatea returnată nu poate fi zero.", l.Id));
30:             if (!cost && l.Valoare == 0m)
31:                 refuzuri.Add(new(CoduriRefuz.ValoareZero, "Venitul returnat cere o valoare nenulă.", l.Id));
32:             if (l.Lot?.TipMaterialId is Guid tipLot && tipLot != l.TipMaterialId)
33:                 refuzuri.Add(new(CoduriRefuz.ProdusAltTip, "Lotul aparține altui Tip decât linia.", l.Id));
34:             contari[i] = Contari.Rezolva(operand, l, refuzuri);
35:             if (cost || operand.PoliticaTva is null || l.TipTvaId is not Guid id) continue;
36:             if (!operand.TipuriTva.TryGetValue(id, out var tip))
37:                 refuzuri.Add(new(CoduriRefuz.TipTvaLipsa, "Tipul de TVA nu poate fi rezolvat.", l.Id));
38:             else if (tip.Regim == RegimTva.Capitalizat)
39:                 refuzuri.Add(new(CoduriRefuz.TvaCapitalizat, "TVA capitalizat nu este admis pe retur.", l.Id));
40:             else fiscale[i] = tip;
41:         }
42:         if (refuzuri.Count > 0) return null;
43:         var taxa = Fiscal.Taxa(operand, fiscale, rotunjire, refuzuri);
44:         if (refuzuri.Count > 0) return null;
45:         var doc = operand.Document;
46:         var miscari = new List<N.Miscare>();
47:         var decizii = new List<N.Decizie>();
48:         var partide = new Dictionary<Guid, N.Unitate>();
49:         for (var i = 0; i < operand.Linii.Count; i++) {
50:             var l = operand.Linii[i]; var contare = contari[i]!.Value;
51:             decizii.Add(new N.ContRezolvat(l.Id, contare.ContDebit, contare.SursaDebit.ToString()));
52:             decizii.Add(new N.ContRezolvat(l.Id, contare.ContCredit, contare.SursaCredit.ToString()));
53:             var credit = new N.Capat {
54:                 Cont = contare.ContCredit, Gestiune = doc.Primitor.Id,
55:                 Produs = l.Lot?.ProdusId,
56:                 Analiza = Contari.Analiza(l.Analiza, contare.Regula.OverrideCredit, contare.Regula.Comun),
57:             };
58:             var debit = new N.Capat {
59:                 Cont = contare.ContDebit, Produs = l.Lot?.ProdusId,
60:                 Analiza = Contari.Analiza(l.Analiza, contare.Regula.OverrideDebit, contare.Regula.Comun),
61:             };
62:             if (l.Lot is { } lot) {
63:                 credit = credit with { Unitate = new N.Unitate(lot.Id, N.FelUnitate.Lot,
64:                     contare.ContCredit, null, lot.ProdusId, lot.Data) };
65:                 debit = debit with { Gestiune = N.GestiuniVirtuale.Client, Partener = doc.Predator.Id };
66:                 miscari.Add(new(credit, debit, l.Cantitate, 0m, l.Valoare, new(doc.Id, l.Id)));
67:                 if (l.Cantitate > 0m)
68:                     decizii.Add(new N.ValoareDeclarata(l.Id, credit.Unitate!, l.Cantitate, l.Valoare, SurseValoare.Linie));
69:             }
70:             else {
71:                 if (fiscale[i] is { } tip) credit = Fiscal.CuFapt(operand, credit, tip, N.RolTva.Baza);
72:                 miscari.Add(new(credit, debit, 0m, 0m, l.Valoare, new(doc.Id, l.Id)));
73:                 Partide.Numeste(operand, debit.Cont, doc.Predator.Id, l.Id, partide, decizii);
74:                 var impozit = Fiscal.Impozitul(operand, l, fiscale[i], taxa, DirectieTva.Colectat, refuzuri);
75:                 if (impozit is not null) {
76:                     miscari.Add(impozit);
77:                     Partide.Numeste(operand, impozit.La.Cont, doc.Predator.Id, l.Id, partide, decizii);
78:                 }
79:             }
80:         }
81:         if (refuzuri.Count > 0) return null;
82:         return new(doc.Id, doc.DataInregistrare, [.. miscari.Select(m => m with {
83:             DeLa = Partide.CuPartida(m.DeLa, doc.Predator.Id, partide),
84:             La = Partide.CuPartida(m.La, doc.Predator.Id, partide),
85:         })], decizii, [operand.PerioadaDeschisa, operand.VersiunePolitica]);
86:     }
87: }
DeclarantDescarcareGestiune.cs
1: #nullable enable
2: using Atlas.Conta.BackOffice.Module.BusinessObjects;
3: using N = Atlas.Conta.Nucleu;
4: 
5: namespace Atlas.Conta.BackOffice.Module.Declaratii;
6: 
7: /// <summary>
8: /// DSC (T-D4): o mișcare per linie — lotul iese din gestiunea predatoare pe contul
9: /// de stoc al regulii, evaluat pe raportul curent, iar costul intră pe gestiunea
10: /// virtuală a clientului, marfa părăsind patrimoniul. Descărcarea are aceeași formă
11: /// cu sau fără factura care o naște: nu nominalizează nimic al ei.
12: /// </summary>
13: public sealed class DeclarantDescarcareGestiune : IDeclarant {
14:     public static readonly DeclarantDescarcareGestiune Instanta = new();
15: 
16:     DeclarantDescarcareGestiune() { }
17: 
18:     public N.Declaratie? Declara(Operand operand, N.Rotunjire rotunjire, ICollection<N.Refuz> refuzuri) {
19:         ArgumentNullException.ThrowIfNull(operand);
20:         ArgumentNullException.ThrowIfNull(rotunjire);
21:         ArgumentNullException.ThrowIfNull(refuzuri);
22: 
23:         var doc = operand.Document;
24:         if (operand.Linii.Count == 0)
25:             refuzuri.Add(new N.Refuz(CoduriRefuz.LiniiLipsa,
26:                 "Descărcarea de gestiune se cere cu cel puțin o linie.", null));
27: 
28:         var contari = new ContareLinie?[operand.Linii.Count];
29:         for (var i = 0; i < operand.Linii.Count; i++) {
30:             var linie = operand.Linii[i];
31:             if (linie.Lot is null)
32:                 refuzuri.Add(new N.Refuz(CoduriRefuz.LotLipsa,
33:                     "Fiecare linie de descărcare referă un lot.", linie.Id));
34:             if (linie.Cantitate <= 0m)
35:                 refuzuri.Add(new N.Refuz(CoduriRefuz.CantitateNepozitiva,
36:                     "Cantitatea descărcată trebuie să fie pozitivă.", linie.Id));
37:             contari[i] = Contari.Rezolva(operand, linie, refuzuri);
38:         }
39:         if (refuzuri.Count > 0)
40:             return null;
41: 
42:         var miscari = new List<N.Miscare>(operand.Linii.Count);
43:         var decizii = new List<N.Decizie>();
44:         var ipoteze = new List<N.Ipoteza>();
45:         var solduri = new Dictionary<CheieLotFapt, N.Sold>();
46:         for (var i = 0; i < operand.Linii.Count; i++) {
47:             var linie = operand.Linii[i];
48:             var contare = contari[i]!.Value;
49:             var lot = linie.Lot!;
50:             var cheie = new CheieLotFapt(lot.Id, contare.ContCredit, lot.ProdusId, doc.Predator.Id);
51:             var iesit = new N.Unitate(
52:                 lot.Id, N.FelUnitate.Lot, contare.ContCredit, null, lot.ProdusId, lot.Data);
53:             if (!solduri.TryGetValue(cheie, out var sold)) {
54:                 sold = operand.SolduriLoturi.GetValueOrDefault(cheie) ?? N.Sold.Zero;
55:                 solduri[cheie] = sold;
56:                 ipoteze.Add(new N.SoldUnitateCitit(iesit, sold));
57:             }
58:             decimal valoare;
59:             try {
60:                 // N-D7/N-r3: raportul CURENT al lotului, în secvența liniilor.
61:                 valoare = N.Evaluare.Iesire(sold, linie.Cantitate, rotunjire);
62:             }
63:             catch (N.RefuzException e) {
64:                 refuzuri.Add(new N.Refuz(e.Refuz.Cod, e.Refuz.Mesaj, linie.Id));
65:                 continue;
66:             }
67:             solduri[cheie] = new N.Sold(
68:                 sold.Debit, sold.Credit + valoare, sold.Cantitate - linie.Cantitate, sold.ValoareValuta);
69: 
70:             decizii.Add(new N.ContRezolvat(linie.Id, contare.ContDebit, contare.SursaDebit.ToString()));
71:             decizii.Add(new N.ContRezolvat(linie.Id, contare.ContCredit, contare.SursaCredit.ToString()));
72:             decizii.Add(new N.ValoareIesire(linie.Id, iesit, linie.Cantitate, valoare));
73: 
74:             miscari.Add(new N.Miscare(
75:                 new N.Capat {
76:                     Cont = contare.ContCredit,
77:                     Gestiune = doc.Predator.Id,
78:                     Produs = lot.ProdusId,
79:                     Unitate = iesit,
80:                     Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideCredit, contare.Regula.Comun),
81:                 },
82:                 new N.Capat {
83:                     Cont = contare.ContDebit,
84:                     // N-D4: marfa părăsește patrimoniul — capătul de cost e al clientului.
85:                     Gestiune = N.GestiuniVirtuale.Client,
86:                     // T-D13 (g): terțul nominalizat pe capătul extern.
87:                     Partener = doc.Primitor.Parte == Parte.Extern ? doc.Primitor.Id : null,
88:                     Produs = lot.ProdusId,
89:                     Analiza = Contari.Analiza(linie.Analiza, contare.Regula.OverrideDebit, contare.Regula.Comun),
90:                 },
91:                 linie.Cantitate,
92:                 0m,
93:                 valoare,
94:                 new N.Cauza(doc.Id, linie.Id)));
95:         }
96:         if (refuzuri.Count > 0)
97:             return null;
98:         ipoteze.Add(operand.PerioadaDeschisa);
99:         ipoteze.Add(operand.VersiunePolitica);
100:         return new N.Declaratie(doc.Id, doc.DataInregistrare, miscari, decizii, ipoteze);
101:     }
102: }

