188:     static void VerificaDisponibilTemporal(IObjectSpace os, N.Mutare mutare, DateOnly data) {
189:         var semn = mutare.Latura == N.Latura.Debit ? 1m : -1m;
190:         foreach (var (unitate, sens) in new[] { (mutare.DeLa.Unitate.Id, semn), (mutare.La.Unitate.Id, -semn) }) {
191:             var miscari = Citiri.Partide.Postari(os).Where(p => p.Unitate == unitate)
192:                 .GroupBy(p => p.Data)
193:                 .Select(g => new { Data = g.Key, Net = g.Sum(p => p.Latura == N.Latura.Debit ? p.Valoare : -p.Valoare) })
194:                 .ToArray().Select(p => (p.Data, p.Net));
195:             if (Citiri.Partide.DisponibilTemporal(miscari, data, sens) < mutare.Valoare)
196:                 throw new OperareException("PARTIDA_PROPRIE_INSUFICIENTA: stingerea depășește disponibilul la data cerută sau într-o zi ulterioară.");
197:         }
198:     }
