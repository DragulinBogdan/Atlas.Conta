210:     public static SortingInfo[] OrdineDecontTva() => new[] {
211:         OrdineLista.Crescator(nameof(DecontTvaRand.Sens)),
212:         OrdineLista.Crescator(nameof(DecontTvaRand.TipTvaId)),
213:         OrdineLista.Crescator(nameof(DecontTvaRand.Cota)),
214:         OrdineLista.Crescator(nameof(DecontTvaRand.Regim))
