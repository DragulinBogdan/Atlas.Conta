92:             postari.Add(new(new N.Coordonate { Cont = l.Cont, Latura = N.Latura.Debit, Data = data,
93:                 Carte = l.Carte, Gestiune = l.Gestiune, Produs = lot.ProdusId, Unitate = u,
94:                 Analiza = l.Analiza, Valuta = l.Valuta },
95:                 l.Cantitate, l.ValoareValuta, l.Valoare, new(Guid.Empty, null)));
96:         }
97:         foreach (var p in partide) {
98:             VerificaMasura(p.Valoare, N.Scara.Bani);
99:             if (p.Carte != N.Carte.Contabil || !conturi[p.Cont].UrmarestePartide || !parteneri.Contains(p.Partener)
100:                 || p.Referinta == Guid.Empty || !Enum.IsDefined(p.Latura))
101:                 RefuzaDeschidere("Partida cere Carte=Contabil, cont urmărit pe partide, partener și referință valide.");
102:             var u = N.Unitate.DeschidePartidaInitiala(p.Cont, p.Partener, p.Referinta, data);
103:             if (!unitati.Add((p.Carte, u.Id, null))) RefuzaDeschidere("Partidă duplicată.");
104:             postari.Add(new(new N.Coordonate { Cont = p.Cont, Latura = p.Latura, Data = data,
105:                 Carte = p.Carte, Partener = p.Partener, Unitate = u, Analiza = p.Analiza, Valuta = p.Valuta }, 0, p.ValoareValuta, p.Valoare, new(Guid.Empty, null)));
106:         }
107:         var detalii = postari.GroupBy(p => (p.Coordonate.Carte, p.Coordonate.Cont, p.Coordonate.Latura))
108:             .ToDictionary(g => g.Key, g => g.Sum(p => p.Valoare));
109:         if (detalii.Keys.Except(chei).Any()) RefuzaDeschidere("Detaliere fără sold de control.");
110:         foreach (var s in solduri) {
111:             var cheie = (s.Carte, s.Cont, s.Latura);
112:             if (detalii.TryGetValue(cheie, out var suma) || s.Detaliat || conturi[s.Cont].UrmarestePartide || conturiStoc.Contains(s.Cont)) {
113:                 if (s.Analiza != N.Analiza.Fara || s.Valuta != null || s.ValoareValuta != 0 || s.Gestiune != null || s.Produs != null)
114:                     RefuzaDeschidere("Coordonatele soldului detaliat se furnizează pe loturi sau partide, nu pe totalul de control.");
115:                 if (!detalii.ContainsKey(cheie) || suma != s.Valoare)
116:                     throw new OperareException($"{DeschidereDiferenta}: {cheie}: control {s.Valoare}, detalii {suma}, diferență {s.Valoare - suma}.");
117:             }
118:             else postari.Add(new(new N.Coordonate { Cont = s.Cont, Latura = s.Latura, Data = data,
119:                 Carte = s.Carte, Analiza = s.Analiza, Valuta = s.Valuta, Gestiune = s.Gestiune, Produs = s.Produs }, 0, s.ValoareValuta, s.Valoare, new(Guid.Empty, null)));
120:         }
121:         var lipsuri = new List<string>();
122:         foreach (var p in postari) {
123:             var c = p.Coordonate;
124:             VerificaMasura(p.ValoareValuta, N.Scara.Bani);
125:             if (c.Valuta == Guid.Empty || (c.Valuta == null && p.ValoareValuta != 0))
126:                 RefuzaDeschidere("Valuta și suma în valută sunt incompatibile.");
127:             MotorOperare.VerificaLatura(conturi[c.Cont].Simbol, conturi[c.Cont].DimensiuniObligatorii,
128:                 GardAnaliza.Dimensiuni(c.Partener ?? c.Gestiune, c.Produs, c.Analiza),
129:                 null, c.Latura.ToString(), "deschidere", lipsuri);
130:         }
131:         if (lipsuri.Count > 0) RefuzaDeschidere(string.Join("\n", lipsuri));
132:         var tranzactie = new N.Tranzactie(N.FelTranzactie.Deschidere, data, null, postari);
133:         var refuzuri = N.Conservare.Verifica(tranzactie);
134:         if (refuzuri.Count > 0) RefuzaDeschidere(string.Join("\n", Mesaje(refuzuri)));
135:         VerificaPozitiaFaraFisa(os, tranzactie.Postari, blocheaza: true);
