67: // Trăsătura PROPRIE a tipului (06, decizia 15 nuanțată): postarea explicită pe
68: // linie — cont și repartitor, ambele laturi — ca date de primă clasă, NU ca
69: // mecanism generic de override. Contractul ILinieCuPostareExplicita e citit de
70: // motor înaintea rezolvării declarative; câmpurile sunt opționale — nerezolvat
71: // rămâne pe seama regulii (debit din Tip, credit din titular).
72: // F8-D2: aderarea la `ILinieCuPretUnitar` e pură declarație (fără coloană nouă).
73: public class DecontDetaliu : DocumentDetaliu, ILinieCuPostareExplicita, ILinieCuPretUnitar {
74:     public virtual string Descriere { get; set; }
75:     // Cota și regimul vin din TipTva (bază, P1).
76:     [XafDisplayName("Preț unitar")]
77:     public virtual decimal PretUnitar { get; set; }
78: 
79:     // Postarea explicită pe linie alege din planul mare (nomenclator mare —
80:     // lookup standard; SmartLookup revertat, decizia 40d/gate).
81:     //
82:     // NOTĂ (review F8): `ContDebit == ContCredit` pe aceeași linie postează un
83:     // rând X = X — o notă nulă, care nu mișcă niciun sold. NU se refuză, din
84:     // aceeași rațiune ca la contul SUMATOR ales explicit (F8-D14): postarea
85:     // explicită e trăsătura tipului, iar operatorul care alege un cont anume îl
86:     // primește; ce e afordanță (ce se OFERĂ în lookup) se rafinează în client,
87:     // nu se transformă în interdicție de motor. Dacă vreodată devine cerință,
88:     // locul e `ValideazaOperare`, nu culegerea.
89:     public virtual Guid? ContDebitId { get; set; }
90:     [XafDisplayName("Cont debit")]
91:     [EditorAlias(EditorAliases.LookupPropertyEditor)]
92:     public virtual Cont ContDebit { get; set; }
93:     public virtual Guid? ContCreditId { get; set; }
94:     [XafDisplayName("Cont credit")]
95:     [EditorAlias(EditorAliases.LookupPropertyEditor)]
500:     // predator (furnizor 401 / titular 542), FCL colectează contra creanței
501:     // laturii primitor (client 4111). Tipurile fără rând (NIR, BTR, BCS, LDI,
502:     // PLT, INC) nu postează TVA.
503:     static void SeedPoliticiTva(IObjectSpace os) {
504:         void Politica(string codTip, DirectieTva directie, SursaCont sursa, string fallback) {
505:             var tipDoc = os.FirstOrDefault<TipDocument>(t => t.Cod == codTip);
506:             if (tipDoc == null)
507:                 return;
508:             ContaSeeder.Aliniaza<PoliticaTva>(os, codTip, p => p.TipDocumentId == tipDoc.ID, p => {
509:                 p.TipDocumentId = tipDoc.ID;
510:                 p.Directie = directie;
511:                 p.SursaContrapartida = sursa;
512:                 p.ContrapartidaFallbackId = os.FirstOrDefault<Cont>(c => c.Simbol == fallback)?.ID;
513:                 // S-D15 — fără gard: taxa culeasă rămâne autoritară, ca în motorul
514:                 // vechi; valoarea de produs e a owner-ului (S-r1).
515:                 p.TolerantaTaxa = null;
516:             });
517:         }
518:         Politica("FCT", DirectieTva.Deductibil, SursaCont.RepartitorPredator, "401");
519:         Politica("DEC", DirectieTva.Deductibil, SursaCont.RepartitorPredator, "542");
520:         Politica("FCL", DirectieTva.Colectat, SursaCont.RepartitorPrimitor, "4111");
521:         // Retururile (FAZA 1C §7): aceeași direcție ca documentul stornat, dar
522:         // contrapartida stă pe latura INVERSĂ (RLF: furnizorul e primitor;
523:         // RDC: clientul e predator). ValoareTva negativă ⇒ 4426 = 401 cu −TVA,
524:         // respectiv 4111 = 4427 cu −TVA — exact rândurile 1C.
525:         Politica("RLF", DirectieTva.Deductibil, SursaCont.RepartitorPrimitor, "401");
526:         Politica("RDC", DirectieTva.Colectat, SursaCont.RepartitorPredator, "4111");
527:         // DVI-D2 — declarația vamală: 4426 contra contului implicit al
528:         // PREDATORULUI (biroul vamal cu 446, sau comisionarul vamal cu 401).
529:         // Fallback-ul e 446 „Alte impozite, taxe și vărsăminte asimilate" —
530:         // planul OMFP al seed-ului n-are analitic dedicat TVA-ului în vamă
531:         // (`plan-conturi-omfp.csv`: un singur rând `446`), iar analiticul, dacă
532:         // îl vrea clientul, e cont al bazei, nu al seed-ului.
533:         Politica("DVI", DirectieTva.Deductibil, SursaCont.RepartitorPredator, "446");
534:     }
535: 
536:     // Profilul de validare privat: la P2 nu mai are NICIUN rând — clasificația
537:     // bugetară nu se aplică (33c), iar interdicția FCL⊘Stoc a fost preluată de
538:     // descărcarea de gestiune (37e); curățarea rândului P1 stă în
539:     // SeedPoliticiDescarcare, ca pas explicit de updater.
540: 
541:     // Datoria P1 (design §8): default TipTva per tip de document, aplicat la
542:     // CULEGERE (nu în motor — un rând PoliticaTva doar-pentru-default ar activa
543:     // pasul TVA). FCT/FCL/DEC + retururile RLF/RDC → N21, aliniat pe rândul
544:     // `TipDocument` al seed-ului (83a): ancora schimbată din client stinge
