70:     public static void Storneaza(IObjectSpace os, Document doc, DateOnly dataStorno) {
71:         ArgumentNullException.ThrowIfNull(doc);
72:         ReceptiiConexe.VerificaFaraDependenti(os, doc);
73:         if (StingeriDeschidere(os, doc.ID).Any(p => p.Data > dataStorno))
74:             throw new OperareException($"{StingereDeschidereInvalida}: Data stornării precedă data stingerii partidei inițiale.");
75:         VerificaPartideFaraDependenti(os, doc, dataStorno);
76:         VerificaSuportFaraDependenti(os, doc, dataStorno);
77:         var transferuriStoc = os.GetObjectsQuery<Postare>()
78:             .Where(p => p.DocumentId == doc.ID && p.Tranzactie.Fel == N.FelTranzactie.Transfer
79:                 && (p.Spatiu == N.Spatiu.Stoc || p.FelUnitate == N.FelUnitate.Fisa) && p.Unitate != null)
80:             .Select(p => p.TranzactieId);
81:         var partideInitiale = os.GetObjectsQuery<Postare>()
82:             .Where(p => p.Tranzactie.Fel == N.FelTranzactie.Deschidere && p.Spatiu == N.Spatiu.Contabil && p.Unitate != null)
83:             .Select(p => p.Unitate);
84:         var transferuriDeschidere = os.GetObjectsQuery<Postare>()
85:             .Where(p => p.DocumentId == doc.ID && p.Tranzactie.Fel == N.FelTranzactie.Transfer
86:                 && p.Unitate != null && partideInitiale.Contains(p.Unitate)).Select(p => p.TranzactieId);
87:         var aleDocumentului = os.GetObjectsQuery<Postare>()
88:             .Where(p => p.DocumentId == doc.ID
89:                 && (p.Tranzactie.Fel == N.FelTranzactie.Operare
90:                     || transferuriStoc.Contains(p.TranzactieId) || transferuriDeschidere.Contains(p.TranzactieId)))
91:             .ToList();
92:         // Declarație goală (NIR conex fără diferență, 099) sau tip inert pe profil: nimic de inversat.
93:         if (aleDocumentului.Count == 0)
94:             return;
95:         var tinte = aleDocumentului.Select(p => p.ID).ToList();
96:         var atribuite = os.GetObjectsQuery<Postare>()
97:             .Where(p => p.Atribuit != null && tinte.Contains(p.Atribuit.Value))
98:             .ToList();
99:         var citite = aleDocumentului.Concat(atribuite)
100:             .DistinctBy(p => p.ID)
101:             .Select(p => (p.ID, Randuri.Citeste(p) with {
102:                 InversaDin = new N.ReferintaPostare(p.ID, p.Spatiu),
103:             }))
104:             .ToList();
105:         var tranzactie = N.Storno.Inverseaza(
106:             N.Storno.Selecteaza(citite, doc.ID),
107:             doc.ID,
108:             dataStorno,
109:             (dataStorno.Year * 100) + dataStorno.Month);
110:         var refuzuri = N.Conservare.Verifica(tranzactie);
111:         if (refuzuri.Count > 0)
112:             throw new OperareException(string.Join("\n", Mesaje(refuzuri)));
113:         Citiri.Loturi.VerificaSoldIntermediar(os, tranzactie.Postari, ReceptiiConexe.CodRefuzStoc(doc));
114:         VerificaPozitiaFaraFisa(os, tranzactie.Postari, blocheaza: true);
115:         Scrie(os, doc.ID, tranzactie);
116:     }
