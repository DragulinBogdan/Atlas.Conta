42: public static class Fiscale {
43:     public const string IzolareInsuficienta = "CITIRE_IZOLARE_INSUFICIENTA";
44: 
45:     /// <summary>Tranzacția de citire a unei declarații; cu <paramref name="cereIzolare"/>, o ambiantă sub RepeatableRead se refuză.</summary>
46:     public static IDbContextTransaction DeschideCitirea(IObjectSpace os, bool cereIzolare = false) {
47:         var db = ((EFCoreObjectSpace)os).DbContext.Database;
48:         if (db.CurrentTransaction is not { } ambianta)
49:             return db.BeginTransaction(IsolationLevel.RepeatableRead);
50:         if (cereIzolare && ambianta.GetDbTransaction().IsolationLevel
51:                 is not (IsolationLevel.RepeatableRead or IsolationLevel.Serializable or IsolationLevel.Snapshot))
52:             throw new InvalidOperationException(
53:                 $"{IzolareInsuficienta}: citirea declarației cere cel puțin RepeatableRead, tranzacția existentă are "
54:                 + $"{ambianta.GetDbTransaction().IsolationLevel}.");
55:         return null;
56:     }
57: 
58:     public static string Versiune(IObjectSpace os, FormularFiscal formular, DateOnly deLa, DateOnly panaLa) {
59:         if (deLa.Day != 1 || panaLa != deLa.AddMonths(1).AddDays(-1)) return null;
60:         var fapte = IntreLuni(Fapte(os), deLa, panaLa, formular)
61:             .OrderBy(f => f.TranzactieId).ThenBy(f => f.DocumentId).ThenBy(f => f.DetaliuId)
62:             .ThenBy(f => f.TipTvaId).ThenBy(f => f.PartenerId).ThenBy(f => f.Sens).ToArray();
63:         return Convert.ToHexString(SHA256.HashData(JsonSerializer.SerializeToUtf8Bytes(new {
64:             Formular = formular, Perioada = deLa.Year * 100 + deLa.Month, Fapte = fapte,
65:         })));
66:     }
67: 
68:     public static IQueryable<Postare> Postari(IObjectSpace os) =>
69:         os.GetObjectsQuery<Postare>().Where(p => p.TipTvaId != null);
70: 
71:     public static IQueryable<FaptFiscal> Fapte(IObjectSpace os) => Postari(os)
72:         .GroupBy(p => new {
73:             p.TranzactieId, p.DocumentId, p.DocumentFiscalId, p.LinieId, p.TipTvaId,
74:             p.Partener, p.SensTva, p.RegimTva, p.CotaTva, p.DeImport, p.PerioadaDeclarare,
75:             p.PerioadaD394, p.Data, p.DataDocument, p.DataExigibilitate, p.DataPrimire,
76:             p.DataInregistrare, p.Tranzactie.ScrisLa, p.Tranzactie.Fel,
77:             p.InversaTehnica, p.RegularizareD300,
78:         })
79:         .Select(g => new FaptFiscal {
80:             TranzactieId = g.Key.TranzactieId, DocumentId = g.Key.DocumentId.Value,
81:             DocumentFiscalId = g.Key.DocumentFiscalId.Value, DetaliuId = g.Key.LinieId.Value,
82:             TipTvaId = g.Key.TipTvaId.Value, PartenerId = g.Key.Partener,
83:             Sens = (SensTva)g.Key.SensTva.Value, Regim = (RegimTva)g.Key.RegimTva.Value,
84:             Cota = g.Key.CotaTva.Value, DeImport = g.Key.DeImport.Value,
85:             PerioadaD300 = g.Key.PerioadaDeclarare.Value, PerioadaD394 = g.Key.PerioadaD394.Value,
86:             PerioadaAn = g.Key.PerioadaDeclarare.Value / 100, PerioadaLuna = g.Key.PerioadaDeclarare.Value % 100,
87:             Data = g.Key.Data, DataDocument = g.Key.DataDocument.Value,
88:             DataExigibilitate = g.Key.DataExigibilitate.Value, DataPrimire = g.Key.DataPrimire,
89:             DataInregistrare = g.Key.DataInregistrare.Value, ScrisLa = g.Key.ScrisLa,
90:             Storno = g.Key.Fel == N.FelTranzactie.Storno,
91:             InversaTehnica = g.Key.InversaTehnica, RegularizareD300 = g.Key.RegularizareD300,
92:             Baza = g.Sum(p => p.RolTva == N.RolTva.Baza ? p.Valoare : 0m),
93:             Tva = g.Sum(p => p.RolTva == N.RolTva.Taxa ? p.Valoare : 0m),
94:             Autocolectare = g.Sum(p => p.RolTva == N.RolTva.Autocolectare ? p.Valoare : 0m),
