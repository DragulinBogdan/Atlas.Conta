70:     /// <summary>Alocarea fiecărui document, pe postările latura contrapartidei primite pentru el.</summary>
71:     public static Dictionary<Guid, AlocariPlata> Alocari(IObjectSpace os, IReadOnlyDictionary<Guid, N.Latura> laturaContrapartidei) {
72:         var rezultat = laturaContrapartidei.Keys.ToDictionary(d => d, d => new AlocariPlata { DocumentId = d });
73:         if (rezultat.Count == 0)
74:             return rezultat;
75:         var documente = rezultat.Keys.ToList();
76:         foreach (var p in Postari(os).Where(p => documente.Contains(p.DocumentId) && p.Fel == N.FelTranzactie.Operare)
77:                      .ToList().Where(p => p.Latura == laturaContrapartidei[p.DocumentId]))
78:             rezultat[p.DocumentId].Operare.Add(p);
79: 
80:         var proprii = new Dictionary<Guid, (Guid Document, Guid Cont, Guid Partener)>();
81:         foreach (var a in rezultat.Values) {
82:             var tranzactii = a.Operare.Select(p => p.TranzactieId).Distinct().ToList();
83:             if (tranzactii.Count != 1) {
84:                 a.Erori.Add($"{tranzactii.Count} tranzacții Operare cu postări de contrapartidă");
85:                 continue;
86:             }
87:             a.OperareId = tranzactii[0];
88:             var data = a.Operare[0].DataTranzactie;
89:             a.Capat = new DateOnly(data.Year, data.Month, DateTime.DaysInMonth(data.Year, data.Month));
90:             foreach (var p in a.Operare.Where(p => p.Unitate != null && p.Partener != null))
91:                 proprii.TryAdd(Partide.Identitate(a.DocumentId, p.Cont, p.Partener.Value), (a.DocumentId, p.Cont, p.Partener.Value));
92:         }
93: 
94:         var idsProprii = proprii.Keys.ToList();
95:         var capMaxim = rezultat.Values.Where(a => a.Erori.Count == 0).Select(a => a.Capat).DefaultIfEmpty().Max();
96:         var tranzactiiTransfer = idsProprii.Count == 0 ? [] : Partide.Postari(os)
97:             .Where(p => p.Tranzactie.Fel == N.FelTranzactie.Transfer && idsProprii.Contains(p.Unitate.Value) && p.Data <= capMaxim)
98:             .Select(p => p.TranzactieId).Distinct().ToList();
99:         var transferuri = tranzactiiTransfer.Count == 0 ? [] : Partide.Postari(os)
100:             .Where(p => tranzactiiTransfer.Contains(p.TranzactieId))
101:             .Select(p => new { p.ID, p.Spatiu, p.TranzactieId, p.Data, p.Cont, p.Partener, p.Latura, p.Valoare, Unitate = p.Unitate.Value })
102:             .ToList().GroupBy(p => p.TranzactieId).ToDictionary(g => g.Key, g => g.ToList());
103: 
104:         var unitati = rezultat.Values.SelectMany(a => a.Operare).Where(p => p.Unitate != null).Select(p => p.Unitate.Value)
105:             .Concat(transferuri.Values.SelectMany(t => t).Select(p => p.Unitate)).Distinct().ToList();
106:         var origini = unitati.Count == 0 ? [] : Partide.Origini(os).Where(o => unitati.Contains(o.UnitateId))
107:             .Select(o => new { o.UnitateId, o.DocumentId }).ToList()
108:             .GroupBy(o => o.UnitateId).ToDictionary(g => g.Key, g => g.Select(o => o.DocumentId).Distinct().ToList());
109: 
110:         AlocarePlata Linie(AlocariPlata a, Guid cont, Guid? partener, N.Latura latura, TintaPlata tinta, Guid? unitate, Guid? document) {
111:             var linie = a.Linii.FirstOrDefault(l => l.Cont == cont && l.Partener == partener && l.Tinta == tinta && l.Unitate == unitate);
112:             if (linie == null)
113:                 a.Linii.Add(linie = new AlocarePlata {
114:                     Cont = cont, Partener = partener, Latura = latura, Tinta = tinta, Unitate = unitate, DocumentTinta = document,
115:                 });
116:             return linie;
117:         }
118: 
119:         AlocarePlata Tinta(AlocariPlata a, Guid cont, Guid partener, N.Latura latura, Guid unitate) {
120:             if (!origini.TryGetValue(unitate, out var o) || o.Count != 1) {
121:                 a.Erori.Add($"partida {unitate} nu are o origine unică");
122:                 return null;
123:             }
124:             return o[0] is Guid document
125:                 ? Linie(a, cont, partener, latura, TintaPlata.Document, unitate, document)
126:                 : Linie(a, cont, partener, latura, TintaPlata.PartidaInitiala, unitate, null);
127:         }
128: 
129:         foreach (var a in rezultat.Values.Where(a => a.Erori.Count == 0)) {
130:             foreach (var p in a.Operare) {
131:                 if (p.Unitate is not Guid u || p.Partener is not Guid partener) {
132:                     var fara = Linie(a, p.Cont, p.Partener, p.Latura, TintaPlata.FaraPartida, null, null);
133:                     fara.Suma += p.Valoare;
134:                     fara.Contributii.Add(p);
135:                     continue;
136:                 }
137:                 var proprie = Partide.Identitate(a.DocumentId, p.Cont, partener);
138:                 var linie = u == proprie
139:                     ? Linie(a, p.Cont, partener, p.Latura, TintaPlata.Rest, u, null)
140:                     : Tinta(a, p.Cont, partener, p.Latura, u);
141:                 if (linie == null) continue;
142:                 linie.Suma += p.Valoare;
143:                 linie.Contributii.Add(p);
144:             }
145:             foreach (var p in a.Operare.Where(p => p.Unitate != null && p.Partener != null).ToList())
146:                 Linie(a, p.Cont, p.Partener, p.Latura, TintaPlata.Rest, Partide.Identitate(a.DocumentId, p.Cont, p.Partener.Value), null);
147:             foreach (var rest in a.Linii.Where(l => l.Tinta == TintaPlata.Rest).ToList()) {
148:                 var legate = new List<AlocarePlata> { rest };
149:                 foreach (var (id, perechi) in transferuri) {
150:                     var pe = perechi.Where(p => p.Unitate == rest.Unitate).ToList();
151:                     if (pe.Count == 0 || pe[0].Data > a.Capat) continue;
152:                     var alta = perechi.Where(p => p.Unitate != rest.Unitate).ToList();
153:                     if (perechi.Count != 2 || pe.Count != 1 || alta.Count != 1 || alta[0].Cont != pe[0].Cont
154:                             || alta[0].Partener != pe[0].Partener || alta[0].Latura != pe[0].Latura
155:                             || alta[0].Valoare != -pe[0].Valoare) {
156:                         a.Erori.Add($"transferul {id} nu este o pereche pe partida proprie");
157:                         continue;
158:                     }
159:                     var efect = pe[0].Latura == rest.Latura ? pe[0].Valoare : -pe[0].Valoare;
160:                     var tinta = Tinta(a, rest.Cont, rest.Partener.Value, rest.Latura, alta[0].Unitate);
161:                     if (tinta == null) continue;
162:                     tinta.Suma -= efect;
163:                     rest.Suma += efect;
164:                     if (!legate.Contains(tinta)) legate.Add(tinta);
