169:     public static IQueryable<DecontTvaRand> DecontTva(
170:         IObjectSpace os, DateOnly? dataStart = null, DateOnly? dataEnd = null) {
171: 
172:         var randuri = IntreLuni(Fiscale.Fapte(os), dataStart, dataEnd);
173: 
174:         var agregate = randuri
175:             .GroupBy(r => new { r.Sens, r.TipTvaId, r.Regim, r.Cota, r.DeImport })
176:             .Select(g => new {
177:                 g.Key.Sens,
178:                 g.Key.TipTvaId,
179:                 g.Key.Regim,
180:                 g.Key.Cota, g.Key.DeImport,
181:                 Randuri = g.Count(),
182:                 Baza = g.Sum(r => r.Baza),
183:                 Tva = g.Sum(r => r.Tva)
184:             });
185: 
186:         return from a in agregate
187:                join t in os.GetObjectsQuery<TipTva>() on a.TipTvaId equals t.ID into grupTip
188:                from t in grupTip.DefaultIfEmpty()
189:                select new DecontTvaRand {
190:                    Sens = a.Sens == SensTva.Achizitie ? "Achizitie" : "Livrare",
191:                    TipTvaId = a.TipTvaId,
192:                    TipTvaCod = t == null ? null : t.Cod,
193:                    TipTvaDenumire = t == null ? null : t.Denumire,
194:                    Regim = a.Regim == RegimTva.Normal ? "Normal"
195:                        : a.Regim == RegimTva.Capitalizat ? "Capitalizat"
196:                        : a.Regim == RegimTva.TaxareInversa ? "TaxareInversa"
197:                        : a.Regim == RegimTva.Scutit ? "Scutit"
198:                        : "Neimpozabil",
199:                    Cota = a.Cota,
200:                    CodSafT = os.GetObjectsQuery<MapareTvaSaft>().Where(m => m.Versiune == MapariFiscale.Versiune
201:                        && m.Sectiune == SectiuneTvaSaft.Facturi && m.TipTvaId == a.TipTvaId
202:                        && m.Regim == a.Regim && m.Cota == a.Cota && m.DeImport == a.DeImport
203:                        && m.Sens == a.Sens && m.Rol == N.RolTva.Taxa).Select(m => m.TaxCode).FirstOrDefault(),
204:                    Randuri = a.Randuri,
205:                    Baza = a.Baza,
206:                    Tva = a.Tva
207:                };
208:     }
