443:         Guid? proiectId = null, Guid? centruCostId = null, bool repartitorNul = false,
444:         Guid? gestiuneId = null, CitireCumul citire = CitireCumul.Vizibila) {
445:         var argumente = new List<object>();
446:         string P(object valoare) { argumente.Add(valoare); return "{" + (argumente.Count - 1) + "}"; }
447:         var postari = Cub.Citiri.Contabil.Postari(os).Where(p => p.Data <= dataEnd);
448:         var etichetate = from p in postari
449:             join c in os.GetObjectsQuery<Cont>() on p.Cont equals c.ID into conturi
450:             from c in conturi.DefaultIfEmpty()
451:             join d in os.GetObjectsQuery<Document>() on p.DocumentId equals d.ID into documente
452:             from d in documente.DefaultIfEmpty()
453:             join r in os.GetObjectsQuery<Repartitor>() on p.Partener equals r.ID into parteneri
454:             from r in parteneri.DefaultIfEmpty()
455:             select new SursaFisa {
456:                 Id = p.ID, Spatiu = (int)p.Spatiu, TranzactieId = p.TranzactieId, Data = p.Data, ContId = p.Cont,
457:                 ContSimbol = c.Simbol, NumarNota = d.Numar, Sens = p.Latura == N.Latura.Debit ? "D" : "C",
458:                 Debit = p.Latura == N.Latura.Debit ? p.Valoare : 0m,
459:                 Credit = p.Latura == N.Latura.Credit ? p.Valoare : 0m,
460:                 RepartitorId = p.Partener, GestiuneId = p.Gestiune, MaterialId = p.Produs,
461:                 CodFunctionalId = p.CodFunctional, CodEconomicId = p.CodEconomic,
462:                 SursaFinantareId = p.SursaFinantare, UnitateId = p.UnitateOrganizatorica,
463:                 ProiectId = p.Proiect, CentruCostId = p.CentruCost,
464:                 RepartitorDenumire = r.Denumire, DocumentId = p.DocumentId,
465:                 Storno = p.Tranzactie.Fel == N.FelTranzactie.Storno
466:             };
467:         var initial = (dataStart == DateOnly.MinValue ? Atomi(os).Where(a => false)
468:             : SolduriService.AtomiCumulati(os, citire, dataStart.AddDays(-1))).Where(a => a.ContId == contId);
469:         var dimensiuni = new Dictionary<string, Guid?> {
470:             ["RepartitorId"] = repartitorId, ["GestiuneId"] = gestiuneId, ["MaterialId"] = materialId,
471:             ["CodFunctionalId"] = codFunctionalId, ["CodEconomicId"] = codEconomicId,
472:             ["SursaFinantareId"] = sursaFinantareId, ["UnitateId"] = unitateId,
473:             ["ProiectId"] = proiectId, ["CentruCostId"] = centruCostId
474:         };
475:         string Filtre(string alias) => string.Concat(dimensiuni.Where(d => d.Value.HasValue)
476:             .Select(d => $" AND {alias}.\"{d.Key}\" = {P(d.Value.Value)}"))
477:             + (repartitorNul ? $" AND {alias}.\"RepartitorId\" IS NULL" : "");
478:         var sursa = SqlInterogare.Compune(etichetate, P);
479:         var sold = SqlInterogare.Compune(initial, P);
480:         var sql = $"""
481:             WITH postari AS NOT MATERIALIZED ({sursa}),
482:             initial AS (SELECT COALESCE(SUM(i."Debit" - i."Credit"), 0) AS sold FROM ({sold}) i WHERE true{Filtre("i")})
483:             SELECT p."Id", p."Spatiu", p."TranzactieId", p."Data", p."NumarNota", p."Sens", p."Debit", p."Credit",
484:                 (SELECT sold FROM initial) + SUM(p."Debit" - p."Credit") OVER (
485:                     ORDER BY p."Data", p."Id", p."Spatiu" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "SoldCurent",
486:                 (SELECT CASE WHEN COUNT(DISTINCT c."ContId") = 1 THEN MIN(c."ContId"::text)::uuid END
487:                     FROM postari c WHERE c."TranzactieId" = p."TranzactieId" AND c."Sens" <> p."Sens") AS "ContrapartidaId",
488:                 (SELECT string_agg(DISTINCT c."ContSimbol", ', ' ORDER BY c."ContSimbol")
489:                     FROM postari c WHERE c."TranzactieId" = p."TranzactieId" AND c."Sens" <> p."Sens") AS "ContrapartidaSimbol",
490:                 p."RepartitorDenumire", p."DocumentId", NULL::text AS "DocumentTip", p."NumarNota" AS "DocumentNumar", p."Storno"
491:             FROM postari p WHERE p."ContId" = {P(contId)} AND p."Data" >= {P(dataStart)}{Filtre("p")}
492:             """;
493:         return ((EFCoreObjectSpace)os).DbContext.Database
494:             .SqlQuery<FisaContSql>(FormattableStringFactory.Create(sql, argumente.ToArray()))
