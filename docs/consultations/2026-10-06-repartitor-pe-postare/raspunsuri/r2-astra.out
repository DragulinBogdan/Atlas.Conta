84: public static class TvaProiectii {
85: 
86:     public static IQueryable<FaptFiscal> IntreLuni(
87:         IQueryable<FaptFiscal> randuri, DateOnly? dataStart, DateOnly? dataEnd) =>
88:         Fiscale.IntreLuni(randuri, dataStart, dataEnd);
89: 
90:     public static IQueryable<JurnalTvaRand> JurnalTva(
91:         IObjectSpace os, SensTva sens, DateOnly? dataStart = null, DateOnly? dataEnd = null) {
92: 
93:         var randuri = IntreLuni(
94:             Fiscale.Fapte(os).Where(r => r.Sens == sens), dataStart, dataEnd);
95: 
96:         var agregate = randuri
97:             .GroupBy(r => new {
98:                 r.DocumentId, r.TipTvaId, r.PartenerId, r.Regim, r.Cota, r.DeImport, r.Storno,
99:                 r.PerioadaAn, r.PerioadaLuna, r.PerioadaD394, r.DocumentFiscalId,
100:                 r.DataDocument, r.DataPrimire, r.DataExigibilitate, r.DataInregistrare,
101:                 r.InversaTehnica, r.RegularizareD300
102:             })
103:             .Select(g => new {
104:                 g.Key.DocumentId,
105:                 g.Key.TipTvaId,
106:                 g.Key.PartenerId,
107:                 g.Key.Regim,
108:                 g.Key.Cota,
109:                 g.Key.Storno,
110:                 g.Key.PerioadaAn,
111:                 g.Key.PerioadaLuna, g.Key.DeImport, g.Key.PerioadaD394, g.Key.DocumentFiscalId,
112:                 g.Key.DataDocument, g.Key.DataPrimire, g.Key.DataExigibilitate, g.Key.DataInregistrare,
113:                 g.Key.InversaTehnica, g.Key.RegularizareD300,
114:                 Data = g.Min(r => r.Data),
115:                 Baza = g.Sum(r => r.Baza),
116:                 Tva = g.Sum(r => r.Tva)
117:             });
118: 
119: 
120:         return from a in agregate
121:                join d in os.GetObjectsQuery<Document>() on a.DocumentId equals d.ID into grupDoc
122:                from d in grupDoc.DefaultIfEmpty()
123:                join p in os.GetObjectsQuery<Repartitor>()
124:                    on a.PartenerId equals (Guid?)p.ID into grupPartener
125:                from p in grupPartener.DefaultIfEmpty()
126:                join t in os.GetObjectsQuery<TipTva>() on a.TipTvaId equals t.ID into grupTip
127:                from t in grupTip.DefaultIfEmpty()
128:                select new JurnalTvaRand {
129:                    DocumentId = a.DocumentId,
130:                    DocumentNumar = d == null ? null : d.Numar,
131:                    DocumentTip = null,
132:                    Data = a.Data,
133:                    DocumentFiscalId = a.DocumentFiscalId,
134:                    DataDocument = a.DataDocument, DataPrimire = a.DataPrimire,
135:                    DataExigibilitate = a.DataExigibilitate, DataInregistrare = a.DataInregistrare,
136:                    PerioadaD394 = a.PerioadaD394, InversaTehnica = a.InversaTehnica,
137:                    RegularizareD300 = a.RegularizareD300,
138:                    PerioadaAn = a.PerioadaAn,
139:                    PerioadaLuna = a.PerioadaLuna,
140:                    PartenerId = a.PartenerId,
141:                    PartenerDenumire = p == null ? null : p.Denumire,
142:                    PartenerCodFiscal = p == null ? null : (p as Partener).CodFiscal,
143:                    TipTvaId = a.TipTvaId,
144:                    TipTvaCod = t == null ? null : t.Cod,
145:                    TipTvaDenumire = t == null ? null : t.Denumire,
146:                    Regim = a.Regim == RegimTva.Normal ? "Normal"
147:                        : a.Regim == RegimTva.Capitalizat ? "Capitalizat"
148:                        : a.Regim == RegimTva.TaxareInversa ? "TaxareInversa"
149:                        : a.Regim == RegimTva.Scutit ? "Scutit"
150:                        : "Neimpozabil",
151:                    Cota = a.Cota,
152:                    CodSafT = os.GetObjectsQuery<MapareTvaSaft>().Where(m => m.Versiune == MapariFiscale.Versiune
153:                        && m.Sectiune == SectiuneTvaSaft.Facturi && m.TipTvaId == a.TipTvaId
154:                        && m.Regim == a.Regim && m.Cota == a.Cota && m.DeImport == a.DeImport
155:                        && m.Sens == sens && m.Rol == N.RolTva.Taxa).Select(m => m.TaxCode).FirstOrDefault(),
156:                    Baza = a.Baza,
157:                    Tva = a.Tva,
158:                    Storno = a.Storno
159:                };
160:     }
