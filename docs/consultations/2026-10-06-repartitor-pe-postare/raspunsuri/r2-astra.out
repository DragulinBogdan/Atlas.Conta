nou/Atlas.Conta.Nucleu/Atlas.Conta.Nucleu/Cub/Postare.cs
1: namespace Atlas.Conta.Nucleu;
2: 
3: public sealed record Postare(
4:     Coordonate Coordonate,
5:     decimal Cantitate,
6:     decimal ValoareValuta,
7:     decimal Valoare,
8:     Cauza Cauza,
9:     Guid? Atribuit = null) {
10: 
11:     public ReferintaPostare? Suport { get; init; }
12:     public ReferintaPostare? InversaDin { get; init; }
13: 
14:     // `with` ocolește constructorul; scara se apără și în `init` (N-D2).
15:     readonly decimal cantitate = LaScara(Cantitate, Scara.Cantitate, nameof(Cantitate));
16:     readonly decimal valoareValuta = LaScara(ValoareValuta, Scara.Bani, nameof(ValoareValuta));
17:     readonly decimal valoare = LaScara(Valoare, Scara.Bani, nameof(Valoare));
18: 
19:     public decimal Cantitate {
20:         get => cantitate;
21:         init => cantitate = LaScara(value, Scara.Cantitate, nameof(Cantitate));
22:     }
23: 
24:     public decimal ValoareValuta {
25:         get => valoareValuta;
26:         init => valoareValuta = LaScara(value, Scara.Bani, nameof(ValoareValuta));
27:     }
28: 
29:     public decimal Valoare {
30:         get => valoare;
31:         init => valoare = LaScara(value, Scara.Bani, nameof(Valoare));
32:     }
33: 
34:     static decimal LaScara(decimal valoare, int scara, string nume) =>
35:         Scara.EsteLa(valoare, scara)
36:             ? valoare
37:             : throw new ArgumentException($"{nume} = {valoare} are mai multe zecimale decât scara {scara}.", nume);
38: }
nou/Atlas.Conta.Nucleu/Atlas.Conta.Nucleu/Cub/GestiuniVirtuale.cs
1: using System.Security.Cryptography;
2: using System.Text;
3: 
4: namespace Atlas.Conta.Nucleu;
5: 
6: /// <summary>
7: /// Gestiunile STRUCTURALE ale capetelor din afara evidenței (090g): id-uri
8: /// deterministe, fără rând de nomenclator.
9: /// </summary>
10: public static class GestiuniVirtuale {
11:     public static Guid Furnizor { get; } = Identitate("Atlas.Conta.GestiuneVirtuala:Furnizor");
12: 
13:     public static Guid Client { get; } = Identitate("Atlas.Conta.GestiuneVirtuala:Client");
14: 
15:     public static Guid Consum { get; } = Identitate("Atlas.Conta.GestiuneVirtuala:Consum");
16: 
17:     public static Guid Transformare { get; } = Identitate("Atlas.Conta.GestiuneVirtuala:Transformare");
18: 
19:     public static Guid Inventar { get; } = Identitate("Atlas.Conta.GestiuneVirtuala:Inventar");
20: 
21:     public static bool Este(Guid? gestiune) =>
22:         gestiune == Furnizor || gestiune == Client || gestiune == Consum || gestiune == Transformare || gestiune == Inventar;
23: 
24:     // Aceeași amprentă ca `Unitate.DeschidePartida` (N-D6): SHA-256, primii 16
25:     // octeți, nibble-ul de versiune (octetul 7) pus pe 8.
26:     static Guid Identitate(string nume) {
27:         var amprenta = SHA256.HashData(Encoding.UTF8.GetBytes(nume));
28:         var id = amprenta[..16];
29:         id[7] = (byte)((id[7] & 0x0F) | 0x80);
30:         return new Guid(id);
31:     }
32: }
nou/Atlas.Conta.Nucleu/Atlas.Conta.Nucleu/Conservare.cs
1: namespace Atlas.Conta.Nucleu;
2: 
3: public static class Conservare {
4:     public static IReadOnlyList<Refuz> Verifica(Tranzactie tranzactie) {
5:         ArgumentNullException.ThrowIfNull(tranzactie);
6:         var refuzuri = new List<Refuz>();
7:         if (tranzactie.Postari.Count == 0)
8:             refuzuri.Add(new Refuz(
9:                 Coduri.PostariLipsa,
10:                 $"tranzacția de fel {tranzactie.Fel} nu are nicio postare",
11:                 null));
12:         VerificaDocumentul(tranzactie, refuzuri);
13:         // C6 (N-D3)
14:         if (tranzactie.Fel != FelTranzactie.Deschidere) {
15:             VerificaValoarea(tranzactie, refuzuri);
16:             VerificaCantitatea(tranzactie, refuzuri);
17:         }
18:         if (tranzactie.Fel == FelTranzactie.Transfer)
19:             VerificaTransferul(tranzactie, refuzuri);
20:         VerificaSemnul(tranzactie, refuzuri);
21:         VerificaFormele(tranzactie, refuzuri);
22:         VerificaTransformarile(tranzactie, refuzuri);
23:         return refuzuri;
24:     }
25: 
26:     static void VerificaTransformarile(Tranzactie tranzactie, List<Refuz> refuzuri) {
27:         var cauze = tranzactie.Postari.Where(p => p.Coordonate.Gestiune == GestiuniVirtuale.Transformare)
28:             .Select(p => p.Cauza).ToHashSet();
29:         foreach (var grup in tranzactie.Postari.Where(p => cauze.Contains(p.Cauza))
30:                      .GroupBy(p => (p.Coordonate.Cont, p.Coordonate.Produs, p.Cauza))) {
31:             var reale = grup.Where(p => p.Coordonate.Gestiune != GestiuniVirtuale.Transformare).ToArray();
32:             var virtuale = grup.Where(p => p.Coordonate.Gestiune == GestiuniVirtuale.Transformare).ToArray();
33:             if (reale.Length == 0 || virtuale.Length == 0 || grup.Sum(p => p.Cantitate) != 0m
34:                     || reale.Any(p => p.Coordonate.Unitate is not { Fel: FelUnitate.Lot }
35:                         || p.Coordonate.Gestiune is null || GestiuniVirtuale.Este(p.Coordonate.Gestiune))
36:                     || virtuale.Any(p => p.Coordonate.Unitate != null || p.Valoare != 0m || p.ValoareValuta != 0m
37:                         || p.Coordonate.Carte != Carte.Contabil || p.Coordonate.Partener != null
38:                         || p.Coordonate.CodTva != null || p.Coordonate.PerioadaDeclarare != null || p.Coordonate.Valuta != null))
39:                 refuzuri.Add(new Refuz(Coduri.ContrapondereTransformareInvalida,
40:                     "Transformarea cere contrapondere cantitativă fără valoare pe același cont, produs și cauză.", grup.Key.Cauza.Linie));
41:         }
42:     }
43: 
44:     static void VerificaDocumentul(Tranzactie tranzactie, List<Refuz> refuzuri) {
45:         if (tranzactie.Fel == FelTranzactie.Deschidere) {
46:             if (tranzactie.Document is not null)
47:                 refuzuri.Add(new Refuz(
48:                     Coduri.DocumentNeasteptat,
49:                     $"deschiderea nu are document, dar tranzacția poartă {tranzactie.Document}",
50:                     null));
51:             return;
52:         }
53:         if (tranzactie.Document is not { } document) {
54:             refuzuri.Add(new Refuz(
55:                 Coduri.DocumentLipsa,
56:                 $"tranzacția de fel {tranzactie.Fel} nu are document",
57:                 null));
58:             return;
59:         }
60:         // 090i: stornoul inversează și postările ATRIBUITE, care poartă cauza altui document.
61:         var atribuitulEPermis = tranzactie.Fel == FelTranzactie.Storno;
62:         foreach (var postare in tranzactie.Postari)
63:             if (postare.Cauza.Document != document && !(atribuitulEPermis && postare.Atribuit is not null))
64:                 refuzuri.Add(new Refuz(
65:                     Coduri.CauzaStraina,
66:                     $"postarea are cauza pe documentul {postare.Cauza.Document}, nu pe {document}",
67:                     postare.Cauza.Linie));
68:     }
69: 
70:     // 090k: cartea fiscală se balansează între postările ei, nu contra celei contabile.
71:     static void VerificaValoarea(Tranzactie tranzactie, List<Refuz> refuzuri) {
72:         foreach (var (carte, suma) in Aduna(
73:                      tranzactie.Postari,
74:                      p => p.Coordonate.Carte,
75:                      p => p.Coordonate.Latura == Latura.Debit ? p.Valoare : -p.Valoare))
76:             if (suma != 0m)
77:                 refuzuri.Add(new Refuz(
78:                     Coduri.ConservareValoare,
79:                     $"Σ debit − Σ credit pe cartea {carte} = {suma}, nu 0",
80:                     null));
81:     }
82: 
83:     static void VerificaCantitatea(Tranzactie tranzactie, List<Refuz> refuzuri) {
84:         // N-D4
85:         foreach (var (produs, suma) in Aduna(
86:                      tranzactie.Postari.Where(p => p.Cantitate != 0m),
87:                      p => p.Coordonate.Produs,
88:                      p => p.Cantitate))
89:             if (suma != 0m)
90:                 refuzuri.Add(new Refuz(
91:                     Coduri.ConservareCantitate,
92:                     $"Σ cantitate pe produsul {Nume(produs)} = {suma}, nu 0",
93:                     null));
94:     }
95: 
96:     static void VerificaTransferul(Tranzactie tranzactie, List<Refuz> refuzuri) {
97:         foreach (var (cheie, suma) in Aduna(
98:                      tranzactie.Postari,
99:                      p => (Cont: p.Coordonate.Cont, Latura: p.Coordonate.Latura),
100:                      p => p.Valoare))
101:             if (suma != 0m)
102:                 refuzuri.Add(new Refuz(
103:                     Coduri.ConservareTransfer,
104:                     $"Σ valoare pe (contul {cheie.Cont}, {cheie.Latura}) = {suma}, nu 0",
105:                     null));
106:         foreach (var (cheie, suma) in Aduna(
107:                      tranzactie.Postari.Where(p => p.Cantitate != 0m),
108:                      p => (Cont: p.Coordonate.Cont, Produs: p.Coordonate.Produs),
109:                      p => p.Cantitate))
110:             if (suma != 0m)
111:                 refuzuri.Add(new Refuz(
112:                     Coduri.ConservareTransfer,
113:                     $"Σ cantitate pe (contul {cheie.Cont}, produsul {Nume(cheie.Produs)}) = {suma}, nu 0",
114:                     null));
115:     }
116: 
117:     // S-D14: în `Operare` valoarea negativă e linia culeasă „în roșu" (retur/discount
118:     // pe același document), pe care conservarea, cantitatea și `Sold` o poartă aditiv.
119:     static void VerificaSemnul(Tranzactie tranzactie, List<Refuz> refuzuri) {
120:         if (tranzactie.Fel != FelTranzactie.Deschidere)
121:             return;
122:         foreach (var postare in tranzactie.Postari)
123:             if (postare.Valoare < 0m)
124:                 refuzuri.Add(new Refuz(
125:                     Coduri.SemnNegativ,
126:                     $"valoarea {postare.Valoare} e negativă într-o tranzacție de fel {tranzactie.Fel}",
127:                     postare.Cauza.Linie));
128:     }
129: 
130:     static void VerificaFormele(Tranzactie tranzactie, List<Refuz> refuzuri) {
131:         foreach (var postare in tranzactie.Postari) {
132:             var coordonate = postare.Coordonate;
133:             var linie = postare.Cauza.Linie;
134:             if (coordonate.Data != tranzactie.Data)
135:                 refuzuri.Add(new Refuz(
136:                     Coduri.DataStraina,
137:                     $"postarea e datată {coordonate.Data}, tranzacția {tranzactie.Data}",
138:                     linie));
139:             if (postare.Cantitate != 0m) {
140:                 if (coordonate.Gestiune is null)
141:                     refuzuri.Add(new Refuz(
142:                         Coduri.GestiuneLipsa,
143:                         $"cantitatea {postare.Cantitate} nu are gestiune",
144:                         linie));
145:                 if (coordonate.Produs is null)
146:                     refuzuri.Add(new Refuz(
147:                         Coduri.ProdusLipsa,
148:                         $"cantitatea {postare.Cantitate} nu are produs",
149:                         linie));
150:                 // N-D4: capătul virtual poartă cantitatea în afara evidenței, unde
151:                 // nu există unitate de nominalizat.
152:                 if (coordonate.Unitate is null && !GestiuniVirtuale.Este(coordonate.Gestiune))
153:                     refuzuri.Add(new Refuz(
154:                         Coduri.UnitateLipsa,
155:                         $"cantitatea {postare.Cantitate} nu are unitate",
156:                         linie));
157:             }
158:             if (coordonate.Unitate is not { } unitate)
159:                 continue;
160:             if (unitate.Cont != coordonate.Cont)
161:                 refuzuri.Add(new Refuz(
162:                     Coduri.UnitateNepotrivita,
163:                     $"unitatea e a contului {unitate.Cont}, postarea e pe {coordonate.Cont}",
164:                     linie));
165:             switch (unitate.Fel) {
166:                 case FelUnitate.Lot:
167:                     if (coordonate.Produs is null)
168:                         refuzuri.Add(new Refuz(Coduri.ProdusLipsa, "lotul nu are produs", linie));
169:                     if (coordonate.Gestiune is null)
170:                         refuzuri.Add(new Refuz(Coduri.GestiuneLipsa, "lotul nu are gestiune", linie));
171:                     if (coordonate.Produs != unitate.Produs)
172:                         refuzuri.Add(new Refuz(
173:                             Coduri.UnitateNepotrivita,
174:                             $"lotul {unitate.Id} e pe produsul {Nume(unitate.Produs)}, postarea pe {Nume(coordonate.Produs)}",
175:                             linie));
176:                     break;
177:                 case FelUnitate.Partida:
178:                     if (coordonate.Partener is null)
179:                         refuzuri.Add(new Refuz(Coduri.PartenerLipsa, "partida nu are partener", linie));
180:                     if (coordonate.Partener != unitate.Partener)
181:                         refuzuri.Add(new Refuz(
182:                             Coduri.UnitateNepotrivita,
183:                             $"partida {unitate.Id} e pe partenerul {Nume(unitate.Partener)}, postarea pe {Nume(coordonate.Partener)}",
184:                             linie));
185:                     break;
186:             }
187:         }
188:     }
189: 
190:     // `Dictionary<Guid?,_>` cade pe CS8714 sub TreatWarningsAsErrors.
191:     static List<(TCheie Cheie, decimal Suma)> Aduna<TCheie>(
192:         IEnumerable<Postare> postari,
193:         Func<Postare, TCheie> cheie,
194:         Func<Postare, decimal> masura) {
195:         var chei = new List<TCheie>();
196:         var sume = new List<decimal>();
197:         foreach (var postare in postari) {
198:             var k = cheie(postare);
199:             var i = chei.IndexOf(k);
200:             if (i < 0) {
201:                 chei.Add(k);
202:                 sume.Add(0m);
203:                 i = chei.Count - 1;
204:             }
205:             sume[i] += masura(postare);
206:         }
207:         return chei.Select((k, i) => (k, sume[i])).ToList();
208:     }
209: 
210:     static string Nume(Guid? id) => id?.ToString() ?? "(fără)";
211: }

codex
Voi separa regulile contabile de convențiile implementării actuale. Fișa indică deja că `Partener` servește atât soldului, cât și faptului fiscal; verific în declaranți și cititori când aceste roluri coincid și când trebuie păstrate separat.

